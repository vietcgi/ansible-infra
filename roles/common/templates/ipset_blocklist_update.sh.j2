#!/bin/bash
# IP Blocklist Update Script
# Fetches known attacker IPs and blocks them at network level
# Generated by Ansible - DO NOT EDIT MANUALLY

set -u

# Configuration
BLOCKLIST_NAME="blocklist"
MAX_ENTRIES="{{ blocklist_max_entries | default(65536) }}"
WHITELIST_FILE="/etc/ipset-blocklist/whitelist.txt"
LOCK_FILE="/var/run/ipset-blocklist.lock"
STATE_DIR="/var/lib/ipset-blocklist"
LOG_TAG="ipset-blocklist"

# Rate limiting - minimum seconds between updates
MIN_UPDATE_INTERVAL={{ blocklist_min_update_interval | default(3600) }}

# Create state directory
mkdir -p "$STATE_DIR" 2>/dev/null || true

# Prevent concurrent runs
if [[ -f "$LOCK_FILE" ]]; then
    LOCK_PID=$(cat "$LOCK_FILE" 2>/dev/null)
    if kill -0 "$LOCK_PID" 2>/dev/null; then
        logger -t "$LOG_TAG" "Another instance is running (PID $LOCK_PID), exiting"
        exit 0
    fi
fi
echo $$ > "$LOCK_FILE"
trap "rm -f $LOCK_FILE" EXIT

# Rate limiting check
LAST_RUN_FILE="$STATE_DIR/last_run"
if [[ -f "$LAST_RUN_FILE" ]]; then
    LAST_RUN=$(cat "$LAST_RUN_FILE")
    NOW=$(date +%s)
    ELAPSED=$((NOW - LAST_RUN))
    if [[ $ELAPSED -lt $MIN_UPDATE_INTERVAL ]]; then
        logger -t "$LOG_TAG" "Rate limited: last run was ${ELAPSED}s ago (min: ${MIN_UPDATE_INTERVAL}s)"
        exit 0
    fi
fi

TMP_FILE=$(mktemp)
trap "rm -f $TMP_FILE $LOCK_FILE" EXIT

# Build whitelist pattern from Ansible vars + local file
WHITELIST_PATTERN='127\.0\.0\.1|10\.[0-9]+\.[0-9]+\.[0-9]+|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]+\.[0-9]+|192\.168\.[0-9]+\.[0-9]+'
{% if blocklist_whitelist_ips is defined and blocklist_whitelist_ips %}
{% for ip in blocklist_whitelist_ips %}
WHITELIST_PATTERN="${WHITELIST_PATTERN}|{{ ip | regex_replace('\\.', '\\.') | regex_replace('/', '\\/') }}"
{% endfor %}
{% endif %}

# Add IPs from local whitelist file
if [[ -f "$WHITELIST_FILE" ]]; then
    while read -r ip; do
        [[ -n "$ip" && ! "$ip" =~ ^# ]] && WHITELIST_PATTERN="${WHITELIST_PATTERN}|$(echo "$ip" | sed 's/\./\\./g; s/\//\\\//g')"
    done < "$WHITELIST_FILE"
fi

# Create ipset if it doesn't exist
ipset create "$BLOCKLIST_NAME" hash:net maxelem "$MAX_ENTRIES" -exist 2>/dev/null || true

# Function to validate IP address format
validate_ip() {
    local ip="$1"
    # Match IPv4 or IPv4/CIDR
    [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(/[0-9]+)?$ ]]
}

# Function to fetch with verification
fetch_feed() {
    local url="$1"
    local name="$2"
    local output
    local http_code

    output=$(curl -sf --max-time 60 -w "%{http_code}" "$url" 2>/dev/null)
    http_code="${output: -3}"
    content="${output:0:-3}"

    if [[ "$http_code" == "200" ]]; then
        echo "$content"
        logger -t "$LOG_TAG" "Successfully fetched $name"
        return 0
    else
        logger -t "$LOG_TAG" "WARNING: Failed to fetch $name (HTTP $http_code)"
        return 1
    fi
}

FETCH_SUCCESS=0
FETCH_FAILED=0

{% if blocklist_enable_ipsum | default(true) %}
# Fetch from ipsum (known attackers with 3+ reports)
echo "Fetching ipsum threat feed..."
if ipsum_data=$(fetch_feed "https://raw.githubusercontent.com/stamparm/ipsum/master/levels/3.txt" "ipsum"); then
    echo "$ipsum_data" | grep -oE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | \
        head -{{ blocklist_ipsum_limit | default(2000) }} >> "$TMP_FILE"
    FETCH_SUCCESS=$((FETCH_SUCCESS + 1))
else
    FETCH_FAILED=$((FETCH_FAILED + 1))
fi
{% endif %}

{% if blocklist_enable_spamhaus | default(true) %}
# Fetch Spamhaus DROP list (highly reliable)
echo "Fetching Spamhaus DROP list..."
if drop_data=$(fetch_feed "https://www.spamhaus.org/drop/drop.txt" "Spamhaus DROP"); then
    echo "$drop_data" | grep -v '^;' | awk '{print $1}' >> "$TMP_FILE"
    FETCH_SUCCESS=$((FETCH_SUCCESS + 1))
else
    FETCH_FAILED=$((FETCH_FAILED + 1))
fi

# Fetch Spamhaus EDROP list
echo "Fetching Spamhaus EDROP list..."
if edrop_data=$(fetch_feed "https://www.spamhaus.org/drop/edrop.txt" "Spamhaus EDROP"); then
    echo "$edrop_data" | grep -v '^;' | awk '{print $1}' >> "$TMP_FILE"
    FETCH_SUCCESS=$((FETCH_SUCCESS + 1))
else
    FETCH_FAILED=$((FETCH_FAILED + 1))
fi
{% endif %}

{% if blocklist_enable_fail2ban_sync | default(true) %}
# Sync with fail2ban banned IPs (safer than parsing auth.log directly)
# Fail2ban has already verified these are actual attackers
echo "Syncing with fail2ban banned IPs..."
if command -v fail2ban-client >/dev/null 2>&1; then
    f2b_count=0
    for jail in $(fail2ban-client status 2>/dev/null | grep "Jail list" | sed 's/.*://;s/,//g'); do
        ips=$(fail2ban-client status "$jail" 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+')
        if [[ -n "$ips" ]]; then
            echo "$ips" >> "$TMP_FILE"
            f2b_count=$((f2b_count + $(echo "$ips" | wc -l)))
        fi
    done
    logger -t "$LOG_TAG" "Added $f2b_count IPs from fail2ban"
fi
{% endif %}

# Abort if all fetches failed (don't clear existing blocklist)
if [[ $FETCH_SUCCESS -eq 0 && $FETCH_FAILED -gt 0 ]]; then
    logger -t "$LOG_TAG" "ERROR: All feed fetches failed, keeping existing blocklist"
    exit 1
fi

# Sort, deduplicate, validate, and filter out whitelisted IPs
echo "Processing blocklist..."
ADDED=0
SKIPPED=0

sort -u "$TMP_FILE" | while read -r ip; do
    # Skip empty lines
    [[ -z "$ip" ]] && continue

    # Validate IP format
    if ! validate_ip "$ip"; then
        SKIPPED=$((SKIPPED + 1))
        continue
    fi

    # Skip whitelisted IPs
    if echo "$ip" | grep -qE "^($WHITELIST_PATTERN)"; then
        SKIPPED=$((SKIPPED + 1))
        continue
    fi

    # Add to ipset
    if ipset add "$BLOCKLIST_NAME" "$ip" -exist 2>/dev/null; then
        ADDED=$((ADDED + 1))
    fi
done

# Update last run timestamp
date +%s > "$LAST_RUN_FILE"

# Log result
ENTRY_COUNT=$(ipset list "$BLOCKLIST_NAME" 2>/dev/null | grep -cE '^[0-9]' || echo 0)
logger -t "$LOG_TAG" "Blocklist updated: $ENTRY_COUNT total IPs (feeds: $FETCH_SUCCESS ok, $FETCH_FAILED failed)"
echo "Blocklist updated: $ENTRY_COUNT IPs"
