apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://127.0.0.1:{{ monitoring_prometheus_port | default(9090) }}
    isDefault: true
    editable: true
    jsonData:
      timeInterval: "{{ monitoring_prometheus_scrape_interval }}"
      graphiteVersion: "1.1"
      tlsAuthWithCACert: false
    secureJsonData: {}

