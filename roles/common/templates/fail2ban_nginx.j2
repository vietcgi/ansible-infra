# fail2ban Nginx jail configuration
# Protects web server from HTTP brute force and scanning attacks
# Generated by Ansible - DO NOT EDIT MANUALLY

[nginx-http-auth]
enabled = {{ fail2ban_enable_nginx | default(false) | lower }}
port = http,https
filter = nginx-http-auth
logpath = %(nginx_error_log)s

# Nginx HTTP auth-specific settings
maxretry = {{ fail2ban_maxretry_nginx | default(fail2ban_maxretry | default(5)) }}
findtime = {{ fail2ban_findtime_nginx | default(fail2ban_findtime | default(600)) }}
bantime = {{ fail2ban_bantime_nginx | default(fail2ban_bantime | default(3600)) }}

# Action to take on ban
{% if fail2ban_enable_email_notifications | default(true) %}
action = %(action_mwl)s
{% else %}
action = %(action_)s
{% endif %}

# Log file location (varies by OS)
logpath = /var/log/nginx/error.log
          /var/log/nginx/access.log

# Backend detection (pure or systemd)
backend = {{ fail2ban_nginx_backend | default('auto') }}

# Ban configuration
destemail = {{ fail2ban_destemail | default('root') }}
sendername = {{ fail2ban_sendername | default('Fail2Ban') }}

# Timeout for connections
timeout = {{ fail2ban_nginx_timeout | default(600) }}

# Chain for iptables rules
chain = INPUT

---

# Additional jail for Nginx limit request module
[nginx-limit-req]
enabled = {{ fail2ban_enable_nginx_limit | default(false) | lower }}
port = http,https
filter = nginx-limit-req
logpath = %(nginx_error_log)s
maxretry = {{ fail2ban_maxretry_nginx_limit | default(3) }}
findtime = {{ fail2ban_findtime_nginx_limit | default(60) }}
bantime = {{ fail2ban_bantime_nginx_limit | default(600) }}
backend = {{ fail2ban_nginx_limit_backend | default('auto') }}

{% if fail2ban_enable_email_notifications | default(true) %}
action = %(action_mwl)s
{% else %}
action = %(action_)s
{% endif %}

---

# Jail for Nginx noscript (prevents bots)
[nginx-noscript]
enabled = {{ fail2ban_enable_nginx_noscript | default(false) | lower }}
port = http,https
filter = nginx-noscript
logpath = %(nginx_access_log)s
maxretry = {{ fail2ban_maxretry_nginx_noscript | default(6) }}
findtime = {{ fail2ban_findtime_nginx_noscript | default(600) }}
bantime = {{ fail2ban_bantime_nginx_noscript | default(3600) }}
backend = {{ fail2ban_nginx_noscript_backend | default('auto') }}

{% if fail2ban_enable_email_notifications | default(true) %}
action = %(action_mwl)s
{% else %}
action = %(action_)s
{% endif %}

---

# Jail for Nginx bad request
[nginx-badbots]
enabled = {{ fail2ban_enable_nginx_badbots | default(false) | lower }}
port = http,https
filter = nginx-badbots
logpath = %(nginx_access_log)s
maxretry = {{ fail2ban_maxretry_nginx_badbots | default(2) }}
findtime = {{ fail2ban_findtime_nginx_badbots | default(600) }}
bantime = {{ fail2ban_bantime_nginx_badbots | default(86400) }}
backend = {{ fail2ban_nginx_badbots_backend | default('auto') }}

{% if fail2ban_enable_email_notifications | default(true) %}
action = %(action_mwl)s
{% else %}
action = %(action_)s
{% endif %}
