#!/bin/bash
# Restic Backup Script
# Generated by Ansible - DO NOT EDIT MANUALLY
# Runs Restic backup and applies retention policies

set -e

# Source Restic environment configuration
if [ -f /etc/restic/.env ]; then
    source /etc/restic/.env
fi

# Logging
LOG_FILE="/var/log/backup/restic-backup.log"
TIMESTAMP=$(date +'%Y-%m-%d %H:%M:%S')

# Ensure log directory exists
mkdir -p "$(dirname "$LOG_FILE")"

# Function to log messages
log_message() {
    echo "[$TIMESTAMP] $1" | tee -a "$LOG_FILE"
}

log_message "Starting Restic backup..."

# Verify repository exists
if [ ! -f "$RESTIC_REPOSITORY/config" ]; then
    log_message "ERROR: Restic repository not found at $RESTIC_REPOSITORY"
    exit 1
fi

# Create a backup
backup_failed=0
log_message "Backing up system files..."

{% if backup_restic_backup_paths is defined %}
# Back up specific paths
{% for path in backup_restic_backup_paths %}
if [ -d "{{ path }}" ]; then
    log_message "Backing up {{ path }}..."
    restic backup "{{ path }}" {{ backup_restic_backup_args | default('--stats') }} >> "$LOG_FILE" 2>&1 || backup_failed=$?
else
    log_message "WARNING: Path {{ path }} does not exist"
fi
{% endfor %}
{% else %}
# Back up default system paths
for path in /home /etc /root; do
    if [ -d "$path" ]; then
        log_message "Backing up $path..."
        restic backup "$path" {{ backup_restic_backup_args | default('--stats') }} >> "$LOG_FILE" 2>&1 || backup_failed=$?
    fi
done
{% endif %}

if [ $backup_failed -ne 0 ]; then
    log_message "ERROR: Backup failed with exit code $backup_failed"
fi

# Apply retention policy
log_message "Applying retention policy..."

{% if backup_retention_days %}
# Keep daily backups
KEEP_DAILY={{ backup_retention_days }}
{% endif %}

# Keep weekly backups
KEEP_WEEKLY={{ (backup_retention_days / 7) | int }}

# Keep monthly backups
KEEP_MONTHLY={{ (backup_retention_days / 30) | int }}

# Keep yearly backups
KEEP_YEARLY=1

# Forget old snapshots according to policy
log_message "Removing old snapshots..."
restic forget \
    --keep-daily "$KEEP_DAILY" \
    --keep-weekly "$KEEP_WEEKLY" \
    --keep-monthly "$KEEP_MONTHLY" \
    --keep-yearly "$KEEP_YEARLY" \
    --prune \
    >> "$LOG_FILE" 2>&1 || log_message "ERROR: Forget operation failed"

# Verify backup integrity
log_message "Verifying backup integrity..."
restic check >> "$LOG_FILE" 2>&1 || log_message "WARNING: Backup check found issues"

# Get latest snapshot info
log_message "Backup completed. Latest snapshot info:"
restic snapshots --latest 1 >> "$LOG_FILE" 2>&1

# Calculate backup statistics
BACKUP_SIZE=$(restic stats latest 2>/dev/null | awk '/Total File Size/ {print $4}' || echo "N/A")
SNAPSHOT_COUNT=$(restic snapshots --json 2>/dev/null | jq 'length' || echo "0")

log_message "Backup Statistics:"
log_message "  Total Snapshots: $SNAPSHOT_COUNT"
log_message "  Latest Snapshot Size: $BACKUP_SIZE"
log_message "  Backup Location: $RESTIC_REPOSITORY"

if [ $backup_failed -eq 0 ]; then
    log_message "Restic backup completed successfully"
    exit 0
else
    log_message "Restic backup completed with errors"
    exit 1
fi

