# Vault Auto-Unseal Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY
# Enables automatic unsealing via KMS provider

# Supported providers: aws-kms, azure-keyvault, gcp-kms, alicloud-kms

{% if vault_autounseal_provider == "aws-kms" %}
# AWS KMS Auto-Unseal Configuration
seal "awskms" {
  region     = "{{ vault_aws_region | default('us-east-1') }}"
  kms_key_id = "{{ vault_kms_key_id }}"

  # Optional: AWS credentials (if not using IAM role)
  {% if vault_aws_access_key is defined %}
  access_key = "{{ vault_aws_access_key }}"
  secret_key = "{{ vault_aws_secret_key }}"
  {% endif %}

  # Optional: Disable SSL verification
  {% if vault_skip_verify %}
  disable_req_signing = false
  {% endif %}
}

{% elif vault_autounseal_provider == "azure-keyvault" %}
# Azure Key Vault Auto-Unseal Configuration
seal "azurekeyvault" {
  tenant_id      = "{{ vault_azure_tenant_id }}"
  client_id      = "{{ vault_azure_client_id }}"
  client_secret  = "{{ vault_azure_client_secret }}"
  vault_name     = "{{ vault_azure_vault_name }}"
  key_name       = "{{ vault_azure_key_name }}"
  key_version    = "{{ vault_azure_key_version | default('') }}"

  # Environment: AzurePublicCloud, AzureUSGovernmentCloud, AzureChinaCloud, AzureGermanCloud
  environment = "{{ vault_azure_environment | default('AzurePublicCloud') }}"
}

{% elif vault_autounseal_provider == "gcp-kms" %}
# Google Cloud KMS Auto-Unseal Configuration
seal "gcpkms" {
  project    = "{{ vault_gcp_project }}"
  region     = "{{ vault_gcp_region | default('us') }}"
  key_ring   = "{{ vault_gcp_keyring }}"
  crypto_key = "{{ vault_gcp_crypto_key }}"

  # Optional: credentials file path
  {% if vault_gcp_credentials_file is defined %}
  credentials = "{{ vault_gcp_credentials_file }}"
  {% endif %}
}

{% elif vault_autounseal_provider == "alicloud-kms" %}
# Alibaba Cloud KMS Auto-Unseal Configuration
seal "alicloudkms" {
  region     = "{{ vault_alicloud_region }}"
  key_id     = "{{ vault_alicloud_key_id }}"

  # Alibaba Cloud credentials
  {% if vault_alicloud_access_key is defined %}
  access_key = "{{ vault_alicloud_access_key }}"
  secret_key = "{{ vault_alicloud_secret_key }}"
  {% endif %}
}

{% endif %}

# Backup seal configuration (optional, for disaster recovery)
{% if vault_backup_seal_enabled | default(false) %}
{% if vault_backup_seal_type == "shamir" %}
seal "shamir" {
  # Shamir key backup (development only)
  key_shares     = {{ vault_shamir_key_shares | default(5) }}
  key_threshold  = {{ vault_shamir_key_threshold | default(3) }}
}

{% elif vault_backup_seal_type == "transit" %}
seal "transit" {
  address            = "{{ vault_transit_address }}"
  disable_req_signing = false
  key_name           = "{{ vault_transit_key_name | default('autounseal') }}"

  tls_ca_cert  = "{{ vault_transit_ca_cert | default('/etc/vault/tls/ca.crt') }}"
  tls_client_cert = "{{ vault_transit_client_cert | default('/etc/vault/tls/client.crt') }}"
  tls_client_key  = "{{ vault_transit_client_key | default('/etc/vault/tls/client.key') }}"
}

{% endif %}
{% endif %}

# Entropy configuration (optional, for high-security environments)
{% if vault_entropy_augmentation_enabled | default(false) %}
entropy "seal" {
  key_shares = {{ vault_entropy_key_shares | default(5) }}
}

{% endif %}

# Telemetry (optional, for monitoring)
{% if vault_telemetry_enabled | default(false) %}
telemetry {
  prometheus_retention_time = "{{ vault_prometheus_retention | default('30s') }}"
  disable_hostname = false

  {% if vault_telemetry_dogstatsd_addr is defined %}
  dogstatsd_addr = "{{ vault_telemetry_dogstatsd_addr }}"
  dogstatsd_tags = [
    {% for tag in vault_telemetry_tags | default([]) %}
    "{{ tag }}",
    {% endfor %}
  ]
  {% endif %}
}

{% endif %}

# High Availability (optional)
{% if vault_ha_enabled | default(false) %}
ha_storage "{{ vault_ha_backend | default('consul') }}" {
  address = "{{ vault_ha_address }}"
  path    = "{{ vault_ha_path | default('vault') }}"

  {% if vault_ha_backend == "consul" %}
  # Consul-specific settings
  scheme = "{{ vault_ha_scheme | default('http') }}"
  service = "{{ vault_ha_service | default('vault') }}"
  check_timeout = "{{ vault_ha_check_timeout | default('5s') }}"
  wait_time = "{{ vault_ha_wait_time | default('15s') }}"
  {% endif %}
}

{% endif %}

# Logging
# Enable audit logging for auto-unseal operations
audit {
  file {
    path = "/var/log/vault/autounseal.log"
  }
}

