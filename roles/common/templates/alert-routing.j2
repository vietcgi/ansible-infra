# Alert Routing Rules
# Routes alerts to appropriate channels and responders based on severity and type

global:
  resolve_timeout: 5m
  slack_api_url: '{{ alerting_slack_webhook_url | default("") }}'
  pagerduty_token: '{{ alerting_pagerduty_token | default("") }}'

routes:
  - match:
      severity: critical
    receiver: critical_team
    group_by: ['alertname', 'instance']
    group_wait: 10s
    group_interval: 10s
    repeat_interval: 5m
    continue: true

  - match:
      severity: high
    receiver: ops_team
    group_by: ['alertname']
    group_wait: 30s
    group_interval: 5m
    repeat_interval: 15m

  - match:
      severity: medium
    receiver: ops_team
    group_by: ['alertname']
    group_wait: 1m
    group_interval: 30m
    repeat_interval: 1h

  - match:
      severity: low
    receiver: slack_notifications
    group_by: ['alertname']
    group_wait: 5m
    group_interval: 1h
    repeat_interval: 24h

  - match:
      severity: info
    receiver: 'null'

receivers:
  - name: critical_team
    slack_configs:
      - channel: '#alerts-critical'
        title: 'CRITICAL: {{ .GroupLabels.alertname }}'
        text: '{{ range .Alerts }}{{ .Annotations.description }}{{ end }}'
        send_resolved: true
        color: '{{ if eq .Status "firing" }}danger{{ else }}good{{ end }}'
    pagerduty_configs:
      - service_key: '{{ alerting_pagerduty_service_key | default("") }}'
        severity: 'critical'

  - name: ops_team
    slack_configs:
      - channel: '#alerts-ops'
        title: '{{ .GroupLabels.severity | upper }}: {{ .GroupLabels.alertname }}'
        send_resolved: true
    email_configs:
      - to: '{{ alerting_email_to | default("") }}'
        from: '{{ alerting_email_from | default("alerts@example.com") }}'
        smarthost: '{{ alerting_smtp_server | default("") }}'

  - name: slack_notifications
    slack_configs:
      - channel: '#alerts'
        send_resolved: true

  - name: 'null'
