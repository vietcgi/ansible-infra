# Prometheus Custom Scrape Configurations
# Auto-generated by Ansible - DO NOT EDIT MANUALLY
# Generated: {{ ansible_date_time.iso8601 }}

# Custom scrape job configurations
# Add organization-specific Prometheus scrape targets below

{% for job in monitoring_prometheus_custom_scrapes | default([]) %}
# Job: {{ job.name | default('unnamed-job') }}
- job_name: '{{ job.name | default('custom-job-' + loop.index | string) }}'
  {% if job.static_configs is defined %}
  static_configs:
    {% for config in job.static_configs %}
    - targets:
        {% for target in config.targets | default([]) %}
        - '{{ target }}'
        {% endfor %}
      {% if config.labels is defined %}
      labels:
        {% for label_key, label_value in config.labels.items() %}
        {{ label_key }}: '{{ label_value }}'
        {% endfor %}
      {% endif %}
    {% endfor %}
  {% endif %}
  {% if job.scrape_interval is defined %}
  scrape_interval: '{{ job.scrape_interval }}'
  {% endif %}
  {% if job.scrape_timeout is defined %}
  scrape_timeout: '{{ job.scrape_timeout }}'
  {% endif %}
  {% if job.metrics_path is defined %}
  metrics_path: '{{ job.metrics_path }}'
  {% endif %}
  {% if job.honor_labels is defined %}
  honor_labels: {{ job.honor_labels | lower }}
  {% endif %}
  {% if job.honor_timestamps is defined %}
  honor_timestamps: {{ job.honor_timestamps | lower }}
  {% endif %}
  {% if job.relabel_configs is defined %}
  relabel_configs:
    {% for relabel in job.relabel_configs %}
    - source_labels: {{ relabel.source_labels | default([]) }}
      target_label: '{{ relabel.target_label | default('') }}'
      {% if relabel.regex is defined %}
      regex: '{{ relabel.regex }}'
      {% endif %}
      {% if relabel.replacement is defined %}
      replacement: '{{ relabel.replacement }}'
      {% endif %}
    {% endfor %}
  {% endif %}

{% endfor %}

