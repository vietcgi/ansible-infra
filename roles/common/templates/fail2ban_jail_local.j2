# fail2ban jail configuration
# Main jail settings for fail2ban IPS
# Generated by Ansible - DO NOT EDIT MANUALLY

[DEFAULT]
# Ban time in seconds
bantime = {{ fail2ban_bantime | default(3600) }}

# Find time in seconds (time window for counting failures)
findtime = {{ fail2ban_findtime | default(600) }}

# Max retry attempts before banning
maxretry = {{ fail2ban_maxretry | default(5) }}

# Destination email for notifications
destemail = {{ fail2ban_destemail | default('root') }}

# Sender email address
sendername = {{ fail2ban_sendername | default('Fail2Ban') }}

# Email action configuration
{% if fail2ban_enable_email_notifications | default(true) %}
action = %(action_mwl)s
{% else %}
action = %(action_)s
{% endif %}

# Database backend for persistent state
dbfile = /var/lib/fail2ban/fail2ban.sqlite3
dbpurgeage = {{ fail2ban_dbpurgeage | default(86400) }}

# Enable logging
loglevel = {{ fail2ban_loglevel | default('INFO') }}

# Logging format
logformat = %(asctime)s %(name)-12[%(process)d]: %(levelname)-8 %(message)s

# Syslog logging
syslog-ident = fail2ban
syslog-facility = {{ fail2ban_syslog_facility | default('daemon') }}

# Ignore IPs (whitelist)
{% if fail2ban_ignoreips is defined and fail2ban_ignoreips %}
ignoreips = 127.0.0.1/8 ::1/128 {{ fail2ban_ignoreips | join(' ') }}
{% else %}
ignoreips = 127.0.0.1/8 ::1/128
{% endif %}

# Ignore self (recommended)
ignoreself = true

# Socket settings
socket = /var/run/fail2ban/fail2ban.sock
pidfile = /var/run/fail2ban/fail2ban.pid

# Use DNS name or IP for ban actions
usedns = {{ fail2ban_usedns | default('warn') }}
