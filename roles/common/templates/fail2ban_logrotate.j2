# fail2ban log rotation configuration
# Rotates fail2ban logs to prevent disk space issues
# Generated by Ansible - DO NOT EDIT MANUALLY

/var/log/fail2ban.log {
    # Rotation frequency
    {{ fail2ban_log_rotate_frequency | default('daily') }}

    # Keep 30 days of logs (compressed)
    rotate {{ fail2ban_log_rotate_count | default(30) }}

    # File compression settings
    compress
    delaycompress

    # Create new log file after rotation
    create 0644 root root

    # Missingok: don't error if log file is missing
    missingok

    # Notifempty: don't rotate empty files
    notifempty

    # Copy and truncate (for log files that keep changing)
    copytruncate

    # Size-based rotation (also rotate if file exceeds size)
    size {{ fail2ban_log_rotate_size | default('100M') }}

    # Post-rotation script: restart fail2ban service
    {% if fail2ban_log_rotate_postrotate | default(true) %}
    postrotate
        # Signal fail2ban to flush logs
        fail2ban-client flushlogs > /dev/null 2>&1 || true

        # Reload fail2ban if running
        systemctl is-active --quiet fail2ban && \
            systemctl reload fail2ban > /dev/null 2>&1 || true
    endscript
    {% endif %}

    # Pre-rotation script (optional)
    {% if fail2ban_log_rotate_prerotate | default(false) %}
    prerotate
        # Optional: do something before rotation
        logger -t fail2ban "Log rotation started"
    endscript
    {% endif %}

    # Shred log files for security (optional - slower but more secure)
    {% if fail2ban_log_rotate_shred | default(false) %}
    shred
    {% endif %}
}

---

# Additional fail2ban journal log rotation
/var/log/fail2ban/jail.log {
    {{ fail2ban_jail_log_rotate_frequency | default('weekly') }}
    rotate {{ fail2ban_jail_log_rotate_count | default(20) }}
    compress
    delaycompress
    create 0644 root root
    missingok
    notifempty
    copytruncate
    size {{ fail2ban_jail_log_rotate_size | default('50M') }}
}

---

# Audit log rotation for fail2ban
/var/log/fail2ban/audit.log {
    {{ fail2ban_audit_log_rotate_frequency | default('monthly') }}
    rotate {{ fail2ban_audit_log_rotate_count | default(12) }}
    compress
    delaycompress
    create 0644 root root
    missingok
    notifempty
    copytruncate
}

---

# Fail2ban database backup before rotation (optional)
{% if fail2ban_backup_db_before_rotation | default(false) %}
/var/lib/fail2ban/*.sqlite3 {
    {{ fail2ban_db_rotate_frequency | default('weekly') }}
    rotate {{ fail2ban_db_rotate_count | default(4) }}
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    prerotate
        # Backup database before rotation
        cp /var/lib/fail2ban/fail2ban.sqlite3 \
           /var/lib/fail2ban/fail2ban.sqlite3.$(date +\%Y\%m\%d)

        # Compress backup
        gzip /var/lib/fail2ban/fail2ban.sqlite3.* 2>/dev/null || true
    endscript
}
{% endif %}

---

# Configuration summary
# Log retention: {{ fail2ban_log_rotate_count | default(30) }} days
# Compression: enabled (saves {{ '{{' }} compression_ratio {{ '}}' }}% disk space)
# Size limit: {{ fail2ban_log_rotate_size | default('100M') }} per file
# Frequency: {{ fail2ban_log_rotate_frequency | default('daily') }}

# Manual log operations:
# View current logs:    tail -f /var/log/fail2ban.log
# View all logs:        zcat /var/log/fail2ban.log*
# Search for IP:        grep "203.0.113.1" /var/log/fail2ban.log*
# Check ban status:     fail2ban-client status sshd
