# Restic Backup Environment Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY
# Source this file before running restic commands

# Repository location and credentials
export RESTIC_REPOSITORY="{{ backup_restic_repo_path | default('/var/lib/restic') }}"
export RESTIC_PASSWORD="{{ backup_restic_password }}"

# Repository type (local, sftp, s3, azure, gs, b2, etc.)
{% if backup_restic_backend is defined %}
export RESTIC_BACKEND="{{ backup_restic_backend }}"
{% endif %}

# Backend-specific credentials
{% if backup_restic_backend == "s3" %}
export AWS_ACCESS_KEY_ID="{{ backup_restic_aws_access_key }}"
export AWS_SECRET_ACCESS_KEY="{{ backup_restic_aws_secret_key }}"
export AWS_DEFAULT_REGION="{{ backup_restic_aws_region | default('us-east-1') }}"
{% if backup_restic_s3_bucket is defined %}
export RESTIC_REPOSITORY="s3:{{ backup_restic_s3_bucket }}/{{ ansible_hostname }}"
{% endif %}

{% elif backup_restic_backend == "azure" %}
export AZURE_ACCOUNT_NAME="{{ backup_restic_azure_account }}"
export AZURE_ACCOUNT_KEY="{{ backup_restic_azure_key }}"
export RESTIC_REPOSITORY="azure:{{ backup_restic_azure_container }}/{{ ansible_hostname }}"

{% elif backup_restic_backend == "gs" %}
export GOOGLE_PROJECT_ID="{{ backup_restic_gcs_project }}"
export GOOGLE_APPLICATION_CREDENTIALS="{{ backup_restic_gcs_credentials }}"
export RESTIC_REPOSITORY="gs:{{ backup_restic_gcs_bucket }}/{{ ansible_hostname }}"

{% elif backup_restic_backend == "b2" %}
export B2_ACCOUNT_ID="{{ backup_restic_b2_account_id }}"
export B2_ACCOUNT_KEY="{{ backup_restic_b2_account_key }}"
export RESTIC_REPOSITORY="b2:{{ backup_restic_b2_bucket }}:{{ ansible_hostname }}"

{% elif backup_restic_backend == "sftp" %}
export RESTIC_REPOSITORY="sftp:{{ backup_restic_sftp_user }}@{{ backup_restic_sftp_host }}:{{ backup_restic_sftp_path }}"

{% endif %}

# Connection settings
export RESTIC_PROGRESS_FPS={{ backup_restic_progress_fps | default('1') }}

# Compression settings
export RESTIC_COMPRESSION={{ backup_restic_compression | default('auto') }}

# Memory settings
export RESTIC_CACHE_DIR="/var/cache/restic"

# Logging
export RESTIC_LOG_LEVEL="{{ backup_restic_log_level | default('info') }}"

# Security: limit CPU and memory usage
ulimit -v {{ backup_restic_memory_limit | default(2097152) }}
ulimit -t {{ backup_restic_cpu_limit | default(3600) }}

# Environment metadata for backup tagging
export BACKUP_HOST="{{ ansible_hostname }}"
export BACKUP_FQDN="{{ ansible_fqdn }}"
export BACKUP_OS="{{ ansible_os_family }}"
export BACKUP_DATE="$(date +'%Y-%m-%d')"

