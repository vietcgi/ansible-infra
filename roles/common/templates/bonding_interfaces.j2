# Network bonding configuration file (traditional /etc/network/interfaces)
# Generated by Ansible - manage via network_bonds variable

# The loopback network interface
auto lo
iface lo inet loopback

# Bond Master Configurations
{% for bond in network_bonds %}

auto {{ bond.name }}
iface {{ bond.name }} inet static
    bond-slaves {{ bond.interfaces | join(' ') }}
    bond-mode {{ bond.mode | default('active-backup') }}
    bond-miimon {{ bond.mii_monitor_interval | default(100) }}
{% if bond.primary_interface is defined %}
    bond-primary {{ bond.primary_interface }}
{% endif %}
{% if bond.mode == '802.3ad' %}
    bond-lacp-rate {{ bond.lacp_rate | default('slow') }}
{% endif %}
{% if bond.xmit_hash_policy is defined %}
    bond-xmit-hash-policy {{ bond.xmit_hash_policy }}
{% endif %}
{% if bond.up_delay is defined %}
    bond-updelay {{ bond.up_delay }}
{% endif %}
{% if bond.down_delay is defined %}
    bond-downdelay {{ bond.down_delay }}
{% endif %}
{% endfor %}

# Bond Slave Configurations
{% for bond in network_bonds %}
{% for iface in bond.interfaces %}

auto {{ iface }}
iface {{ iface }} inet manual
    bond-master {{ bond.name }}
    bond-slave yes
{% endfor %}
{% endfor %}

# Static IP Configuration (if needed)
{% for ip_config in network_static_ips %}

auto {{ ip_config.interface }}
iface {{ ip_config.interface }} inet static
    address {{ ip_config.address }}
    netmask {{ ip_config.netmask | default(24) if ip_config.netmask is not string else (2**(32-ip_config.netmask|int)|string) if ip_config.netmask|int else '255.255.255.0' }}
{% if ip_config.gateway is defined %}
    gateway {{ ip_config.gateway }}
{% endif %}
{% if ip_config.dns is defined %}
    dns-nameservers {{ ip_config.dns | join(' ') }}
{% endif %}
{% endfor %}
