# keepalived configuration
# Provides High Availability with virtual IP failover
# Generated by Ansible - manage via network_keepalived_* variables

global_defs {
    router_id {{ inventory_hostname }}
    script_user root root
    enable_script_security
}

# Primary VRRP instance for virtual IP failover
vrrp_instance VI_1 {
    state {{ 'MASTER' if network_keepalived_priority | default(100) | int > 50 else 'BACKUP' }}
    interface {{ network_vip_interface }}
    virtual_router_id {{ network_keepalived_vrid | default(51) }}
    priority {{ network_keepalived_priority | default(100) }}
    advert_int 1

    # Authentication (optional)
{% if network_keepalived_auth_pass is defined %}
    authentication {
        auth_type PASS
        auth_pass {{ network_keepalived_auth_pass }}
    }
{% endif %}

    # Virtual IP address to failover
    virtual_ipaddress {
        {{ network_vip }}/{{ network_vip_netmask | default(24) }}
    }

    # Track services for failover decision
{% if network_keepalived_track_services is defined %}
    track_interface {
        {% for interface in network_keepalived_track_services %}
        {{ interface }}
        {% endfor %}
    }
{% endif %}

    # Health check scripts
{% if network_keepalived_checks is defined %}
    track_script {
        {% for check in network_keepalived_checks %}
        check_{{ check.name }}
        {% endfor %}
    }
{% endif %}

    # Notification scripts
{% if network_keepalived_notify_master is defined %}
    notify_master "/usr/local/bin/keepalived_notify.sh MASTER"
{% endif %}

{% if network_keepalived_notify_backup is defined %}
    notify_backup "/usr/local/bin/keepalived_notify.sh BACKUP"
{% endif %}

{% if network_keepalived_notify_fault is defined %}
    notify_fault "/usr/local/bin/keepalived_notify.sh FAULT"
{% endif %}
}

# Health check scripts definition
{% if network_keepalived_checks is defined %}
{% for check in network_keepalived_checks %}
vrrp_script check_{{ check.name }} {
    script "/usr/local/bin/keepalived_{{ check.name }}_check.sh"
    interval {{ check.interval | default(2) }}
    timeout {{ check.timeout | default(3) }}
    fall {{ check.fall_count | default(3) }}
    rise {{ check.rise_count | default(2) }}
{% if check.weight is defined %}
    weight {{ check.weight }}
{% endif %}
}
{% endfor %}
{% endif %}

# Virtual server configuration (optional - for load balancing)
{% if network_keepalived_virtual_servers is defined %}
{% for vserver in network_keepalived_virtual_servers %}
virtual_server {{ vserver.vip }} {{ vserver.port }} {
    delay_loop {{ vserver.delay_loop | default(6) }}
    lb_algo {{ vserver.lb_algo | default('rr') }}
    lb_kind {{ vserver.lb_kind | default('NAT') }}
    protocol {{ vserver.protocol | default('TCP') }}

    # Real servers
    {% for rserver in vserver.real_servers %}
    real_server {{ rserver.ip }} {{ rserver.port }} {
        weight {{ rserver.weight | default(1) }}
        TCP_CHECK {
            connect_port {{ rserver.port }}
            connect_timeout 3
            retry 3
        }
    }
    {% endfor %}
}
{% endfor %}
{% endif %}
