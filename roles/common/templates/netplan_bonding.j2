# Netplan network bonding configuration
# Provides NIC aggregation and redundancy
# Generated by Ansible - manage via network_bonds variable

network:
  version: 2
  renderer: networkd

  bonds:
{% for bond in network_bonds %}
    {{ bond.name }}:
      interfaces:
      {% for iface in bond.interfaces %}
        - {{ iface }}
      {% endfor %}
      parameters:
        mode: {{ bond.mode | default('active-backup') }}
        mii-monitor-interval: {{ bond.mii_monitor_interval | default(100) }}
{% if bond.primary_interface is defined %}
        primary: {{ bond.primary_interface }}
{% endif %}
{% if bond.mode == '802.3ad' %}
        lacp-rate: {{ bond.lacp_rate | default('slow') }}
{% endif %}
{% if bond.xmit_hash_policy is defined %}
        transmit-hash-policy: {{ bond.xmit_hash_policy }}
{% endif %}
{% if bond.down_delay is defined %}
        down-delay: {{ bond.down_delay }}
{% endif %}
{% if bond.up_delay is defined %}
        up-delay: {{ bond.up_delay }}
{% endif %}

{% endfor %}

  ethernets:
{% for bond in network_bonds %}
{% for iface in bond.interfaces %}
    {{ iface }}:
      match:
        name: {{ iface }}
{% endfor %}
{% endfor %}

{% if network_static_ips is defined %}
  vlans:
{% for vlan in network_vlans | default([]) %}
    {{ vlan.name }}:
      id: {{ vlan.id }}
      link: {{ vlan.link }}
      addresses:
        - {{ vlan.address }}/{{ vlan.netmask | default(24) }}
{% endfor %}
{% endif %}
