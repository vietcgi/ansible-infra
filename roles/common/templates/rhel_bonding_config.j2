# RHEL/CentOS bonding interface configuration
# Generated by Ansible - manage via network_bonds variable
# Location: /etc/sysconfig/network-scripts/ifcfg-{{ item.name }}

TYPE=Bond
BONDING_MASTER=yes
BOOTPROTO=none
ONBOOT=yes
DEVICE={{ item.name }}
BONDING_OPTS="mode={{ item.mode | default('active-backup') }} miimon={{ item.mii_monitor_interval | default(100) }}{% if item.primary_interface is defined %} primary={{ item.primary_interface }}{% endif %}{% if item.mode == '802.3ad' %} lacp_rate={{ item.lacp_rate | default('slow') }}{% endif %}{% if item.xmit_hash_policy is defined %} xmit_hash_policy={{ item.xmit_hash_policy }}{% endif %}{% if item.up_delay is defined %} updelay={{ item.up_delay }}{% endif %}{% if item.down_delay is defined %} downdelay={{ item.down_delay }}{% endif %}"
NM_CONTROLLED=no
USERCTL=no
