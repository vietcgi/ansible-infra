# Prometheus Configuration File
# Generated by Ansible - DO NOT EDIT MANUALLY
# Last updated: {{ ansible_date_time.iso8601 }}
# Environment: {{ ansible_os_family }}

global:
  # Prometheus global configuration
  scrape_interval: {{ monitoring_prometheus_scrape_interval | default('15s') }}
  evaluation_interval: {{ monitoring_prometheus_evaluation_interval | default('15s') }}
  scrape_timeout: {{ monitoring_prometheus_scrape_timeout | default('10s') }}

  # Data retention
  retention.time: {{ monitoring_prometheus_retention | default('30d') }}
  retention.size: {{ monitoring_prometheus_retention_size | default('50GB') }}

  # Default labels added to all metrics
  external_labels:
    monitor: '{{ ansible_hostname }}'
    environment: '{{ monitoring_environment | default("production") }}'
    region: '{{ monitoring_region | default("default") }}'
    cluster: '{{ monitoring_cluster_name | default("default") }}'

# Alerting configuration
alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - localhost:{{ monitoring_alertmanager_port | default('9093') }}

# Rules configuration
rule_files:
  - '/etc/prometheus/rules/*.yml'

# Scrape configurations
scrape_configs:
  # ============================================================================
  # Prometheus self-monitoring
  # ============================================================================
  - job_name: 'prometheus'
    honor_timestamps: true
    scrape_interval: 15s
    scrape_timeout: 10s
    metrics_path: '/metrics'
    scheme: http
    static_configs:
      - targets:
          - 'localhost:{{ monitoring_prometheus_port | default("9090") }}'
    relabel_configs:
      - source_labels: [__address__]
        target_label: instance
      - source_labels: [__scheme__]
        target_label: scheme

  # ============================================================================
  # Node Exporter Metrics (System Metrics)
  # ============================================================================
  - job_name: 'node'
    honor_timestamps: true
    scrape_interval: 30s
    scrape_timeout: 10s
    metrics_path: '/metrics'
    scheme: http
    static_configs:
      - targets:
          - 'localhost:{{ monitoring_node_exporter_port | default("9100") }}'
        labels:
          instance: '{{ ansible_hostname }}'
          group: 'linux'
    relabel_configs:
      - source_labels: [__address__]
        target_label: instance
      - source_labels: [__scheme__]
        target_label: scheme

  # ============================================================================
  # Disk Space Metrics
  # ============================================================================
  - job_name: 'node-disk'
    honor_timestamps: true
    scrape_interval: 60s
    scrape_timeout: 10s
    metrics_path: '/metrics'
    scheme: http
    static_configs:
      - targets:
          - 'localhost:{{ monitoring_node_exporter_port | default("9100") }}'
        labels:
          instance: '{{ ansible_hostname }}'
          group: 'disk'
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: 'node_filesystem_.*|node_disk_.*'
        action: keep

  # ============================================================================
  # Network Metrics
  # ============================================================================
  - job_name: 'node-network'
    honor_timestamps: true
    scrape_interval: 60s
    scrape_timeout: 10s
    metrics_path: '/metrics'
    scheme: http
    static_configs:
      - targets:
          - 'localhost:{{ monitoring_node_exporter_port | default("9100") }}'
        labels:
          instance: '{{ ansible_hostname }}'
          group: 'network'
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: 'node_network_.*|node_tcp_.*|node_udp_.*'
        action: keep

  # ============================================================================
  # CPU & Memory Metrics
  # ============================================================================
  - job_name: 'node-cpu-memory'
    honor_timestamps: true
    scrape_interval: 15s
    scrape_timeout: 10s
    metrics_path: '/metrics'
    scheme: http
    static_configs:
      - targets:
          - 'localhost:{{ monitoring_node_exporter_port | default("9100") }}'
        labels:
          instance: '{{ ansible_hostname }}'
          group: 'cpu-memory'
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: 'node_cpu_.*|node_memory_.*'
        action: keep

  # ============================================================================
  # Process Metrics
  # ============================================================================
  - job_name: 'node-processes'
    honor_timestamps: true
    scrape_interval: 30s
    scrape_timeout: 10s
    metrics_path: '/metrics'
    scheme: http
    static_configs:
      - targets:
          - 'localhost:{{ monitoring_node_exporter_port | default("9100") }}'
        labels:
          instance: '{{ ansible_hostname }}'
          group: 'processes'
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: 'node_procs_.*|node_processes_.*'
        action: keep

{% if monitoring_consul_enabled | default(false) %}
  # ============================================================================
  # Consul Service Discovery Integration
  # ============================================================================
  - job_name: 'consul-sd'
    honor_timestamps: true
    scrape_interval: 30s
    scrape_timeout: 10s
    metrics_path: '/metrics'
    scheme: http
    consul_sd_configs:
      - server: 'localhost:8500'
        datacenter: '{{ monitoring_consul_datacenter | default("dc1") }}'
    relabel_configs:
      - source_labels: [__meta_consul_service]
        target_label: service
      - source_labels: [__meta_consul_node]
        target_label: node
{% endif %}

{% if monitoring_custom_scrape_configs is defined %}
  # ============================================================================
  # Custom Scrape Configurations
  # ============================================================================
{% for config in monitoring_custom_scrape_configs %}
  - job_name: '{{ config.job_name }}'
    scrape_interval: {{ config.scrape_interval | default('30s') }}
    scrape_timeout: {{ config.scrape_timeout | default('10s') }}
    metrics_path: '{{ config.metrics_path | default("/metrics") }}'
    scheme: {{ config.scheme | default("http") }}
{% if config.basic_auth is defined %}
    basic_auth:
      username: {{ config.basic_auth.username }}
      password_file: {{ config.basic_auth.password_file }}
{% endif %}
    static_configs:
      - targets: {{ config.targets | to_nice_json }}
{% if config.labels is defined %}
        labels:
{% for key, value in config.labels.items() %}
          {{ key }}: '{{ value }}'
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

# ============================================================================
# Remote Storage Configuration (Optional)
# ============================================================================
{% if monitoring_remote_storage_enabled | default(false) %}
remote_write:
  - url: "{{ monitoring_remote_write_url }}"
    queue_config:
      max_shards: {{ monitoring_remote_write_max_shards | default('200') }}
      min_shards: {{ monitoring_remote_write_min_shards | default('1') }}
      max_samples_per_send: {{ monitoring_remote_write_max_samples | default('500') }}
      batch_send_wait: {{ monitoring_remote_write_batch_wait | default('5s') }}
      min_retry_period: {{ monitoring_remote_write_min_retry | default('30ms') }}
      max_retry_period: {{ monitoring_remote_write_max_retry | default('100ms') }}
    metadata_config:
      send: {{ monitoring_remote_write_metadata | default('true') }}
      send_interval: {{ monitoring_remote_write_metadata_interval | default('1m') }}
{% if monitoring_remote_write_basic_auth is defined %}
    basic_auth:
      username: {{ monitoring_remote_write_basic_auth.username }}
      password_file: {{ monitoring_remote_write_basic_auth.password_file }}
{% endif %}

remote_read:
  - url: "{{ monitoring_remote_read_url | default(monitoring_remote_write_url) }}"
{% if monitoring_remote_read_basic_auth is defined %}
    basic_auth:
      username: {{ monitoring_remote_read_basic_auth.username }}
      password_file: {{ monitoring_remote_read_basic_auth.password_file }}
{% endif %}
{% endif %}
