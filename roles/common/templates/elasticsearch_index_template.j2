{
  "index_patterns": ["filebeat-*", "rsyslog-*"],
  "template": {
    "settings": {
      "index": {
        "number_of_shards": {{ log_shipping_es_shards | default(1) }},
        "number_of_replicas": {{ log_shipping_es_replicas | default(0) }},
        "lifecycle.name": "filebeat",
        "codec": "best_compression"
      }
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "@version": {
          "type": "keyword"
        },
        "agent": {
          "properties": {
            "hostname": {
              "type": "keyword"
            },
            "name": {
              "type": "keyword"
            },
            "type": {
              "type": "keyword"
            },
            "version": {
              "type": "keyword"
            }
          }
        },
        "ecs": {
          "properties": {
            "version": {
              "type": "keyword"
            }
          }
        },
        "event": {
          "properties": {
            "action": {
              "type": "keyword"
            },
            "category": {
              "type": "keyword"
            },
            "code": {
              "type": "keyword"
            },
            "created": {
              "type": "date"
            },
            "duration": {
              "type": "long"
            },
            "hash": {
              "type": "keyword"
            },
            "id": {
              "type": "keyword"
            },
            "kind": {
              "type": "keyword"
            },
            "module": {
              "type": "keyword"
            },
            "original": {
              "type": "text",
              "index": false
            },
            "outcome": {
              "type": "keyword"
            },
            "provider": {
              "type": "keyword"
            },
            "reference": {
              "type": "keyword"
            },
            "risk_score": {
              "type": "float"
            },
            "severity": {
              "type": "byte"
            },
            "start": {
              "type": "date"
            },
            "timezone": {
              "type": "keyword"
            },
            "type": {
              "type": "keyword"
            }
          }
        },
        "host": {
          "properties": {
            "architecture": {
              "type": "keyword"
            },
            "containerized": {
              "type": "boolean"
            },
            "domain": {
              "type": "keyword"
            },
            "hostname": {
              "type": "keyword"
            },
            "id": {
              "type": "keyword"
            },
            "ip": {
              "type": "ip"
            },
            "mac": {
              "type": "keyword"
            },
            "name": {
              "type": "keyword"
            },
            "os": {
              "properties": {
                "build": {
                  "type": "keyword"
                },
                "codename": {
                  "type": "keyword"
                },
                "family": {
                  "type": "keyword"
                },
                "full": {
                  "type": "text"
                },
                "kernel": {
                  "type": "keyword"
                },
                "name": {
                  "type": "keyword"
                },
                "platform": {
                  "type": "keyword"
                },
                "type": {
                  "type": "keyword"
                },
                "version": {
                  "type": "keyword"
                }
              }
            },
            "type": {
              "type": "keyword"
            },
            "uptime": {
              "type": "long"
            }
          }
        },
        "log": {
          "properties": {
            "file": {
              "properties": {
                "path": {
                  "type": "keyword"
                }
              }
            },
            "level": {
              "type": "keyword"
            },
            "logger": {
              "type": "keyword"
            },
            "origin": {
              "properties": {
                "file": {
                  "properties": {
                    "line": {
                      "type": "integer"
                    },
                    "name": {
                      "type": "keyword"
                    }
                  }
                },
                "function": {
                  "type": "keyword"
                }
              }
            },
            "syslog": {
              "properties": {
                "facility": {
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "name": {
                      "type": "keyword"
                    }
                  }
                },
                "priority": {
                  "type": "integer"
                },
                "severity": {
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "name": {
                      "type": "keyword"
                    }
                  }
                }
              }
            }
          }
        },
        "message": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        },
        "process": {
          "properties": {
            "args": {
              "type": "keyword"
            },
            "executable": {
              "type": "keyword"
            },
            "name": {
              "type": "keyword"
            },
            "pid": {
              "type": "long"
            },
            "ppid": {
              "type": "long"
            },
            "start": {
              "type": "date"
            },
            "thread": {
              "properties": {
                "id": {
                  "type": "long"
                },
                "name": {
                  "type": "keyword"
                }
              }
            },
            "title": {
              "type": "keyword"
            },
            "working_directory": {
              "type": "keyword"
            }
          }
        },
        "source": {
          "properties": {
            "address": {
              "type": "keyword"
            },
            "as": {
              "properties": {
                "number": {
                  "type": "long"
                },
                "organization": {
                  "properties": {
                    "name": {
                      "type": "text",
                      "fields": {
                        "keyword": {
                          "type": "keyword"
                        }
                      }
                    }
                  }
                }
              }
            },
            "domain": {
              "type": "keyword"
            },
            "geo": {
              "properties": {
                "city_name": {
                  "type": "keyword"
                },
                "continent_name": {
                  "type": "keyword"
                },
                "country_iso_code": {
                  "type": "keyword"
                },
                "country_name": {
                  "type": "keyword"
                },
                "location": {
                  "type": "geo_point"
                },
                "name": {
                  "type": "keyword"
                },
                "region_iso_code": {
                  "type": "keyword"
                },
                "region_name": {
                  "type": "keyword"
                },
                "timezone": {
                  "type": "keyword"
                }
              }
            },
            "ip": {
              "type": "ip"
            },
            "mac": {
              "type": "keyword"
            },
            "nat": {
              "properties": {
                "ip": {
                  "type": "ip"
                },
                "port": {
                  "type": "long"
                }
              }
            },
            "port": {
              "type": "long"
            }
          }
        },
        "syslog": {
          "properties": {
            "facility": {
              "type": "keyword"
            },
            "hostname": {
              "type": "keyword"
            },
            "priority": {
              "type": "integer"
            },
            "severity": {
              "type": "keyword"
            }
          }
        },
        "tags": {
          "type": "keyword"
        },
        "user": {
          "properties": {
            "domain": {
              "type": "keyword"
            },
            "effective": {
              "properties": {
                "domain": {
                  "type": "keyword"
                },
                "group": {
                  "properties": {
                    "id": {
                      "type": "keyword"
                    },
                    "name": {
                      "type": "keyword"
                    }
                  }
                },
                "id": {
                  "type": "keyword"
                },
                "name": {
                  "type": "keyword"
                }
              }
            },
            "group": {
              "properties": {
                "domain": {
                  "type": "keyword"
                },
                "id": {
                  "type": "keyword"
                },
                "name": {
                  "type": "keyword"
                }
              }
            },
            "id": {
              "type": "keyword"
            },
            "name": {
              "type": "keyword"
            },
            "risk": {
              "properties": {
                "calculated_level": {
                  "type": "keyword"
                },
                "calculated_score": {
                  "type": "float"
                },
                "calculated_score_norm": {
                  "type": "float"
                },
                "static_level": {
                  "type": "keyword"
                },
                "static_score": {
                  "type": "float"
                },
                "static_score_norm": {
                  "type": "float"
                }
              }
            }
          }
        }
      }
    }
  }
}

