# Filebeat Configuration
# Forwards logs to Elasticsearch/Logstash for centralized collection
# Generated by Ansible - DO NOT EDIT MANUALLY

filebeat.inputs:

# System logs from syslog
- type: log
  enabled: true
  paths:
    - /var/log/syslog
    - /var/log/messages
    - /var/log/secure
  fields:
    log_source: syslog
    environment: {{ log_shipping_environment | default('production') }}

# Authentication logs
- type: log
  enabled: true
  paths:
    - /var/log/auth.log
    - /var/log/secure
    - /var/log/audit/audit.log
  fields:
    log_source: auth
    environment: {{ log_shipping_environment | default('production') }}

# Kernel logs
- type: log
  enabled: true
  paths:
    - /var/log/kern.log
  fields:
    log_source: kernel
    environment: {{ log_shipping_environment | default('production') }}

# fail2ban logs
- type: log
  enabled: true
  paths:
    - /var/log/fail2ban.log
  fields:
    log_source: fail2ban
    environment: {{ log_shipping_environment | default('production') }}
  multiline.pattern: '^\['
  multiline.negate: false
  multiline.match: after

# Application logs (custom)
{% if log_shipping_application_logs is defined %}
{% for app_log in log_shipping_application_logs %}
- type: log
  enabled: true
  paths:
    - {{ app_log.path }}
  fields:
    log_source: {{ app_log.source | default('application') }}
    app: {{ app_log.name | default('unknown') }}
    environment: {{ log_shipping_environment | default('production') }}
{% endfor %}
{% endif %}

# Processors for log enrichment
processors:
  - add_host_metadata:
      netinfo.enabled: true
      cache.ttl: 5m
  - add_cloud_metadata: ~
  - add_docker_metadata: ~
  - add_fields:
      target: host
      fields:
        hostname: {{ ansible_hostname }}
        fqdn: {{ ansible_fqdn }}
        environment: {{ log_shipping_environment | default('production') }}
        datacenter: {{ log_shipping_datacenter | default('unknown') }}

# Output configuration
output.elasticsearch:
  hosts:
    - "{{ log_shipping_elasticsearch_host }}:{{ log_shipping_elasticsearch_port }}"
  username: "{{ log_shipping_elasticsearch_user | default('') }}"
  password: "{{ log_shipping_elasticsearch_password | default('') }}"
  protocol: "{{ log_shipping_elasticsearch_protocol | default('http') }}"
  index: "filebeat-%{+yyyy.MM.dd}"
  bulk_max_size: {{ log_shipping_bulk_max_size | default(50) }}

# Optional: Logstash output (uncomment to use instead of Elasticsearch)
{% if log_shipping_use_logstash | default(false) %}
#output.logstash:
#  hosts:
#    - "{{ log_shipping_logstash_host }}:{{ log_shipping_logstash_port }}"
#  index: "filebeat-%{+yyyy.MM.dd}"
{% endif %}

# Optional: Kafka output (uncomment for high-volume scenarios)
{% if log_shipping_use_kafka | default(false) %}
#output.kafka:
#  hosts:
#    - "{{ log_shipping_kafka_broker }}:{{ log_shipping_kafka_port }}"
#  topic: filebeat
{% endif %}

# Logging configuration
logging.level: {{ log_shipping_filebeat_log_level | default('info') }}
logging.to_files: true
logging.files:
  path: /var/log/filebeat
  name: filebeat
  keepfiles: 7
  permissions: 0640

# Setup
setup.template.enabled: {{ log_shipping_setup_template | default('true') }}
setup.template.name: "filebeat"
setup.template.pattern: "filebeat-*"
setup.template.overwrite: {{ log_shipping_overwrite_template | default('true') }}

# Dashboards and index patterns (optional)
setup.dashboards.enabled: {{ log_shipping_setup_dashboards | default('false') }}
setup.kibana:
  host: "{{ log_shipping_kibana_host | default(log_shipping_elasticsearch_host) }}:{{ log_shipping_kibana_port | default(5601) }}"

# Performance tuning
filebeat.registry.path: /var/lib/filebeat/registry
filebeat.registry.file_permissions: 0600
filebeat.spool_size: {{ log_shipping_spool_size | default(2048) }}
filebeat.idle_timeout: {{ log_shipping_idle_timeout | default('5s') }}

# Queue settings for reliability
queue.mem:
  events: {{ log_shipping_queue_events | default(4096) }}
  flush.min_events: {{ log_shipping_queue_min_events | default(512) }}
  flush.timeout: {{ log_shipping_queue_timeout | default('1s') }}

# Monitoring (X-Pack)
monitoring.enabled: {{ log_shipping_monitoring_enabled | default('false') }}
monitoring.cluster_uuid: "{{ log_shipping_cluster_uuid | default('') }}"
