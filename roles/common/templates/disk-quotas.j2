# Disk Quota Configuration
# Generated by Ansible - Do not edit manually

# Filesystem quota settings
quotas:
  enabled: {{ storage_enable_quotas | default(true) }}

  # Per-user quotas (in KB)
  user_soft_limit: {{ quota_user_soft_limit | default(5242880) }}  # 5GB
  user_hard_limit: {{ quota_user_hard_limit | default(10485760) }} # 10GB

  # Per-group quotas (in KB)
  group_soft_limit: {{ quota_group_soft_limit | default(10485760) }}  # 10GB
  group_hard_limit: {{ quota_group_hard_limit | default(20971520) }} # 20GB

  # Grace period (in seconds)
  grace_period: {{ quota_grace_period | default(604800) }}  # 7 days

# Monitored filesystems
filesystems:
  home:
    path: /home
    monitor: true
    quota_type: usrquota,grpquota

  var:
    path: /var
    monitor: true
    quota_type: usrquota

# Alert thresholds
alerts:
  user_quota_warning: {{ quota_alert_warning_percent | default(80) }}  # 80%
  user_quota_critical: {{ quota_alert_critical_percent | default(95) }} # 95%
  group_quota_warning: {{ quota_alert_warning_percent | default(80) }}
  group_quota_critical: {{ quota_alert_critical_percent | default(95) }}
