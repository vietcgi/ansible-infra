#!/bin/bash
# fail2ban status monitoring script
# Provides detailed information about fail2ban jails and banned IPs
# Generated by Ansible - DO NOT EDIT MANUALLY

set -euo pipefail

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Script variables
SCRIPT_NAME=$(basename "$0")
FAIL2BAN_CLIENT="{{ fail2ban_client_path | default('/usr/bin/fail2ban-client') }}"
LOG_FILE="{{ fail2ban_log_file | default('/var/log/fail2ban.log') }}"
VERBOSE="{{ fail2ban_status_verbose | default('false') }}"
OUTPUT_FORMAT="{{ fail2ban_status_format | default('text') }}"

# Functions
print_header() {
    echo -e "\n${BLUE}=== $1 ===${NC}\n"
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

# Check if fail2ban is running
check_fail2ban_status() {
    print_header "fail2ban Service Status"

    if systemctl is-active --quiet fail2ban; then
        print_success "fail2ban service is running"
        return 0
    else
        print_error "fail2ban service is NOT running"
        return 1
    fi
}

# Get overall fail2ban statistics
get_fail2ban_stats() {
    print_header "Overall Statistics"

    # Get version
    version=$("$FAIL2BAN_CLIENT" --version 2>/dev/null || echo "Unknown")
    echo "Version: $version"

    # Get uptime (time since service started)
    start_time=$(systemctl status fail2ban | grep "Active:" || echo "N/A")
    echo "Status: $start_time"

    # Get total jails
    jails=$("$FAIL2BAN_CLIENT" status 2>/dev/null | grep "Number of jails:" | awk '{print $NF}')
    echo "Total Jails: $jails"
}

# List all jails and their status
list_jails() {
    print_header "Jail Summary"

    "$FAIL2BAN_CLIENT" status 2>/dev/null | grep -E "^\s+\w+" | while read -r jail; do
        jail_name=$(echo "$jail" | awk '{print $1}')
        get_jail_details "$jail_name"
    done
}

# Get detailed information for a specific jail
get_jail_details() {
    local jail=$1

    # Get jail status
    status=$("$FAIL2BAN_CLIENT" status "$jail" 2>/dev/null)

    # Extract ban count
    banned=$(echo "$status" | grep "Banned IP list:" | awk '{print NF-3}')
    failed=$(echo "$status" | grep "Failed attempts:" | awk '{print $NF}')

    printf "%-20s | Banned IPs: %-5s | Failed attempts: %s\n" "$jail" "$banned" "$failed"

    # Detailed jail info if verbose
    if [[ "$VERBOSE" == "true" ]]; then
        echo "$status" | grep -E "(Currently failed|Banned IP list:)"
    fi
}

# Show banned IPs across all jails
show_banned_ips() {
    print_header "Currently Banned IPs"

    "$FAIL2BAN_CLIENT" status 2>/dev/null | grep -oE "([0-9]{1,3}\.){3}[0-9]{1,3}" | sort -u | while read -r ip; do
        jails=$("$FAIL2BAN_CLIENT" status 2>/dev/null | grep -l "$ip" || true)
        echo "IP: $ip"
        if [[ ! -z "$jails" ]]; then
            echo "  Jails: $jails"
        fi
    done
}

# Show recent ban/unban activity
show_recent_activity() {
    print_header "Recent Ban Activity"

    if [[ -f "$LOG_FILE" ]]; then
        # Show last 20 ban events
        grep -E "(Ban|Unban)" "$LOG_FILE" | tail -20 | while read -r line; do
            if echo "$line" | grep -q "Ban"; then
                print_warning "$(echo $line | awk '{print $1,$2,$3,$4,$5,$6}')"
            else
                print_success "$(echo $line | awk '{print $1,$2,$3,$4,$5,$6}')"
            fi
        done
    else
        print_error "Log file not found: $LOG_FILE"
    fi
}

# Check for any errors or warnings
check_health() {
    print_header "Health Check"

    # Check if database exists
    if [[ -f /var/lib/fail2ban/fail2ban.sqlite3 ]]; then
        print_success "Database file exists"
    else
        print_error "Database file missing"
    fi

    # Check log file
    if [[ -f "$LOG_FILE" ]]; then
        print_success "Log file exists"
        size=$(du -h "$LOG_FILE" | awk '{print $1}')
        echo "  Size: $size"
    else
        print_error "Log file missing"
    fi

    # Check for errors in recent logs
    error_count=$(grep -c "ERROR" "$LOG_FILE" 2>/dev/null || echo 0)
    if [[ $error_count -gt 0 ]]; then
        print_warning "Found $error_count errors in recent logs"
    else
        print_success "No errors in recent logs"
    fi
}

# Generate JSON output (for monitoring systems)
output_json() {
    cat << EOF
{
  "fail2ban_status": "$(systemctl is-active fail2ban)",
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "version": "$("$FAIL2BAN_CLIENT" --version 2>/dev/null || echo 'Unknown')",
  "jails": [
EOF

    "$FAIL2BAN_CLIENT" status 2>/dev/null | grep -oE "^\s+\w+" | while read -r jail; do
        status=$("$FAIL2BAN_CLIENT" status "$jail" 2>/dev/null)
        banned=$(echo "$status" | grep "Banned IP list:" | wc -w)
        failed=$(echo "$status" | grep "Failed attempts:" | awk '{print $NF}')
        echo "    {\"name\": \"$jail\", \"banned_ips\": $banned, \"failed_attempts\": $failed},"
    done | sed '$ s/,$//'

    echo "  ]"
    echo "}"
}

# Main function
main() {
    case "${1:-status}" in
        status)
            check_fail2ban_status
            get_fail2ban_stats
            list_jails
            ;;
        banned)
            show_banned_ips
            ;;
        activity)
            show_recent_activity
            ;;
        health)
            check_health
            ;;
        json)
            output_json
            ;;
        help)
            echo "Usage: $SCRIPT_NAME [command]"
            echo ""
            echo "Commands:"
            echo "  status     - Show fail2ban status and jail summary (default)"
            echo "  banned     - Show currently banned IPs"
            echo "  activity   - Show recent ban/unban activity"
            echo "  health     - Check fail2ban health"
            echo "  json       - Output status in JSON format"
            echo "  help       - Show this help message"
            echo ""
            echo "Examples:"
            echo "  $SCRIPT_NAME status"
            echo "  $SCRIPT_NAME banned"
            echo "  $SCRIPT_NAME activity"
            echo "  $SCRIPT_NAME json | jq ."
            ;;
        *)
            echo "Unknown command: $1"
            echo "Run '$SCRIPT_NAME help' for usage information"
            exit 1
            ;;
    esac
}

# Run main function
main "${@:-status}"
