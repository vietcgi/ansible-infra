# Prometheus scrape configuration for node_exporter
# Generated by Ansible - DO NOT EDIT MANUALLY

global:
  scrape_interval: {{ metrics_scrape_interval | default('15s') }}
  scrape_timeout: {{ metrics_scrape_timeout | default('10s') }}
  evaluation_interval: {{ metrics_evaluation_interval | default('15s') }}

# Alert configuration (optional)
{% if metrics_alertmanager_enabled | default(false) %}
alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - {{ metrics_alertmanager_host | default('localhost') }}:{{ metrics_alertmanager_port | default(9093) }}
{% endif %}

# Node Exporter job configuration
scrape_configs:
  - job_name: 'node_exporter'
    description: 'Prometheus node_exporter metrics'

    # Metrics path (standard for node_exporter)
    metrics_path: '{{ metrics_telemetry_path | default('/metrics') }}'

    # Scheme (http or https)
    scheme: {{ metrics_scheme | default('http') }}

    # Scrape interval for this job
    scrape_interval: {{ metrics_scrape_interval | default('15s') }}
    scrape_timeout: {{ metrics_scrape_timeout | default('10s') }}

    # Static targets (local host)
    static_configs:
      - targets:
          - 'localhost:{{ metrics_listen_port | default(9100) }}'
        labels:
          hostname: '{{ ansible_hostname }}'
          environment: '{{ metrics_environment | default('production') }}'
          datacenter: '{{ metrics_datacenter | default('unknown') }}'

    # Service discovery (optional - uncomment if using service discovery)
    {% if metrics_consul_enabled | default(false) %}
    consul_sd_configs:
      - server: '{{ metrics_consul_host | default('localhost') }}:{{ metrics_consul_port | default(8500) }}'
        datacenter: '{{ metrics_datacenter | default('dc1') }}'
        services: ['node_exporter']
    {% endif %}

    # Relabeling rules
    relabel_configs:
      # Add instance label
      - source_labels: [__address__]
        target_label: instance

      # Add job label
      - source_labels: [__scheme__]
        target_label: scheme

      # Add metrics source
      - target_label: metrics_source
        replacement: 'node_exporter'

      # Add scrape endpoint
      - source_labels: [__metrics_path__]
        target_label: metrics_path

    # Metric relabeling (modify metrics before storage)
    metric_relabel_configs:
      # Drop high-cardinality metrics if needed
      {% if metrics_drop_high_cardinality | default(false) %}
      - source_labels: [__name__]
        regex: 'node_netdev_receive_bytes_total|node_netdev_transmit_bytes_total'
        action: drop
      {% endif %}

      # Add custom labels
      - target_label: 'service'
        replacement: 'node_exporter'

      - target_label: 'version'
        replacement: '{{ metrics_node_exporter_version | default("latest") }}'

    # Module configuration (if using module discovery)
    {% if metrics_modules_enabled | default(false) %}
    params:
      module:
        - {{ metrics_module_name | default('default') }}
    {% endif %}

---

# Optional: Additional remote storage configuration
{% if metrics_remote_write_enabled | default(false) %}
remote_write:
  - url: {{ metrics_remote_write_url | default('http://localhost:9009/api/v1/write') }}
    write_relabel_configs:
      - source_labels: [__name__]
        regex: 'go_.*'
        action: drop
{% endif %}

---

# Optional: Remote read configuration
{% if metrics_remote_read_enabled | default(false) %}
remote_read:
  - url: {{ metrics_remote_read_url | default('http://localhost:9009/api/v1/read') }}
{% endif %}

---

# Service configuration notes
# Metrics are collected from: {{ ansible_hostname }}:{{ metrics_listen_port | default(9100) }}
# Collection interval: {{ metrics_scrape_interval | default('15s') }}
# Retention period: {{ metrics_retention_period | default('15d') }}

# Available metrics from node_exporter:
# - CPU metrics: node_cpu_seconds_total, node_load*
# - Memory metrics: node_memory_MemTotal_bytes, node_memory_MemFree_bytes
# - Disk metrics: node_disk_io_time_seconds_total, node_filesystem_avail_bytes
# - Network metrics: node_network_receive_bytes_total, node_network_transmit_bytes_total
# - System metrics: node_boot_time_seconds, node_uptime_total_seconds
# - Process metrics: node_processes_running, node_processes_blocked

# Prometheus service restart command:
# sudo systemctl restart prometheus

# Test connectivity:
# curl -s http://{{ ansible_hostname }}:{{ metrics_listen_port | default(9100) }}/metrics | head -20
