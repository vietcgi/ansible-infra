#
# Bacula File Daemon (Client) Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# For more information about configuring the FD,
# please see the Bacula documentation.

FileDaemon {
  Name = {{ ansible_hostname }}-fd
  FDPort = {{ bacula_fd_port | default(9102) }}
  WorkingDirectory = "/var/spool/bacula"
  Pid Directory = "/var/run"
  Maximum Concurrent Jobs = {{ bacula_max_jobs | default(20) }}
  FDAddress = {{ bacula_fd_address | default('0.0.0.0') }}

  # Enable TLS if configured
  {% if bacula_tls_enabled | default(false) %}
  TLS Enable = yes
  TLS Require = yes
  TLS Certificate = "/etc/bacula/certs/bacula-fd.pem"
  TLS Key = "/etc/bacula/certs/bacula-fd-key.pem"
  TLS Allowed CN = "{{ bacula_director_cn | default('director.example.com') }}"

  {% if bacula_ca_cert is defined %}
  TLS CA Certificate File = "{{ bacula_ca_cert }}"
  {% endif %}
  {% else %}
  TLS Enable = no
  {% endif %}

  # Enable communication with director
  # Replace with actual director password
  Password = "{{ bacula_fd_password | default('ClientPassword') }}"

  # Enable heartbeat to prevent idle connection timeout
  Heartbeat Interval = {{ bacula_heartbeat | default(600) }}
}

# Send all messages back to Director
Messages {
  Name = Standard
  director = {{ bacula_director_address | default('director.example.com') }} = all
}

# Include any additional FD configuration
{% if bacula_fd_additional_config is defined %}
{{ bacula_fd_additional_config }}
{% endif %}

