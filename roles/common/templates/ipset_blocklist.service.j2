# ipset blocklist systemd service
# Loads blocklist on boot and adds iptables rule
# Generated by Ansible - DO NOT EDIT MANUALLY

[Unit]
Description=IP Blocklist (ipset)
Before=ufw.service
Before=firewalld.service
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/update-blocklist.sh
ExecStart=/bin/sh -c '/sbin/iptables -C INPUT -m set --match-set blocklist src -j DROP 2>/dev/null || /sbin/iptables -I INPUT -m set --match-set blocklist src -j DROP'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
