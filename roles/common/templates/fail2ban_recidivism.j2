# fail2ban recidivism jail configuration
# Tracks repeat offenders and applies longer ban times
# Generated by Ansible - DO NOT EDIT MANUALLY

[recidivism]
enabled = true
filter = recidive
action = %(action_mwl)s

# Recidivism detection settings
# Track IPs that have been banned multiple times
logpath = /var/log/fail2ban.log

# First recidivism: ban for 1 day
maxretry = {{ fail2ban_recidivism_maxretry_1 | default(1) }}
findtime = {{ fail2ban_recidivism_findtime_1 | default(604800) }}
bantime = {{ fail2ban_recidivism_bantime_1 | default(86400) }}

# Second offense: ban for 1 week
[recidivism-2]
enabled = {{ fail2ban_enable_recidivism_2 | default(true) | lower }}
filter = recidive
action = %(action_mwl)s
logpath = /var/log/fail2ban.log

maxretry = {{ fail2ban_recidivism_maxretry_2 | default(2) }}
findtime = {{ fail2ban_recidivism_findtime_2 | default(1209600) }}
bantime = {{ fail2ban_recidivism_bantime_2 | default(604800) }}

destemail = {{ fail2ban_destemail | default('root') }}
sendername = {{ fail2ban_sendername | default('Fail2Ban') }}

# Third offense: ban for 1 month
[recidivism-3]
enabled = {{ fail2ban_enable_recidivism_3 | default(true) | lower }}
filter = recidive
action = %(action_mwl)s
logpath = /var/log/fail2ban.log

maxretry = {{ fail2ban_recidivism_maxretry_3 | default(3) }}
findtime = {{ fail2ban_recidivism_findtime_3 | default(2592000) }}
bantime = {{ fail2ban_recidivism_bantime_3 | default(2592000) }}

destemail = {{ fail2ban_destemail | default('root') }}
sendername = {{ fail2ban_sendername | default('Fail2Ban') }}

# Fourth offense or more: permanent ban (1 year)
[recidivism-4plus]
enabled = {{ fail2ban_enable_recidivism_4plus | default(true) | lower }}
filter = recidive
action = %(action_mwl)s
logpath = /var/log/fail2ban.log

maxretry = {{ fail2ban_recidivism_maxretry_4plus | default(4) }}
findtime = {{ fail2ban_recidivism_findtime_4plus | default(31536000) }}
bantime = {{ fail2ban_recidivism_bantime_4plus | default(31536000) }}

destemail = {{ fail2ban_destemail | default('root') }}
sendername = {{ fail2ban_sendername | default('Fail2Ban') }}

# Recidivism escalation formula:
# Offense 1: 1 day (86400 seconds)
# Offense 2: 7 days (604800 seconds)
# Offense 3: 30 days (2592000 seconds)
# Offense 4+: 365 days (31536000 seconds) - essentially permanent
#
# Ban times are cumulative - the longer the offender history, the longer the ban
# This encourages attackers to move to different targets rather than retry
