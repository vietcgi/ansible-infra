#!/bin/bash
# Custom metrics collection script for Prometheus
# Collects additional system metrics beyond node_exporter
# Generated by Ansible - DO NOT EDIT MANUALLY

set -euo pipefail

# Configuration
TEXTFILE_COLLECTOR_DIR="/var/lib/node_exporter/textfile_collector"
HOSTNAME="{{ ansible_hostname }}"
METRICS_PREFIX="custom"
TIMESTAMP=$(date +%s)000

# Ensure directory exists
mkdir -p "$TEXTFILE_COLLECTOR_DIR"

# Function to emit metric
emit_metric() {
    local metric_name=$1
    local metric_value=$2
    local metric_type=${3:-gauge}
    local labels=${4:-"hostname=\"$HOSTNAME\""}

    echo "# HELP ${METRICS_PREFIX}_${metric_name} Custom ${metric_name} metric"
    echo "# TYPE ${METRICS_PREFIX}_${metric_name} ${metric_type}"
    echo "${METRICS_PREFIX}_${metric_name}{${labels}} ${metric_value} ${TIMESTAMP}"
}

# Collect system metrics
collect_system_metrics() {
    # CPU metrics beyond node_exporter
    local cpu_temp=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo "0" | awk '{print $1/1000}')
    emit_metric "cpu_temperature_celsius" "$cpu_temp" "gauge" "hostname=\"$HOSTNAME\",zone=\"thermal_zone0\"" >> metrics.txt

    # Memory efficiency
    local meminfo=$(cat /proc/meminfo)
    local mem_total=$(echo "$meminfo" | grep MemTotal | awk '{print $2}')
    local mem_available=$(echo "$meminfo" | grep MemAvailable | awk '{print $2}')
    local mem_used=$((mem_total - mem_available))
    local mem_percent=$((mem_used * 100 / mem_total))

    emit_metric "memory_percent_used" "$mem_percent" "gauge" "hostname=\"$HOSTNAME\"" >> metrics.txt
}

# Collect disk metrics
collect_disk_metrics() {
    df -B1 | tail -n +2 | while read -r line; do
        local device=$(echo "$line" | awk '{print $1}')
        local used=$(echo "$line" | awk '{print $3}')
        local available=$(echo "$line" | awk '{print $4}')
        local percent=$(echo "$line" | awk '{print $5}' | sed 's/%//')
        local mount=$(echo "$line" | awk '{print $6}')

        # Only report mounted filesystems
        if [[ ! -z "$mount" ]]; then
            emit_metric "disk_usage_percent" "$percent" "gauge" "device=\"$device\",mount=\"$mount\",hostname=\"$HOSTNAME\"" >> metrics.txt
        fi
    done
}

# Collect network metrics
collect_network_metrics() {
    # Get network interface stats
    cat /proc/net/dev | tail -n +3 | while read -r line; do
        local iface=$(echo "$line" | awk -F: '{print $1}' | xargs)
        local recv_bytes=$(echo "$line" | awk '{print $2}')
        local recv_errors=$(echo "$line" | awk '{print $4}')
        local trans_bytes=$(echo "$line" | awk '{print $10}')
        local trans_errors=$(echo "$line" | awk '{print $12}')

        emit_metric "network_errors_total" "$((recv_errors + trans_errors))" "counter" "device=\"$iface\",hostname=\"$HOSTNAME\"" >> metrics.txt
    done
}

# Collect process metrics
collect_process_metrics() {
    # Number of open connections
    local open_connections=$(ss -tun | tail -n +2 | wc -l)
    emit_metric "open_connections_total" "$open_connections" "gauge" "hostname=\"$HOSTNAME\"" >> metrics.txt

    # Active processes
    local active_processes=$(ps aux | wc -l)
    emit_metric "active_processes_total" "$active_processes" "gauge" "hostname=\"$HOSTNAME\"" >> metrics.txt

    # Zombie processes
    local zombie_processes=$(ps aux | grep defunct | wc -l)
    emit_metric "zombie_processes_total" "$zombie_processes" "gauge" "hostname=\"$HOSTNAME\"" >> metrics.txt
}

# Collect security metrics
collect_security_metrics() {
    # Failed login attempts (from auth log)
    if [[ -f /var/log/auth.log ]]; then
        local failed_logins=$(grep -c "Failed password" /var/log/auth.log 2>/dev/null || echo "0")
        emit_metric "failed_logins_total" "$failed_logins" "counter" "hostname=\"$HOSTNAME\",source=\"auth.log\"" >> metrics.txt
    fi

    # Open SSH connections
    local ssh_connections=$(ss -tn | grep -c ":22 " 2>/dev/null || echo "0")
    emit_metric "ssh_connections_total" "$ssh_connections" "gauge" "hostname=\"$HOSTNAME\"" >> metrics.txt

    # Failed sudo attempts
    local failed_sudo=$(grep -c "sudo.*COMMAND=" /var/log/auth.log 2>/dev/null || echo "0")
    emit_metric "sudo_executions_total" "$failed_sudo" "counter" "hostname=\"$HOSTNAME\"" >> metrics.txt
}

# Collect service metrics
collect_service_metrics() {
    # Check critical services
    for service in {{ metrics_critical_services | default('ssh') | join(' ') }}; do
        if systemctl is-active --quiet "$service" 2>/dev/null; then
            emit_metric "service_status" "1" "gauge" "service=\"$service\",hostname=\"$HOSTNAME\",status=\"active\"" >> metrics.txt
        else
            emit_metric "service_status" "0" "gauge" "service=\"$service\",hostname=\"$HOSTNAME\",status=\"inactive\"" >> metrics.txt
        fi
    done
}

# Collect application metrics (if applicable)
collect_app_metrics() {
    # Custom application metrics can be collected here
    {% if metrics_custom_apps is defined and metrics_custom_apps %}
    {% for app in metrics_custom_apps %}
    # Metrics for {{ app }}
    {% endfor %}
    {% endif %}

    # Example: Docker container stats
    if command -v docker &> /dev/null; then
        local container_count=$(docker ps --quiet | wc -l)
        emit_metric "docker_containers_running" "$container_count" "gauge" "hostname=\"$HOSTNAME\"" >> metrics.txt
    fi
}

# Main collection function
main() {
    local temp_file="${TEXTFILE_COLLECTOR_DIR}/custom_metrics_$HOSTNAME.tmp"
    local output_file="${TEXTFILE_COLLECTOR_DIR}/custom_metrics_$HOSTNAME.prom"

    # Initialize metrics file
    : > "$temp_file"

    # Collect all metrics
    collect_system_metrics
    collect_disk_metrics
    collect_network_metrics
    collect_process_metrics
    collect_security_metrics
    collect_service_metrics
    collect_app_metrics

    # Atomic rename (mv is atomic on most filesystems)
    mv "$temp_file" "$output_file" 2>/dev/null || true

    # Log collection timestamp
    logger -t custom-metrics-collector "Collected custom metrics for $HOSTNAME"

    exit 0
}

# Run main function
main
