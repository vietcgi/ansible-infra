# Rsyslog TLS Remote Logging Configuration
# Enables sending logs to remote syslog server over TLS/SSL

# Load required modules
module(load="imuxsock")  # Listen on local syslog socket
module(load="imklog")    # Listen on kernel logging
module(load="imudp" port="514")  # Listen on UDP
module(load="imtcp")  # Listen on TCP
module(load="omfwd")  # Forward remote

# Enable high precision timestamps
$ActionFileDefaultTemplate RSYSLOG_FileFormat
$ActionFileEnableSync on

# TLS Configuration for outbound connections
$DefaultNetstreamDriver gtls
$DefaultNetstreamDriverCAFile /etc/rsyslog.d/tls/server-cert.pem
$ActionSendStreamDriver gtls
$ActionSendStreamDriverMode 1  # TLS 1.0 and higher
$ActionSendStreamDriverAuthMode x509/name
$ActionSendStreamDriverPermittedPeer {{ logging_remote_syslog_server | default('localhost') }}

# Configure logging action (this is executed for all queued messages)
:fromhost, isequal, "localhost" action(
  type="omfwd"
  protocol="tcp"
  target="{{ logging_remote_syslog_server | default('localhost') }}"
  port="{{ logging_remote_syslog_port | default(6514) }}"
  StreamDriver="gtls"
  StreamDriverMode="1"
  StreamDriverAuthMode="x509/name"
  StreamDriverPermittedPeer="{{ logging_remote_syslog_server | default('localhost') }}"
  queue.type="linkedList"
  queue.maxdiskspace="500m"
  queue.saveonshutdown="on"
)

# Forward all messages to remote syslog server
:msg, contains, "{{ logging_remote_syslog_server | default('localhost') }}" action(
  type="omfwd"
  protocol="tcp"
  target="{{ logging_remote_syslog_server | default('localhost') }}"
  port="{{ logging_remote_syslog_port | default(6514) }}"
  StreamDriver="gtls"
  StreamDriverMode="1"
  action.resumeRetryCount="-1"
  action.type="omfwd"
  queue.type="linkedList"
  queue.maxdiskspace="500m"
  queue.saveonshutdown="on"
)
