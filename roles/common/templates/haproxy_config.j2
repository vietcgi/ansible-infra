###############################################################################
# HAProxy Configuration File
# Generated by Ansible - {{ ansible_date_time.iso8601 }}
# Do not edit manually - changes will be overwritten
###############################################################################

#---------------------------------------------------------------------
# Global Settings
#---------------------------------------------------------------------
global
  # Logging
  log stdout local0
  log stdout local1 notice
  chroot /var/lib/haproxy
  stats socket /var/run/haproxy/admin.sock mode 660 level admin
  stats timeout 30s

  # Performance
  maxconn {{ loadbalancing_haproxy_maxconn | default(4096) }}
  user haproxy
  group haproxy
  daemon

  # Security
  default-server init-addr last,libc,none
  ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384
  ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets
  tune.ssl.default-dh-param 2048

  # Tuning
  tune.bufsize {{ loadbalancing_haproxy_tune_bufsize | default(16384) }}
  tune.maxconn {{ loadbalancing_haproxy_tune_maxconn | default(2000) }}
  tune.http.maxhdr {{ loadbalancing_haproxy_tune_http_maxhdr | default(101) }}
  tune.http.keepalive {{ loadbalancing_haproxy_tune_http_keepalive | default(5000) }}

{% if loadbalancing_haproxy_global_options is defined and loadbalancing_haproxy_global_options %}
  # Custom global options
  {% for key, value in loadbalancing_haproxy_global_options.items() %}
  {{ key }} {{ value }}
  {% endfor %}
{% endif %}

#---------------------------------------------------------------------
# Default Settings
#---------------------------------------------------------------------
defaults
  # Logging
  log global
  mode http
  option httplog
  option dontlognull
  option forwardfor except 127.0.0.0/8
  option redispatch

  # Timeouts
  timeout connect {{ loadbalancing_haproxy_timeout_connect | default(5000) }}ms
  timeout client {{ loadbalancing_haproxy_timeout_client | default(50000) }}ms
  timeout server {{ loadbalancing_haproxy_timeout_server | default(50000) }}ms
  timeout http-keep-alive {{ loadbalancing_haproxy_timeout_http_keep_alive | default(1000) }}ms
  timeout check {{ loadbalancing_haproxy_timeout_check | default(10000) }}ms

  # Error Files
  errorfile 400 /etc/haproxy/errors/400.http
  errorfile 403 /etc/haproxy/errors/403.http
  errorfile 408 /etc/haproxy/errors/408.http
  errorfile 500 /etc/haproxy/errors/500.http
  errorfile 502 /etc/haproxy/errors/502.http
  errorfile 503 /etc/haproxy/errors/503.http
  errorfile 504 /etc/haproxy/errors/504.http

{% if loadbalancing_haproxy_default_options is defined and loadbalancing_haproxy_default_options %}
  # Custom default options
  {% for key, value in loadbalancing_haproxy_default_options.items() %}
  {{ key }} {{ value }}
  {% endfor %}
{% endif %}

#---------------------------------------------------------------------
# Frontend Definitions
#---------------------------------------------------------------------
{% if loadbalancing_haproxy_frontends is defined and loadbalancing_haproxy_frontends | length > 0 %}
{% for frontend in loadbalancing_haproxy_frontends %}
frontend {{ frontend.name | default('frontend-' + loop.index | string) }}
  bind {{ frontend.bind_addr | default(loadbalancing_haproxy_bind_addr | default('*')) }}:{{ frontend.port | default(loadbalancing_haproxy_frontend_port | default(80)) }}
  {% if frontend.ssl_enabled | default(false) %}
  bind {{ frontend.bind_addr | default(loadbalancing_haproxy_bind_addr | default('*')) }}:{{ frontend.ssl_port | default(443) }} ssl crt /etc/haproxy/ssl-cert.pem
  {% endif %}
  mode http
  option httplog

  {% if frontend.capture_headers is defined and frontend.capture_headers %}
  # Capture headers for logging
  {% for header in frontend.capture_headers %}
  capture request header {{ header }} len 64
  {% endfor %}
  {% endif %}

  # Access control lists
  {% if frontend.acls is defined and frontend.acls %}
  {% for acl in frontend.acls %}
  acl {{ acl.name }} {{ acl.type }} {{ acl.value }}
  {% endfor %}
  {% endif %}

  # Default backend
  {% if frontend.default_backend is defined %}
  default_backend {{ frontend.default_backend }}
  {% else %}
  default_backend {{ frontend.name | default('backend-' + loop.index | string) }}_backend
  {% endif %}

  # Redirect rules
  {% if frontend.redirects is defined and frontend.redirects %}
  {% for redirect in frontend.redirects %}
  redirect {{ redirect.rule }}
  {% endfor %}
  {% endif %}

{% endfor %}
{% else %}
# Default Frontend Configuration
frontend http
  bind {{ loadbalancing_haproxy_bind_addr | default('*') }}:{{ loadbalancing_haproxy_frontend_port | default(80) }}
  mode http
  option httplog
  default_backend backend_default
{% endif %}

#---------------------------------------------------------------------
# Backend Definitions
#---------------------------------------------------------------------
{% if loadbalancing_haproxy_backends is defined and loadbalancing_haproxy_backends | length > 0 %}
{% for backend in loadbalancing_haproxy_backends %}
backend {{ backend.name | default('backend-' + loop.index | string) }}
  mode http
  balance {{ backend.balance_method | default('roundrobin') }}

  {% if backend.session_persistence is defined and backend.session_persistence %}
  # Session persistence (sticky sessions)
  cookie {{ backend.persistence_name | default('SERVERID') }} insert indirect nocache
  {% endif %}

  # Health checks
  {% if backend.health_check is defined %}
  option httpchk {{ backend.health_check.method | default('GET') }} {{ backend.health_check.path | default('/health') }}
  http-check expect {{ backend.health_check.expect | default('status 200') }}
  {% else %}
  option httpchk GET /
  http-check expect status 200
  {% endif %}

  # Servers / Backend members
  {% if backend.servers is defined and backend.servers %}
  {% for server in backend.servers %}
  server {{ server.name | default('server-' + loop.index | string) }} {{ server.host }}:{{ server.port }} check inter {{ backend.check_interval | default(2000) }}ms fall {{ backend.fall_count | default(3) }} rise {{ backend.rise_count | default(2) }}
  {% endfor %}
  {% else %}
  # No servers configured for this backend
  server placeholder 127.0.0.1:8080 disabled
  {% endif %}

  {% if backend.options is defined and backend.options %}
  # Custom backend options
  {% for option in backend.options %}
  option {{ option }}
  {% endfor %}
  {% endif %}

{% endfor %}
{% else %}
# Default Backend Configuration
backend backend_default
  balance roundrobin
  server backend1 127.0.0.1:8080 check
{% endif %}

#---------------------------------------------------------------------
# Stats/Monitoring Configuration
#---------------------------------------------------------------------
{% if loadbalancing_haproxy_stats_enabled | default(true) %}
listen stats
  bind {{ loadbalancing_haproxy_bind_addr | default('127.0.0.1') }}:{{ loadbalancing_haproxy_stats_port | default(8404) }}
  mode http
  option httplog
  stats enable
  stats uri /stats
  stats refresh 30s
  stats show-legends
  stats show-node
  stats admin if TRUE
  option contstats
  timeout client 5m
  timeout server 5m
  timeout connect 5m
{% endif %}

#---------------------------------------------------------------------
# End of HAProxy Configuration
#---------------------------------------------------------------------
