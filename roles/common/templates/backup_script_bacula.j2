#!/bin/bash
# Bacula Backup Script
# Generated by Ansible - DO NOT EDIT MANUALLY
# Runs Bacula client backup operation

set -e

# Logging
LOG_FILE="/var/log/backup/bacula-backup.log"
TIMESTAMP=$(date +'%Y-%m-%d %H:%M:%S')

# Ensure log directory exists
mkdir -p "$(dirname "$LOG_FILE")"

# Function to log messages
log_message() {
    echo "[$TIMESTAMP] $1" >> "$LOG_FILE"
}

log_message "Starting Bacula backup..."

# Check if Bacula FD is running
if ! systemctl is-active --quiet bacula-fd; then
    log_message "ERROR: Bacula FD is not running"
    systemctl start bacula-fd
    sleep 5
fi

# Run backup (director will initiate actual backup)
log_message "Bacula FD is ready for backup"

# Wait for director to initiate backup
# In a real deployment, the director would connect and run the backup job
for i in {1..30}; do
    if netstat -tlnp 2>/dev/null | grep -q :{{ bacula_fd_port | default('9102') }}; then
        log_message "Bacula FD listening on port {{ bacula_fd_port | default('9102') }}"
        break
    fi
    sleep 1
done

# Check Bacula FD status
if systemctl is-active --quiet bacula-fd; then
    log_message "Bacula backup preparation completed successfully"
    exit 0
else
    log_message "ERROR: Bacula FD failed to start"
    exit 1
fi

