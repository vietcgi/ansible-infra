# AlertManager Configuration
# Auto-generated by Ansible - DO NOT EDIT MANUALLY
# Generated: {{ ansible_date_time.iso8601 }}

global:
  resolve_timeout: {{ monitoring_alertmanager_notification_timeout | default('10s') }}
  smtp_from: '{{ monitoring_alertmanager_email_from | default('alertmanager@localhost') }}'
  {% if monitoring_alertmanager_email_smarthost %}
  smtp_smarthost: '{{ monitoring_alertmanager_email_smarthost }}'
  {% endif %}

route:
  receiver: 'default'
  {% if monitoring_alertmanager_custom_routes | default([]) | length > 0 %}
  routes:
    {% for route in monitoring_alertmanager_custom_routes %}
    - match:
        {% for match_key, match_value in (route.match | default({})).items() %}
        {{ match_key }}: '{{ match_value }}'
        {% endfor %}
      receiver: '{{ route.receiver | default('default') }}'
      {% if route.continue is defined %}
      continue: {{ route.continue | lower }}
      {% endif %}
      {% if route.group_by is defined %}
      group_by: {{ route.group_by | to_nice_yaml | indent(8) }}
      {% endif %}
      {% if route.group_wait is defined %}
      group_wait: '{{ route.group_wait }}'
      {% endif %}
      {% if route.group_interval is defined %}
      group_interval: '{{ route.group_interval }}'
      {% endif %}
      {% if route.repeat_interval is defined %}
      repeat_interval: '{{ route.repeat_interval }}'
      {% endif %}
    {% endfor %}
  {% else %}
  group_by: ['alertname', 'cluster', 'service']
  group_wait: 10s
  group_interval: 10s
  repeat_interval: 12h
  {% endif %}

receivers:
  - name: 'default'
    # Default receiver - can be configured with webhook or other handlers

{% if monitoring_alertmanager_slack_webhook %}
  - name: 'slack_notifications'
    slack_configs:
      - api_url: '{{ monitoring_alertmanager_slack_webhook }}'
        channel: '{{ monitoring_alertmanager_slack_channel | default('#alerts') }}'
        title: '{{ monitoring_alertmanager_slack_title | default('Prometheus Alert') }}'
        text: '{{ monitoring_alertmanager_slack_text | default('{{ .CommonAnnotations.description }}') }}'
        send_resolved: {{ monitoring_alertmanager_slack_send_resolved | default('true') | lower }}
{% endif %}

{% if monitoring_alertmanager_email_to %}
  - name: 'email_notifications'
    email_configs:
      - to: '{{ monitoring_alertmanager_email_to }}'
        from: '{{ monitoring_alertmanager_email_from | default('alertmanager@localhost') }}'
        {% if monitoring_alertmanager_email_smarthost %}
        smarthost: '{{ monitoring_alertmanager_email_smarthost }}'
        {% endif %}
        {% if monitoring_alertmanager_email_auth_username %}
        auth_username: '{{ monitoring_alertmanager_email_auth_username }}'
        {% endif %}
        {% if monitoring_alertmanager_email_auth_password %}
        auth_password: '{{ monitoring_alertmanager_email_auth_password }}'
        {% endif %}
        headers:
          Subject: 'Alert: {{ .GroupLabels.alertname }}'
        html: true
{% endif %}

inhibit_rules: []
# Inhibition rules can be added here to suppress certain alerts
# Example:
# - source_match:
#     severity: 'critical'
#   target_match:
#     severity: 'warning'
#   equal: ['alertname', 'dev', 'instance']
