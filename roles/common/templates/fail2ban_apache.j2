# fail2ban Apache jail configuration
# Protects Apache web server from HTTP brute force and scanning attacks
# Generated by Ansible - DO NOT EDIT MANUALLY

[apache-auth]
enabled = {{ fail2ban_enable_apache | default(false) | lower }}
port = http,https
filter = apache-auth
logpath = %(apache_error_log)s

# Apache authentication failure settings
maxretry = {{ fail2ban_maxretry_apache | default(fail2ban_maxretry | default(5)) }}
findtime = {{ fail2ban_findtime_apache | default(fail2ban_findtime | default(600)) }}
bantime = {{ fail2ban_bantime_apache | default(fail2ban_bantime | default(3600)) }}

# Action to take on ban
{% if fail2ban_enable_email_notifications | default(true) %}
action = %(action_mwl)s
{% else %}
action = %(action_)s
{% endif %}

# Log file location (varies by OS)
logpath = /var/log/apache2/error.log
          /var/log/httpd/error_log

# Backend detection (pure or systemd)
backend = {{ fail2ban_apache_backend | default('auto') }}

# Ban configuration
destemail = {{ fail2ban_destemail | default('root') }}
sendername = {{ fail2ban_sendername | default('Fail2Ban') }}

# Timeout for connections
timeout = {{ fail2ban_apache_timeout | default(600) }}

# Chain for iptables rules
chain = INPUT

---

# Jail for Apache limit request
[apache-limit-req]
enabled = {{ fail2ban_enable_apache_limit | default(false) | lower }}
