# PAM Common-Auth Configuration with Faillock
# Generated by Ansible - DO NOT EDIT MANUALLY
# Implements account lockout via pam_faillock
# CIS Benchmark 5.3.2

# Account lockout - preauth (must come before pam_unix)
auth        required      pam_faillock.so preauth silent audit deny={{ pam_faillock_deny | default(5) }} unlock_time={{ pam_faillock_unlock_time | default(900) }}

# Standard Unix authentication
auth        [success=1 default=ignore]    pam_unix.so nullok

# Fallback if no module succeeds
auth        requisite     pam_deny.so

# Prime the stack with positive return
auth        required      pam_permit.so

# Account lockout - authfail (record failed attempts)
auth        [default=ignore]    pam_faillock.so authfail audit deny={{ pam_faillock_deny | default(5) }} unlock_time={{ pam_faillock_unlock_time | default(900) }}

# Account lockout - authsucc (reset on success)
auth        optional      pam_faillock.so authsucc audit deny={{ pam_faillock_deny | default(5) }} unlock_time={{ pam_faillock_unlock_time | default(900) }}

# Additional modules
auth        optional      pam_cap.so
