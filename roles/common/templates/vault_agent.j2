# Vault Agent Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY
# Manages Vault client authentication and secrets injection

vault {
  address = "{{ vault_address }}"
}

{% if vault_skip_verify %}
vault {
  skip_verify = true
}
{% endif %}

# Authentication method configuration
{% if vault_auth_method == "token" %}
# Token-based authentication
auto_auth {
  method {
    type = "approle"

    config = {
      role_id_file_path = "/etc/vault/role-id"
      secret_id_file_path = "/etc/vault/secret-id"
      remove_secret_id_file_after_reading = false
    }
  }

  sink {
    type = "file"
    config = {
      path = "/var/lib/vault/.vault-token"
      mode = 0600
      owner = "vault"
      group = "vault"
    }
  }
}

{% elif vault_auth_method == "approle" %}
# AppRole authentication
auto_auth {
  method {
    type = "approle"

    config = {
      role_id_file_path = "/etc/vault/role-id"
      secret_id_file_path = "/etc/vault/secret-id"
      remove_secret_id_file_after_reading = false
    }
  }

  sink {
    type = "file"
    config = {
      path = "/var/lib/vault/.vault-token"
      mode = 0600
      owner = "vault"
      group = "vault"
    }
  }
}

{% elif vault_auth_method == "jwt" %}
# JWT/OIDC authentication
auto_auth {
  method {
    type = "jwt"

    config = {
      role = "{{ vault_jwt_role | default('default') }}"
      path = "{{ vault_jwt_path | default('/run/secrets/kubernetes.io/serviceaccount/token') }}"
    }
  }

  sink {
    type = "file"
    config = {
      path = "/var/lib/vault/.vault-token"
      mode = 0600
      owner = "vault"
      group = "vault"
    }
  }
}

{% elif vault_auth_method == "kubernetes" %}
# Kubernetes authentication
auto_auth {
  method {
    type = "kubernetes"

    config = {
      role = "{{ vault_k8s_role | default('default') }}"
      jwt = "@/var/run/secrets/kubernetes.io/serviceaccount/token"
    }
  }

  sink {
    type = "file"
    config = {
      path = "/var/lib/vault/.vault-token"
      mode = 0600
      owner = "vault"
      group = "vault"
    }
  }
}

{% endif %}

# Cache configuration for improved performance
cache {
  use_auto_auth_token = true
  when_inconsistent = "retry"
  when_upstream_down = "use_cache"
}

# Listener for agent API
listener "unix" {
  address = "/var/lib/vault/agent.sock"
  tls_disable = true
}

{% if vault_enable_http_listener | default(false) %}
listener "tcp" {
  address = "{{ vault_http_listener_address | default('127.0.0.1:8200') }}"
  tls_disable = true

  agent_api {
    enable_quit = false
  }
}

{% endif %}

# TLS Configuration
{% if not vault_skip_verify and vault_ca_cert_path is defined %}
tls {
  ca_cert = "/etc/vault/tls/ca.crt"
}

{% if vault_client_cert_path is defined %}
tls {
  client_cert = "/etc/vault/tls/client.crt"
  client_key = "/etc/vault/tls/client.key"
}

{% endif %}
{% endif %}

# Logging configuration
log_level = "{{ vault_log_level | default('info') }}"
log_file = "/var/log/vault/agent.log"

# Secrets injection configuration
{% if vault_secrets_injection_enabled | default(false) %}
# Secrets injection settings
template_config {
  exit_on_retry_failure = true
  max_retries = 5
}

{% for secret in vault_secret_paths | default([]) %}
template {
  source = "/etc/vault/templates/{{ secret.name }}.tpl"
  destination = "{{ secret.destination }}"
  command = "{{ secret.command | default('') }}"
  error_on_missing_key = {{ secret.error_on_missing_key | default('false') | lower }}
  perms = "{{ secret.perms | default('0600') }}"
  owner = "{{ secret.owner | default('vault') }}"
  group = "{{ secret.group | default('vault') }}"
}

{% endfor %}
{% endif %}

# API configuration
api_proxy {
  use_auto_auth_token = true
  enforce_consistency = "always"
  when_inconsistent = "retry"
}

# Vault Agent Listener Settings
listener "unix" {
  address = "/var/run/vault/agent.sock"
  tls_disable = true

  agent_api {
    enable_quit = false
  }
}

# Process lifecycle
pid_file = "/var/run/vault/agent.pid"

