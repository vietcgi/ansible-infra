# Falco Configuration
# Runtime security monitoring for containers and systems

rules_file:
  - /etc/falco/rules.d
  - /etc/falco/rules.yaml
  - /etc/falco/rules.d/*.yaml

json_output: true
json_include_output_property: true

file_output:
  enabled: true
  keep_alive: false
  filename: /var/log/falco/falco.log

syslog_output:
  enabled: true

stdout_output:
  enabled: false

# Program output
program_output:
  enabled: false
  keep_alive: false
  program: "jq '{text: .output}' | curl -d @- -X POST https://events.pagerduty.com/v2/enqueue"

http_output:
  enabled: false
  url: "http://localhost:5000/"

output_timeout: 2000

# Logging and metrics
syscall_event_drops:
  threshold: .1
  actions:
    - log
    - alert

metadata_download:
  dir: /opt/falco/metadata
  download_max_mb: 100
  download_timeout: 6000000000
  use_cached: true

# Container support
container_engines:
  docker:
    enabled: true
  cri:
    enabled: true
  containerd:
    enabled: true
  crios:
    enabled: true

grpc:
  enabled: false
  bind_address: "0.0.0.0:5060"

grpcs:
  enabled: false
  bind_address: "0.0.0.0:5061"
  server_cert: /etc/falco/certs/server.crt
  server_key: /etc/falco/certs/server.key
  root_ca: /etc/falco/certs/ca.crt

webserver:
  enabled: true
  listen_port: 8765
  k8s_audit_endpoint: /k8s-audit
  ssl_enabled: false
  ssl_certificate: /etc/falco/falco.pem

# Watch file locations
watch_config_files: true
watch_rules: true

# Performance
engine:
  kind: modern_ebpf
  ebpf:
    enabled: true
    probe: /root/.falco/falco-bpf.o
  kmod:
    enabled: false
  gvisor:
    enabled: false
    root: /gvisor

# Buffering
syscall_buf_size_preset: 4
libscap_logging:
  enabled: false
  severity: debug

base_syscalls:
  custom_set: []
  repair: true
