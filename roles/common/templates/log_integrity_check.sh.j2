#!/bin/bash
# Log Integrity Check Script
# Detects tampering or unauthorized modifications to log files
# Generated by Ansible

set -euo pipefail

# Configuration
LOG_DIR="/var/log"
HASH_DIR="/var/log/hashes"
REPORT_DIR="/var/log/integrity-reports"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
HASH_ALGORITHM="sha256sum"

# Create necessary directories
mkdir -p "${HASH_DIR}" "${REPORT_DIR}"
chmod 700 "${HASH_DIR}" "${REPORT_DIR}"

# Files to monitor
MONITORED_LOGS=(
  "/var/log/auth.log"
  "/var/log/syslog"
  "/var/log/kern.log"
  "/var/log/audit/audit.log"
  "/var/log/secure"
  "/var/log/authpriv.log"
  "/var/log/messages"
  "/var/log/encrypted/auth.log"
  "/var/log/encrypted/authpriv.log"
{% if logging_monitored_logs is defined %}
{% for log_file in logging_monitored_logs %}
  "{{ log_file }}"
{% endfor %}
{% endif %}
)

# Initialize report
REPORT="${REPORT_DIR}/integrity-check-${TIMESTAMP}.log"
touch "${REPORT}"
chmod 600 "${REPORT}"

{
  echo "==================================================="
  echo "Log Integrity Check Report"
  echo "==================================================="
  echo "Generated: $(date)"
  echo "System: $(hostname)"
  echo ""

  VIOLATIONS=0
  CHECKED=0
  MISSING=0

  for log_file in "${MONITORED_LOGS[@]}"; do
    CHECKED=$((CHECKED + 1))

    if [[ ! -f "$log_file" ]]; then
      MISSING=$((MISSING + 1))
      echo "[MISSING] $log_file - File does not exist"
      continue
    fi

    # Generate current hash
    CURRENT_HASH=$(${HASH_ALGORITHM} "$log_file" | awk '{print $1}')
    HASH_FILE="${HASH_DIR}/$(basename "$log_file").hash"

    # Check if hash file exists
    if [[ ! -f "$HASH_FILE" ]]; then
      echo "[NEW] $log_file - Hash file created"
      echo "$CURRENT_HASH" > "$HASH_FILE"
      chmod 600 "$HASH_FILE"
      continue
    fi

    # Compare hashes
    PREVIOUS_HASH=$(cat "$HASH_FILE")

    if [[ "$CURRENT_HASH" != "$PREVIOUS_HASH" ]]; then
      VIOLATIONS=$((VIOLATIONS + 1))
      echo "[ALERT] INTEGRITY VIOLATION: $log_file"
      echo "  Previous Hash: $PREVIOUS_HASH"
      echo "  Current Hash:  $CURRENT_HASH"
      echo "  File Size: $(stat -f%z "$log_file" 2>/dev/null || stat -c%s "$log_file")"
      echo "  Last Modified: $(stat -f "%Sm -d '%F %T'" "$log_file" 2>/dev/null || stat -c %y "$log_file")"

      {% if logging_integrity_alert_email is defined %}
      # Send alert email
      echo "Log file tampering detected: $log_file" | \
        mail -s "SECURITY ALERT: Log tampering detected on $(hostname)" \
          "{{ logging_integrity_alert_email }}"
      {% endif %}
    else
      echo "[OK] $log_file - Integrity verified"
    fi

    # Update hash for next check
    echo "$CURRENT_HASH" > "$HASH_FILE"
    chmod 600 "$HASH_FILE"
  done

  echo ""
  echo "==================================================="
  echo "Summary"
  echo "==================================================="
  echo "Files Checked: $CHECKED"
  echo "Files Missing: $MISSING"
  echo "Integrity Violations: $VIOLATIONS"
  echo ""

  # Alert if violations found
  if [[ $VIOLATIONS -gt 0 ]]; then
    echo "⚠️  WARNING: Log integrity violations detected!"
    exit 1
  else
    echo "✓ All logs verified - no tampering detected"
    exit 0
  fi

} | tee -a "${REPORT}"

# Compress old reports (older than 30 days)
find "${REPORT_DIR}" -name "integrity-check-*.log" -type f -mtime +30 -delete

# Cleanup old hash files if logs were deleted
for hash_file in "${HASH_DIR}"/*.hash; do
  log_base=$(basename "$hash_file" .hash)
  # Check in both possible locations
  found=0
  for log_file in "${MONITORED_LOGS[@]}"; do
    if [[ "$(basename "$log_file")" == "$log_base" ]]; then
      found=1
      break
    fi
  done

  if [[ $found -eq 0 ]]; then
    rm -f "$hash_file"
  fi
done
