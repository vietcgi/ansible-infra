# {{ ansible_managed }}
# Log Rotation Configuration - ansible-infra

/var/log/ansible-infra/*.log {
  daily
  rotate {{ common_log_retention_days }}
  missingok
  notifempty
  compress
  delaycompress
  copytruncate
  sharedscripts
  postrotate
    /bin/systemctl reload rsyslog > /dev/null 2>&1 || true
  endscript
}
