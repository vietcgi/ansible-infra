# rsyslog forwarding configuration
# Forwards all syslog messages to remote Elasticsearch/Logstash
# Generated by Ansible - DO NOT EDIT MANUALLY

# Enable network input (if needed for receiving from other hosts)
{% if log_shipping_rsyslog_accept_remote | default(false) %}
$ModLoad imtcp
$InputTCPServerRun 514
{% endif %}

# Load required modules
$ModLoad omfwd
$ModLoad omelasticsearch
$ModLoad imfile
$ModLoad imjournal

# Elasticsearch output module (if using omelasticsearch module)
{% if log_shipping_use_elasticsearch_module | default(false) %}
# Direct Elasticsearch output (requires rsyslog-elasticsearch package)
template(name="es-json" type="list") {
  property(name="timereported" dateFormat="rfc3339")
  property(name="hostname")
  property(name="syslogtag")
  property(name="msg")
}

action(
  type="omelasticsearch"
  server="{{ log_shipping_elasticsearch_host }}"
  serverport="{{ log_shipping_elasticsearch_port }}"
  uid="{{ log_shipping_elasticsearch_user | default('') }}"
  pwd="{{ log_shipping_elasticsearch_password | default('') }}"
  searchIndex="rsyslog-%$YEAR%-%$MONTH%-%$DAY%"
  searchType="{{ log_shipping_elasticsearch_type | default('_doc') }}"
  template="es-json"
  dynSearchIndex="on"
  bulkmode="on"
  maxbytes="100m"
)
{% else %}
# TCP/Syslog forwarding (to Logstash or remote syslog)
action(
  type="omfwd"
  target="{{ log_shipping_logstash_host | default(log_shipping_elasticsearch_host) }}"
  port="{{ log_shipping_logstash_port | default(log_shipping_elasticsearch_port) }}"
  protocol="{{ log_shipping_rsyslog_protocol | default('tcp') }}"
  action.resumeRetryCount="-1"
  queue.type="linkedList"
  queue.fileName="fwdRule1"
  queue.maxDiskSpace="1g"
  queue.saveOnShutdown="on"
  action.resumeInterval="10"
)

# Also send to local file (optional backup)
{% if log_shipping_rsyslog_local_backup | default(true) %}
action(
  type="omfile"
  file="/var/log/rsyslog-forward.log"
  template="RSYSLOG_FileFormat"
)
{% endif %}
{% endif %}

# Collect system logs
{% if log_shipping_collect_kernel | default(true) %}
:programname, isequal, "kernel" @@(z){{ log_shipping_logstash_host | default(log_shipping_elasticsearch_host) }}:{{ log_shipping_logstash_port | default(log_shipping_elasticsearch_port) }}
{% endif %}

# Collect authentication logs
{% if log_shipping_collect_auth | default(true) %}
:programname, isequal, "sshd" @@(z){{ log_shipping_logstash_host | default(log_shipping_elasticsearch_host) }}:{{ log_shipping_logstash_port | default(log_shipping_elasticsearch_port) }}
:programname, isequal, "sudo" @@(z){{ log_shipping_logstash_host | default(log_shipping_elasticsearch_host) }}:{{ log_shipping_logstash_port | default(log_shipping_elasticsearch_port) }}
auth.* @@(z){{ log_shipping_logstash_host | default(log_shipping_elasticsearch_host) }}:{{ log_shipping_logstash_port | default(log_shipping_elasticsearch_port) }}
authpriv.* @@(z){{ log_shipping_logstash_host | default(log_shipping_elasticsearch_host) }}:{{ log_shipping_logstash_port | default(log_shipping_elasticsearch_port) }}
{% endif %}

# Collect fail2ban logs
{% if log_shipping_collect_fail2ban | default(true) %}
:programname, isequal, "fail2ban" @@(z){{ log_shipping_logstash_host | default(log_shipping_elasticsearch_host) }}:{{ log_shipping_logstash_port | default(log_shipping_elasticsearch_port) }}
{% endif %}

# Collect audit logs
{% if log_shipping_collect_audit | default(true) %}
:programname, isequal, "audisp" @@(z){{ log_shipping_logstash_host | default(log_shipping_elasticsearch_host) }}:{{ log_shipping_logstash_port | default(log_shipping_elasticsearch_port) }}
:programname, isequal, "auditd" @@(z){{ log_shipping_logstash_host | default(log_shipping_elasticsearch_host) }}:{{ log_shipping_logstash_port | default(log_shipping_elasticsearch_port) }}
{% endif %}

# Collect cron logs
{% if log_shipping_collect_cron | default(false) %}
cron.* @@(z){{ log_shipping_logstash_host | default(log_shipping_elasticsearch_host) }}:{{ log_shipping_logstash_port | default(log_shipping_elasticsearch_port) }}
{% endif %}

# Collect mail logs
{% if log_shipping_collect_mail | default(false) %}
mail.* @@(z){{ log_shipping_logstash_host | default(log_shipping_elasticsearch_host) }}:{{ log_shipping_logstash_port | default(log_shipping_elasticsearch_port) }}
{% endif %}

# Collect daemon logs
{% if log_shipping_collect_daemon | default(false) %}
daemon.* @@(z){{ log_shipping_logstash_host | default(log_shipping_elasticsearch_host) }}:{{ log_shipping_logstash_port | default(log_shipping_elasticsearch_port) }}
{% endif %}

# Default: forward all logs
{% if log_shipping_rsyslog_forward_all | default(false) %}
*.* @@(z){{ log_shipping_logstash_host | default(log_shipping_elasticsearch_host) }}:{{ log_shipping_logstash_port | default(log_shipping_elasticsearch_port) }}
{% endif %}

# Journald input (systemd logs)
{% if log_shipping_collect_journal | default(true) %}
$ModLoad imjournal
$IMJournalStateFile imjournal.state
$WorkDirectory /var/lib/rsyslog
input(type="imjournal"
      StateFile="/var/lib/rsyslog/imjournal.state"
      Facility="{{ log_shipping_journal_facility | default('local0') }}"
      Priority="{{ log_shipping_journal_priority | default('info') }}"
      Tag="journal")
{% endif %}

# Custom log file monitoring (if defined)
{% if log_shipping_custom_logs is defined %}
{% for log_file in log_shipping_custom_logs %}
input(type="imfile"
      File="{{ log_file.path }}"
      Tag="{{ log_file.tag | default('custom') }}"
      Facility="{{ log_file.facility | default('local3') }}"
      Severity="{{ log_file.severity | default('info') }}")

# Forward custom logs
:programname, isequal, "{{ log_file.tag | default('custom') }}" @@(z){{ log_shipping_logstash_host | default(log_shipping_elasticsearch_host) }}:{{ log_shipping_logstash_port | default(log_shipping_elasticsearch_port) }}
{% endfor %}
{% endif %}

# Performance tuning
$ActionQueueType LinkedList
$ActionQueueFileName queue
$ActionResumeRetryCount -1
$ActionQueueSaveOnShutdown on
$ActionQueueMaxDiskSpace 1g

# Connection timeout
$ActionSendTCPRebindInterval 100
$ActionSendTCPRebindIntervalWithError 300
$ActionSendTCPKeepAlive on

# Filtering rules (drop noisy logs if needed)
{% if log_shipping_filter_noisy_logs | default(true) %}
# Ignore empty messages
:msg, regex, "^$" ~

# Ignore common harmless messages
:programname, isequal, "systemd" ^
:msg, contains, "systemd\[" ^

# Stop processing for filtered messages
{% endif %}

# Local file backup (retain logs locally for debugging)
{% if log_shipping_local_retention | default(true) %}
$ModLoad imudp
$UDPServerRun 514
*.* /var/log/syslog-central.log
{% endif %}

# EOF
