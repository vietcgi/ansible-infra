#!/bin/bash
# {{ ansible_managed }}
# Backup Verification Script
# Tests backup integrity and restore functionality

set -euo pipefail

BACKUP_DIR="{{ backup_source_dir | default('/var/backup') }}"
TEST_DIR="/var/backup/test"
LOG_FILE="/var/log/backup-test.log"
TIMESTAMP=$(date '+%Y%m%d_%H%M%S')

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

cleanup() {
    rm -rf "${TEST_DIR:?}/"* 2>/dev/null || true
}

trap cleanup EXIT

log "=========================================="
log "Backup Verification Started"
log "Host: $(hostname -f)"
log "=========================================="

ERRORS=0

# Find latest backup
LATEST_BACKUP=$(find "$BACKUP_DIR" -name "*.tar.gz" -o -name "*.tgz" 2>/dev/null | sort -r | head -1)

if [ -z "$LATEST_BACKUP" ]; then
    log "ERROR: No backup files found in $BACKUP_DIR"
    exit 1
fi

log "Testing backup: $LATEST_BACKUP"

# Check file exists and is readable
if [ ! -r "$LATEST_BACKUP" ]; then
    log "ERROR: Cannot read backup file"
    exit 1
fi

# Check file size
BACKUP_SIZE=$(stat -c%s "$LATEST_BACKUP" 2>/dev/null || echo "0")
if [ "$BACKUP_SIZE" -lt 1024 ]; then
    log "WARNING: Backup file seems too small: $BACKUP_SIZE bytes"
    ((ERRORS++))
fi

log "Backup size: $BACKUP_SIZE bytes"

# Test archive integrity
log "Verifying archive integrity..."
if tar -tzf "$LATEST_BACKUP" > /dev/null 2>&1; then
    log "PASS: Archive integrity verified"
else
    log "FAIL: Archive integrity check failed"
    ((ERRORS++))
fi

# Test extraction
log "Testing extraction to $TEST_DIR..."
mkdir -p "$TEST_DIR"
if tar -xzf "$LATEST_BACKUP" -C "$TEST_DIR" 2>/dev/null; then
    FILE_COUNT=$(find "$TEST_DIR" -type f | wc -l)
    log "PASS: Extracted $FILE_COUNT files successfully"
else
    log "FAIL: Extraction failed"
    ((ERRORS++))
fi

# Summary
log ""
log "=========================================="
if [ "$ERRORS" -eq 0 ]; then
    log "RESULT: Backup verification PASSED"
else
    log "RESULT: Backup verification FAILED ($ERRORS errors)"
fi
log "=========================================="

exit $ERRORS
