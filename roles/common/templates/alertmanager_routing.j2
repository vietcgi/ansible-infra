# AlertManager Custom Routing Rules
# Auto-generated by Ansible - DO NOT EDIT MANUALLY
# Generated: {{ ansible_date_time.iso8601 }}

# Custom alert routing configuration
# This file defines how alerts are routed to different receivers

routes:
{% for route in monitoring_alertmanager_custom_routes | default([]) %}
  # Route: {{ route.name | default('custom-route-' + loop.index | string) }}
  - receiver: '{{ route.receiver | default('default') }}'
    group_by: {{ route.group_by | default(['alertname', 'instance']) | to_nice_yaml | indent(6) }}
    group_wait: '{{ route.group_wait | default('10s') }}'
    group_interval: '{{ route.group_interval | default('10s') }}'
    repeat_interval: '{{ route.repeat_interval | default('4h') }}'
    {% if route.match is defined %}
    match:
      {% for match_key, match_value in route.match.items() %}
      {{ match_key }}: '{{ match_value }}'
      {% endfor %}
    {% endif %}
    {% if route.match_re is defined %}
    match_re:
      {% for match_key, match_value in route.match_re.items() %}
      {{ match_key }}: '{{ match_value }}'
      {% endfor %}
    {% endif %}
    {% if route.continue is defined %}
    continue: {{ route.continue | lower }}
    {% endif %}

{% endfor %}

