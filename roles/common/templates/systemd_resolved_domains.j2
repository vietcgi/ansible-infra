# systemd-resolved domain configuration
# Generated by Ansible Common Role
# https://man.archlinux.org/man/resolved.conf.5

[Resolve]
# Domain name for FQDN resolution
Domains={{ common_domain }}
FallbackDomains=local localhost

# DNS servers for domain
{% if common_dns_servers is defined and common_dns_servers | length > 0 %}
DNS={{ common_dns_servers | join(' ') }}
{% else %}
DNS=1.1.1.1 8.8.8.8
{% endif %}

# DNSSEC configuration
DNSSEC=yes
DNSSECNegativeTrustAnchors=local

# DNS over TLS
DNS over TLS=no

# LLMNR (Link-Local Multicast Name Resolution)
LLMNR=yes

# mDNS (Multicast DNS)
MulticastDNS=yes

# Cache configuration
Cache=yes
CacheFromLocalhost=no
