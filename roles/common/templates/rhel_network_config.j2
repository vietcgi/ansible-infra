# RHEL/CentOS network configuration
# Generated by Ansible - manage via network_static_ips variable
# Location: /etc/sysconfig/network-scripts/ifcfg-{{ item.interface }}

TYPE=Ethernet
BOOTPROTO=none
ONBOOT=yes
DEVICE={{ item.interface }}
IPADDR={{ item.address }}
PREFIX={{ item.netmask | default(24) }}
{% if item.gateway is defined %}
GATEWAY={{ item.gateway }}
{% endif %}
{% if item.dns is defined %}
{% for dns_ip in item.dns %}
DNS{{ loop.index }}={{ dns_ip }}
{% endfor %}
{% endif %}
NM_CONTROLLED=no
USERCTL=no
