# {{ ansible_managed }}
# SSH Server Configuration - ansible-infra
# Hardened for security and compliance

# Network
Port {{ common_ssh_port }}
AddressFamily any
ListenAddress 0.0.0.0
ListenAddress ::

# Protocol & Crypto
Protocol 2
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ed25519_key

# SSH Key Exchange & Encryption
# Post-quantum hybrid: sntrup761x25519 + modern elliptic curves + DH fallback
KexAlgorithms sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256

# Host-based authentication
HostbasedAuthentication no
PubkeyAuthentication yes
PermitRootLogin {{ common_ssh_permit_root_login | default('no') }}
StrictModes yes

# Password-based authentication
PasswordAuthentication {{ common_ssh_password_authentication | default('no') }}
PermitEmptyPasswords no
ChallengeResponseAuthentication no

# General authentication
MaxAuthTries 3
MaxSessions 10
{% if common_ssh_password_authentication | default('no') != 'yes' %}
# Key-only: Restrict to publickey authentication
AuthenticationMethods publickey
{% endif %}
# When PasswordAuthentication=yes, omit AuthenticationMethods to allow either key or password

# Session management
UsePAM yes
X11Forwarding no
PrintMotd no
AcceptEnv LANG LC_*
Subsystem sftp /usr/lib/openssh/sftp-server

# Security settings
{% if common_ssh_allow_users is defined and common_ssh_allow_users | length > 0 %}
AllowUsers {{ common_ssh_allow_users | join(' ') }}
{% endif %}
{% if common_ssh_deny_users is defined and common_ssh_deny_users | length > 0 %}
DenyUsers {{ common_ssh_deny_users | join(' ') }}
{% elif common_ssh_permit_root_login | default('no') != 'yes' %}
# Only deny root if PermitRootLogin is not explicitly enabled
DenyUsers root
{% endif %}
{% if common_ssh_allow_groups is defined and common_ssh_allow_groups | length > 0 %}
AllowGroups {{ common_ssh_allow_groups | join(' ') }}
{% endif %}
IgnoreRhosts yes
IgnoreUserKnownHosts yes
PermitUserEnvironment no
ClientAliveInterval 300
ClientAliveCountMax 3
Compression no
UseDNS no
TCPKeepAlive yes
MaxStartups {{ common_ssh_max_startups | default('100:30:300') }}
