---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ app_name }}-rolebinding
  namespace: {{ deployment_namespace | default('default') }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: {{ app_name }}-role
subjects:
- kind: ServiceAccount
  name: {{ app_name }}
  namespace: {{ deployment_namespace | default('default') }}
