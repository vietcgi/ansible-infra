# fail2ban Postfix jail configuration
# Protects mail server from authentication brute force attacks
# Generated by Ansible - DO NOT EDIT MANUALLY

[postfix]
enabled = {{ fail2ban_enable_postfix | default(false) | lower }}
port = smtp,ssmtp,submission
filter = postfix
logpath = %(postfix_log)s

# Postfix-specific settings
maxretry = {{ fail2ban_maxretry_postfix | default(fail2ban_maxretry | default(5)) }}
findtime = {{ fail2ban_findtime_postfix | default(fail2ban_findtime | default(600)) }}
bantime = {{ fail2ban_bantime_postfix | default(fail2ban_bantime | default(3600)) }}

# Action to take on ban
{% if fail2ban_enable_email_notifications | default(true) %}
action = %(action_mwl)s
{% else %}
action = %(action_)s
{% endif %}

# Log file location (varies by OS)
logpath = /var/log/mail.log
          /var/log/maillog

# Backend detection (pure or systemd)
backend = {{ fail2ban_postfix_backend | default('auto') }}

# Ban configuration
destemail = {{ fail2ban_destemail | default('root') }}
sendername = {{ fail2ban_sendername | default('Fail2Ban') }}

# Increase sensitivity for mail server attacks
ignorecommand =
ignoreregex =

# Connection/protocol issues to monitor
# - SASL authentication failures
# - DKIM verification issues
# - RBL/DNSBL rejections (optional)
logpath = /var/log/mail.log
          /var/log/maillog
          /var/log/syslog

# Custom filter for Postfix-specific patterns
filter = postfix

# Timeout for connections
timeout = {{ fail2ban_postfix_timeout | default(600) }}

# Chain for iptables rules
chain = INPUT
