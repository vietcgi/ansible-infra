# fail2ban email action configuration
# Sends email notifications when an IP is banned
# Generated by Ansible - DO NOT EDIT MANUALLY

[Definition]
actionname = sendmail-whois
actiondesc = Bans IP address using sendmail and includes whois information
actionstop =

# Main action: block the IP and send email
action = systemctl -q is-active ufw && ufw insert 1 deny from <ip>
       ; systemctl -q is-active firewalld && firewall-cmd --permanent --add-rich-rule='rule family="ipv4" source address="<ip>" drop'
       ; {% if fail2ban_enable_email_notifications | default(true) %}sendmail -t{% endif %}

# Alternative action using iptables directly
actionban = iptables -I fail2ban-<name> 1 -s <ip> -j REJECT --reject-with icmp-port-unreachable
          ; {% if fail2ban_enable_email_notifications | default(true) %}sendmail -t{% endif %}

# Unban action
actionunban = iptables -D fail2ban-<name> -s <ip> -j REJECT --reject-with icmp-port-unreachable

# Email notification content
subject = fail2ban: [<name>] IP banned <ip>
charset = UTF-8

# Format the email message with detailed ban information
# Includes: jail name, banned IP, failure count, and system information
to = {{ fail2ban_destemail | default('root') }}
from = {{ fail2ban_sendername | default('Fail2Ban') }} <fail2ban@{{ ansible_fqdn }}>

# Email body with whois information
message = fail2ban Notification

Hi,

The IP address "<ip>" has been banned because it has
exceeded the maximum number of login attempts.

Details:
========
Jail: <name>
IP Address: <ip>
Failures: <failures>
Ban Time: <bantime> seconds
Server: {{ ansible_hostname }}
Date: {{ '{{' }} now() {{ '}}' }}

Whois Information:
==================
<whois>

If this IP address is legitimate, you may manually
unban it with the following command:

fail2ban-client set <name> unbanip <ip>

For more information about fail2ban, please visit:
https://www.fail2ban.org

Regards,
fail2ban



# Advanced email configuration for sendmail
# These options control how emails are sent

# SMTP settings (if using relay server)
mta = sendmail

# Enable whois lookups (disabled by default for performance)
{% if fail2ban_enable_whois | default(false) %}
whois = /usr/bin/whois
{% endif %}

# Log email sending actions
logfile = /var/log/fail2ban.log

# Store banned IPs for tracking
dbfile = /var/lib/fail2ban/fail2ban.sqlite3



# Alternative action: send email with IP info only (faster)
[Definition-lite]
actionname = sendmail-lite
actiondesc = Bans IP and sends lightweight email notification
action = iptables -I fail2ban-<name> 1 -s <ip> -j REJECT
       ; sendmail -t

subject = Banned: <ip> on <name> jail
to = {{ fail2ban_destemail | default('root') }}
from = fail2ban@{{ ansible_fqdn }}

message = IP <ip> banned on {{ ansible_hostname }} in <name> jail.
          Failures: <failures> | Ban time: <bantime>s | Date: <date>



# Alternative: Slack webhook integration (optional)
# Uncomment and configure if using Slack notifications
{% if fail2ban_slack_webhook_url is defined %}
[Definition-slack]
actionname = slack-notification
actiondesc = Sends fail2ban notifications to Slack
action = curl -X POST -H 'Content-type: application/json'
         --data '{"text":"fail2ban alert: IP <ip> banned from <name> jail"}'
         {{ fail2ban_slack_webhook_url }}
{% endif %}
