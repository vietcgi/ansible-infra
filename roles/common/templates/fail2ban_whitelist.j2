# fail2ban whitelist configuration
# Prevents false positives by ignoring trusted IPs
# Generated by Ansible - DO NOT EDIT MANUALLY

[DEFAULT]
# Global whitelist applies to all jails
# Add trusted IPs here - they will never be banned
ignoreips = 127.0.0.1/8
            ::1/128
{% if fail2ban_ignoreips is defined and fail2ban_ignoreips %}
{% for ip in fail2ban_ignoreips %}
            {{ ip }}
{% endfor %}
{% endif %}
{% if fail2ban_ssh_whitelist_ips is defined and fail2ban_ssh_whitelist_ips %}
# SSH administrative IPs
{% for ip in fail2ban_ssh_whitelist_ips %}
            {{ ip }}
{% endfor %}
{% endif %}
{% if fail2ban_internal_network_ips is defined and fail2ban_internal_network_ips %}
# Internal network IPs
{% for ip in fail2ban_internal_network_ips %}
            {{ ip }}
{% endfor %}
{% endif %}
{% if fail2ban_monitoring_ips is defined and fail2ban_monitoring_ips %}
# Monitoring/automation IPs
{% for ip in fail2ban_monitoring_ips %}
            {{ ip }}
{% endfor %}
{% endif %}

# Ignore self (recommended)
ignoreself = true

# Whitelist format examples:
#   Single IP:     192.0.2.1
#   /32 network:   192.0.2.1/32
#   /24 network:   192.0.2.0/24
#   /16 network:   192.0.0.0/16
#   IPv6 single:   2001:db8::1
#   IPv6 /64:      2001:db8::/64

# Runtime whitelist commands:
#   Add:    fail2ban-client set <jail> addignoreip <ip>
#   Remove: fail2ban-client set <jail> delignoreip <ip>
#   View:   fail2ban-client get <jail> ignoreips
