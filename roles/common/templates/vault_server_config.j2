# Vault Server Configuration
# Generated by Ansible - {{ ansible_date_time.iso8601 }}

storage "{{ security_vault_storage_backend | default('file') }}" {
  path = "{{ security_vault_storage_path | default('/var/lib/vault') }}"
}

listener "tcp" {
  address = "{{ security_vault_bind_addr | default('127.0.0.1') }}:{{ security_vault_http_port | default(8200) }}"
  tls_disable = {{ 'true' if not (security_vault_tls_enabled | default(false)) else 'false' }}
{% if security_vault_tls_enabled | default(false) %}
  tls_cert_file = "{{ security_vault_tls_cert_file }}"
  tls_key_file = "{{ security_vault_tls_key_file }}"
  tls_min_version = "{{ security_vault_tls_min_version | default('tls12') }}"
{% endif %}
}

api_addr = "http{{ 's' if security_vault_tls_enabled | default(false) else '' }}://{{ security_vault_advertise_addr | default(ansible_default_ipv4.address) }}:{{ security_vault_http_port | default(8200) }}"
cluster_addr = "http{{ 's' if security_vault_tls_enabled | default(false) else '' }}://{{ security_vault_advertise_addr | default(ansible_default_ipv4.address) }}:{{ security_vault_cluster_port | default(8201) }}"
cluster_name = "{{ security_vault_cluster_name | default('vault-cluster') }}"

ui = {{ security_vault_ui_enabled | default(false) | lower }}

log_level = "{{ security_vault_log_level | default('info') }}"
log_format = "json"

disable_mlock = {{ 'true' if security_vault_disable_mlock | default(false) else 'false' }}

{% if security_vault_auto_unseal_enabled | default(false) %}
# Auto-unseal configuration
seal "{{ security_vault_seal_type | default('awskms') }}" {
  region = "{{ security_vault_auto_unseal_region | default('us-east-1') }}"
  kms_key_id = "{{ security_vault_auto_unseal_key_id }}"
}
{% endif %}

{% if security_vault_ha_enabled | default(false) %}
# High Availability configuration
ha_storage "{{ security_vault_ha_storage_backend | default('consul') }}" {
  ha_enabled = true
{% if security_vault_ha_storage_backend | default('consul') == 'consul' %}
  address = "{{ security_vault_consul_address | default('127.0.0.1:8500') }}"
  path = "{{ security_vault_ha_storage_path | default('vault/') }}"
{% endif %}
}
{% endif %}

# Vault Enterprise features (if applicable)
{% if security_vault_enterprise_license | default('') %}
license = "{{ security_vault_enterprise_license }}"
{% endif %}
