# Netplan static IP configuration
# Generated by Ansible - manage via network_static_ips variable
# Apply with: netplan apply

network:
  version: 2
  renderer: networkd

  ethernets:
{% for ip_config in network_static_ips %}
    {{ ip_config.interface }}:
      dhcp4: false
      dhcp6: false
      addresses:
        - {{ ip_config.address }}/{{ ip_config.netmask | default(24) }}
{% if ip_config.gateway is defined %}
      gateway4: {{ ip_config.gateway }}
{% endif %}
{% if ip_config.dns is defined %}
      nameservers:
        addresses:
          {% for dns in ip_config.dns %}
          - {{ dns }}
          {% endfor %}
{% endif %}
{% if ip_config.routes is defined %}
      routes:
        {% for route in ip_config.routes %}
        - to: {{ route.to }}
          via: {{ route.via }}
        {% endfor %}
{% endif %}
{% if ip_config.optional | default(false) %}
      optional: true
{% endif %}

{% endfor %}
