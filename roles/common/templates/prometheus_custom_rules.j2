# Prometheus Custom Alert Rules
# Auto-generated by Ansible - DO NOT EDIT MANUALLY
# Generated: {{ ansible_date_time.iso8601 }}

groups:
  - name: custom_alerts
    interval: {{ monitoring_prometheus_evaluation_interval | default('15s') }}
    rules:
{% for rule in monitoring_prometheus_custom_rules | default([]) %}
      # Rule: {{ rule.alert | default('custom-alert-' + loop.index | string) }}
      - alert: {{ rule.alert | default('CustomAlert' + (loop.index | string)) }}
        expr: |
          {{ rule.expr | default('up{job="custom"}') }}
        for: {{ rule.for | default('5m') }}
        labels:
          {% for label_key, label_value in (rule.labels | default({})).items() %}
          {{ label_key }}: '{{ label_value }}'
          {% endfor %}
        annotations:
          {% for annotation_key, annotation_value in (rule.annotations | default({})).items() %}
          {{ annotation_key }}: '{{ annotation_value }}'
          {% endfor %}

{% endfor %}

