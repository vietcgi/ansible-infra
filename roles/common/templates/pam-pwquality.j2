# Minimum password length
minlen=14

# Require digits
dcredit=-1

# Require uppercase
ucredit=-1

# Require lowercase
lcredit=-1

# Require special characters
ocredit=-1

# Reject passwords with more than 3 repeated characters
maxrepeat=3

# Reject passwords with more than 3 identical consecutive characters
maxsequence=3

# Require difference from old password
