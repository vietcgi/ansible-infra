version: '3.8'
# Docker Compose defaults
# Auto-generated by Ansible - DO NOT EDIT MANUALLY
# Generated: {{ ansible_date_time.iso8601 }}

services:
  # Service templates for common patterns
  {% for service_name, service_config in container_docker_compose_defaults.items() %}
  {{ service_name }}:
    image: {{ service_config.image | default('') }}
    {% if service_config.ports %}
    ports:
      {% for port in service_config.ports %}
      - "{{ port }}"
      {% endfor %}
    {% endif %}
    {% if service_config.environment %}
    environment:
      {% for env_var, value in service_config.environment.items() %}
      - {{ env_var }}={{ value }}
      {% endfor %}
    {% endif %}
    networks:
      - default
  {% endfor %}

networks:
  default:
    driver: bridge
