---
# Headplane Configuration
# Managed by Ansible - DO NOT EDIT MANUALLY

server:
  host: "0.0.0.0"
  port: 3000
{% if headplane_cookie_secret | length > 0 %}
  cookie_secret: "{{ headplane_cookie_secret }}"
{% endif %}

headscale:
  url: "http://{{ headscale_container_name }}:8080"
  config_path: "/etc/headscale/config.yaml"
{% if headscale_policy_mode == 'file' %}
  acl_path: "/etc/headscale/acl.json"
{% endif %}

integration:
  docker:
    enabled: true
    socket: "/var/run/docker.sock"
    container_label: "me.tale.headplane.target"

{% if headplane_agent_enabled | bool %}
agent:
  enabled: true
  authkey: "{{ headplane_agent_authkey }}"
{% endif %}
