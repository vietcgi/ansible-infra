# Wireguard Configuration
# Generated by Ansible - Do not edit manually
# Interface: {{ wireguard_interface }}
# Topology: {{ wireguard_topology }}
# Generated: {{ ansible_date_time.iso8601 }}

[Interface]
# Local private key
PrivateKey = {{ wireguard_private_key }}

# Listen port
ListenPort = {{ wireguard_port }}

# Interface address
{% if wireguard_topology == 'full_mesh' %}
Address = {{ wireguard_full_mesh_nodes[inventory_hostname].vpn_ip }}/32
{% elif wireguard_topology == 'hub_spoke' %}
{% if wireguard_node_role == 'hub' %}
Address = {{ wireguard_hub_vpn_ip }}/24
{% else %}
Address = {{ wireguard_spoke_nodes[inventory_hostname].vpn_ip }}/32
{% endif %}
{% elif wireguard_topology == 'site_to_site' %}
{% set current_site = wireguard_sites | dict2items | selectattr('value.gateway', 'equalto', inventory_hostname) | first %}
{% if current_site %}
Address = {{ current_site.value.vpn_network.split('/')[0] }}/32
{% endif %}
{% endif %}

# DNS servers
{% if wireguard_dns_servers %}
{% for dns in wireguard_dns_servers %}
DNS = {{ dns }}
{% endfor %}
{% endif %}

# MTU
MTU = {{ wireguard_vpn_mtu }}

# Post-up rules
{% if wireguard_enable_ip_forward | default(false) %}
PostUp = sysctl -w net.ipv4.ip_forward=1
{% endif %}
PostUp = ip -4 rule add from {{ wireguard_vpn_network }} lookup 200
PostUp = ip -4 route add default via {{ wireguard_vpn_network.split('.')[0:3] | join('.') }}.1 table 200

# Post-down rules
PostDown = ip -4 rule delete from {{ wireguard_vpn_network }} lookup 200
PostDown = ip -4 route delete default via {{ wireguard_vpn_network.split('.')[0:3] | join('.') }}.1 table 200
{% if wireguard_enable_ip_forward | default(false) %}
PostDown = sysctl -w net.ipv4.ip_forward=0
{% endif %}

# Peers Configuration
{% if wireguard_topology == 'full_mesh' %}
# Full Mesh - All nodes peer with each other
{% for peer_name, peer_data in wireguard_full_mesh_nodes.items() %}
{% if peer_name != inventory_hostname %}

[Peer]
# {{ peer_name }}
PublicKey = {{ peer_data.public_key | default('KEY_PLACEHOLDER_' + peer_name) }}
AllowedIPs = {{ peer_data.vpn_ip }}/32
Endpoint = {{ peer_data.public_endpoint }}
PersistentKeepalive = {{ wireguard_persistent_keepalive }}
{% endif %}
{% endfor %}

{% elif wireguard_topology == 'hub_spoke' %}
{% if wireguard_node_role == 'hub' %}
# Hub Node - Peers with all spokes
{% for spoke_name, spoke_data in wireguard_spoke_nodes.items() %}

[Peer]
# {{ spoke_name }}
PublicKey = {{ spoke_data.public_key | default('KEY_PLACEHOLDER_' + spoke_name) }}
AllowedIPs = {{ spoke_data.vpn_ip }}/32{% if spoke_data.networks %},{{ spoke_data.networks | join(',') }}{% endif %}

Endpoint = {{ spoke_data.public_endpoint }}
PersistentKeepalive = {{ wireguard_persistent_keepalive }}
{% endfor %}

{% if wireguard_ha_mode | default(false) and wireguard_hub_peers %}
# Backup hub peers for HA failover
{% for backup_hub in wireguard_hub_peers %}

[Peer]
# {{ backup_hub.name }} (Backup)
PublicKey = {{ backup_hub.public_key | default('KEY_PLACEHOLDER_' + backup_hub.name) }}
AllowedIPs = {{ backup_hub.vpn_ip }}/32
Endpoint = {{ backup_hub.public_endpoint | default('') }}
PersistentKeepalive = {{ wireguard_persistent_keepalive }}
{% endfor %}
{% endif %}

{% else %}
# Spoke Node - Only peers with hub(s)

[Peer]
# Hub: {{ wireguard_hub_node }}
PublicKey = {{ wireguard_hub_node_public_key | default('KEY_PLACEHOLDER_HUB') }}
AllowedIPs = {{ wireguard_hub_vpn_ip }}/32
{% for other_spoke_name, other_spoke_data in wireguard_spoke_nodes.items() %}
{% if other_spoke_name != inventory_hostname %}
,{{ other_spoke_data.vpn_ip }}/32{% if other_spoke_data.networks %},{{ other_spoke_data.networks | join(',') }}{% endif %}
{% endif %}
{% endfor %}

Endpoint = {{ wireguard_hub_endpoint | default('') }}
PersistentKeepalive = {{ wireguard_persistent_keepalive }}

{% if wireguard_ha_mode | default(false) and wireguard_hub_peers %}
# Backup hub for failover
{% for backup_hub in wireguard_hub_peers %}

[Peer]
# {{ backup_hub.name }} (Backup Hub)
PublicKey = {{ backup_hub.public_key | default('KEY_PLACEHOLDER_BACKUP') }}
AllowedIPs = {{ backup_hub.vpn_ip }}/32
Endpoint = {{ backup_hub.public_endpoint | default('') }}
PersistentKeepalive = {{ wireguard_persistent_keepalive }}
{% endfor %}
{% endif %}

{% endif %}

{% elif wireguard_topology == 'site_to_site' %}
# Site-to-Site Mesh - Each gateway peers with other gateways
{% set current_site_name = wireguard_sites | dict2items | selectattr('value.gateway', 'equalto', inventory_hostname) | map(attribute='key') | first | default('unknown') %}

{% for site_name, site_data in wireguard_sites.items() %}
{% if site_name != current_site_name %}

[Peer]
# {{ site_name }} - {{ site_data.location }}
PublicKey = {{ site_data.public_key | default('KEY_PLACEHOLDER_' + site_name) }}
AllowedIPs = {{ site_data.vpn_network }}{% if site_data.networks %},{{ site_data.networks | join(',') }}{% endif %}

Endpoint = {{ site_data.endpoint | default('') }}
PersistentKeepalive = {{ wireguard_persistent_keepalive }}
{% endif %}
{% endfor %}

{% endif %}

# End of Wireguard configuration
