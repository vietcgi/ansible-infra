-- KumoMTA Email Delivery Queue Configuration
-- Handles message logging and monitoring

local queue_config = {}

-- Configure egress path behavior (connection limits, timeouts)
kumo.on('get_egress_path_config', function(domain, egress_source, site_name)
  local params = {
    connection_limit = {{ kumomta_max_connections_per_domain | default(20) }},
    max_message_size = {{ kumomta_max_message_size | default(104857600) }},
    connect_timeout = 30,
    idle_timeout = 60,
    max_connection_lifetime = 300,
  }

  -- Special handling for Google/Gmail
  if domain == 'gmail.com' or domain == 'googlemail.com' then
    -- Google is strict about connection limits and ramp-up
    params.connection_limit = 10 -- Start conservative
  end

  return kumo.make_egress_path_config(params)
end)

-- Handle message queuing
function kumo.on_message_queued(msg)
  local domain = msg:get_recipient_domain()
  local tenant = msg:get_meta('tenant') or ''
  local campaign = msg:get_meta('campaign') or ''

  kumo.log(kumo.LOG_DEBUG, string.format(
    'Message queued: domain=%s tenant=%s campaign=%s size=%d',
    domain, tenant, campaign, msg:get_body_size()
  ))

  return true
end

-- Configure delivery attempts and retry logic
function kumo.on_bounce(msg, bounce_type, diagnostic_code, user_message)
  local num_attempts = msg:get_num_attempts()
  local max_attempts = {{ kumomta_max_delivery_attempts | default(5) }}

  kumo.log(kumo.LOG_INFO, string.format(
    'Bounce: %s attempt %d/%d - %s',
    msg:get_recipient(), num_attempts, max_attempts, user_message
  ))

  if num_attempts >= max_attempts then
    -- Max attempts exceeded, generate bounce message
    local bounce_msg = kumo.make_message(
      'postmaster@{{ email_domain }}',
      msg:get_recipient(),
      'Delivery failed: ' .. user_message
    )
    kumo.queue_message(bounce_msg)
    return false -- Don't retry
  end

  -- Determine retry delay based on attempt number
  local retry_delay = get_retry_delay(num_attempts)
  msg:set_next_delivery_attempt(kumo.time.now() + retry_delay)

  return true -- Will retry
end

-- Calculate exponential backoff retry delay
function get_retry_delay(attempt)
  local base_delay = 60 -- 1 minute
  local max_delay = {{ kumomta_max_retry_delay | default(86400) }} -- 1 day

  -- Exponential backoff: 1m, 2m, 4m, 8m...
  local delay = base_delay * math.pow(2, attempt - 1)

  -- Cap at max delay
  if delay > max_delay then
    delay = max_delay
  end

  return delay
end

-- Handle successful delivery
function kumo.on_message_delivered(msg)
  local domain = msg:get_recipient_domain()
  local attempts = msg:get_num_attempts()

  kumo.log(kumo.LOG_INFO, string.format(
    'Message delivered to %s in %d attempt(s)',
    domain, attempts
  ))

  return true
end

-- Handle permanent delivery failures
function kumo.on_delivery_failed(msg, reason)
  kumo.log(kumo.LOG_WARN, string.format(
    'Permanent delivery failure to %s: %s',
    msg:get_recipient(), reason
  ))

  -- Generate non-delivery report (NDR)
  local ndr = kumo.make_message(
    'postmaster@{{ email_domain }}',
    msg:get_sender(),
    'Delivery failed for message to ' .. msg:get_recipient() .. ': ' .. reason
  )

  kumo.queue_message(ndr)
  return true
end

-- Handle connection-level errors
function kumo.on_delivery_error(msg, err)
  local domain = msg:get_recipient_domain()
  local num_attempts = msg:get_num_attempts()
  local max_attempts = {{ kumomta_max_delivery_attempts | default(5) }}

  kumo.log(kumo.LOG_WARN, string.format(
    'Delivery error for %s@%s (attempt %d/%d): %s',
    msg:get_recipient_local_part(), domain, num_attempts, max_attempts, err
  ))

  if num_attempts < max_attempts then
    local retry_delay = get_retry_delay(num_attempts)
    msg:set_next_delivery_attempt(kumo.time.now() + retry_delay)
    return true -- Will retry
  end

  return false -- No more retries
end

-- Log queue statistics
function kumo.on_tick()
  -- This is called periodically by KumoMTA
  local stats = kumo.get_queue_stats()

  if stats.total_messages > 0 then
    kumo.log(kumo.LOG_DEBUG, string.format(
      'Queue stats: total=%d, ready=%d, delivering=%d',
      stats.total_messages, stats.ready_messages, stats.delivering_messages
    ))
  end
end

-- Rate limiting per domain
function kumo.on_generate_bounce_address(msg, bounce_type)
  local domain = msg:get_recipient_domain()

  -- Track delivery rate per domain
  local key = 'rate:' .. domain
  local current = kumo.cache_get(key) or 0
  local max_rate = {{ kumomta_max_messages_per_minute | default(300) }}

  if current >= max_rate then
    kumo.log(kumo.LOG_WARN, string.format(
      'Rate limit exceeded for %s: %d messages/min', domain, current
    ))

    -- Delay delivery for this message
    msg:set_next_delivery_attempt(kumo.time.now() + 60)
    return true
  end

  kumo.cache_set(key, current + 1, 60)
  return true
end

return queue_config
