# Cloudflare API credentials for certbot DNS validation
# Used by certbot dns-cloudflare plugin for Let's Encrypt ACME DNS challenges

# Cloudflare API token (with DNS edit permissions for the target domain)
dns_cloudflare_api_token = {{ cloudflare_api_token }}

# Optional: Cloudflare zone ID (speeds up API lookups)
# If not specified, certbot will look up the zone ID automatically
dns_cloudflare_zone_id = {{ cloudflare_zone_id | default('') }}

# Uncomment below for older certbot versions that use email+API key instead of token
# dns_cloudflare_email = {{ cloudflare_email | default('') }}
# dns_cloudflare_api_key = {{ cloudflare_api_key | default('') }}
