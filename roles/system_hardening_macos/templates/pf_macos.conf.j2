# pass in inet proto tcp to any port 9100 keep state

## ============================================================================
## NOTES
## ============================================================================
# - SSH rate limiting: 5 connections max, 5 connections per 30 seconds
# - Sources exceeding limits are added to <bruteforce> table and blocked
# - View blocked sources: sudo pfctl -t bruteforce -T show
# - View all tables: sudo pfctl -s Tables
# - To disable a rule: prefix with "#"
# - To reload rules: sudo pfctl -f /etc/pf.conf
# - SIP protects system PF but /etc/pf.conf is writable
