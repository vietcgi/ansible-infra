# macOS SSH Daemon Configuration - Hardened
# 2025 Best Practices: NIST SP 800-219, CIS Benchmarks
# Generated by ansible-infra framework

## Protocol and Cryptography
Protocol 2
Port 22

# SSH Key Exchange Algorithms (Post-quantum first)
KexAlgorithms {{ macos_ssh_key_exchange | join(',') }}

# SSH Ciphers (AEAD with built-in authentication)
Ciphers {{ macos_ssh_ciphers | join(',') }}

# Message Authentication Codes (Encrypt-then-MAC preferred)
MACs {{ macos_ssh_macs | join(',') }}

# Host Keys (Ed25519 preferred for security and performance)
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key

## Authentication
# Key-based authentication only
PubkeyAuthentication yes
PasswordAuthentication {{ macos_sshd_password_authentication }}
PermitEmptyPasswords {{ macos_sshd_empty_password_login }}
ChallengeResponseAuthentication no
KerberosAuthentication no
GSSAPIAuthentication no
UsePAM yes

# Root login
PermitRootLogin {{ macos_sshd_permit_root_login }}

## Access Control
# Restrict SSH access
AllowUsers *@*
DenyUsers root
DenyGroups root wheel

MaxAuthTries {{ macos_sshd_max_auth_tries }}
MaxSessions {{ macos_sshd_max_sessions }}
LoginGraceTime 20s

## Connection Management
ClientAliveInterval {{ macos_sshd_client_alive_interval }}
ClientAliveCountMax {{ macos_sshd_client_alive_count_max }}
TCPKeepAlive yes

## Forwarding and Tunneling (Disabled by default)
AllowAgentForwarding {{ macos_sshd_permit_agent_forwarding }}
AllowTcpForwarding {{ macos_sshd_allow_tcp_forwarding }}
PermitTunnel {{ macos_sshd_permit_tunnel }}
X11Forwarding {{ macos_sshd_x11_forwarding }}
X11UseLocalhost yes
PermitUserEnvironment {{ macos_sshd_permit_user_environment }}
PermitUserRC no

## Misc Security
StrictModes yes
IgnoreRhosts yes
IgnoreUserKnownHosts no
HostbasedAuthentication no
RhostsRSAAuthentication no
RSAAuthentication no

# Logging
SyslogFacility AUTH
LogLevel VERBOSE

# Banner
Banner /etc/ssh/banner.txt

# Subsystem
Subsystem sftp /usr/libexec/sftp-server -f AUTHPRIV -l INFO
