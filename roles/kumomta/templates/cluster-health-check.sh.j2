#!/bin/bash
# KumoMTA Cluster Health Check Script
# Generated by Ansible - Do not edit manually

set -e

ADMIN_API_PORT="{{ kumomta_admin_port }}"
CONSENSUS_PORT="{{ kumomta_cluster_consensus_port }}"
DATA_PORT="{{ kumomta_cluster_data_port }}"
TIMEOUT=5

healthy=0
unhealthy=0

log() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] $*"
}

check_peer() {
    local peer=$1
    local peer_host="${peer%:*}"
    local peer_port="${peer#*:}"

    log "Checking peer: $peer"

    # Check if consensus port is reachable
    if timeout $TIMEOUT bash -c ">/dev/tcp/$peer_host/$CONSENSUS_PORT" 2>/dev/null; then
        log "  ✓ Consensus port ($CONSENSUS_PORT) reachable"
    else
        log "  ✗ Consensus port ($CONSENSUS_PORT) unreachable"
        ((unhealthy++))
        return 1
    fi

    # Check if data port is reachable
    if timeout $TIMEOUT bash -c ">/dev/tcp/$peer_host/$DATA_PORT" 2>/dev/null; then
        log "  ✓ Data port ($DATA_PORT) reachable"
    else
        log "  ✗ Data port ($DATA_PORT) unreachable"
        ((unhealthy++))
        return 1
    fi

    # Try to get health status from admin API
    if timeout $TIMEOUT bash -c ">/dev/tcp/$peer_host/$ADMIN_API_PORT" 2>/dev/null; then
        log "  ✓ Admin API reachable"
        ((healthy++))
        return 0
    else
        log "  ⚠ Admin API unreachable (ports reachable but API down)"
        return 1
    fi
}

log "Starting KumoMTA cluster health check"
log "Checking peers: {{ kumomta_cluster_peers | join(', ') }}"

{% for peer in kumomta_cluster_peers %}
check_peer "{{ peer }}" || true
{% endfor %}

log ""
log "Health Check Summary:"
log "  Healthy peers: $healthy"
log "  Unhealthy peers: $unhealthy"

if [ $unhealthy -eq 0 ]; then
    log "✓ All cluster peers are healthy"
    exit 0
elif [ $healthy -eq 0 ]; then
    log "✗ All cluster peers are unhealthy"
    exit 2
else
    log "⚠ Some cluster peers are unhealthy"
    exit 1
fi
