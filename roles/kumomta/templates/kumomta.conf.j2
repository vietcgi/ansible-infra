-- KumoMTA Configuration File
-- Generated by Ansible - Do not edit manually

-- Load the kumo module (required when used as a policy file)
local kumo = require 'kumo'


kumo.on('init', function()
  -- Define the default spool - REQUIRED for service to start
  kumo.define_spool {
      name = "default",
      path = "{{ kumomta_queue_dir }}/default",
  }

  -- Optional secondary spool for important messages
  kumo.define_spool {
      name = "important",
      path = "{{ kumomta_queue_dir }}/important",
  }

  -- Setup SMTP listeners for receiving mail
  kumo.start_esmtp_listener {
      listen = "0.0.0.0:{{ kumomta_listen_port }}",
      hostname = "{{ kumomta_hostname }}",
      relay_hosts = {'0.0.0.0/0'},
  }

  kumo.start_esmtp_listener {
      listen = "0.0.0.0:{{ kumomta_submit_port }}",
      hostname = "{{ kumomta_hostname }}",
      require_authz = {{ 'true' if kumomta_require_auth else 'false' }},
  }

{% if kumomta_tls_enabled %}
  kumo.start_esmtps_listener {
      listen = "0.0.0.0:{{ kumomta_tls_port }}",
      hostname = "{{ kumomta_hostname }}",
      tls_certificate = "{{ kumomta_tls_certificate }}",
      tls_private_key = "{{ kumomta_tls_key }}",
  }
{% endif %}

  -- Define domain configuration
  kumo.define_domain "{{ kumomta_hostname }}" {
      source_address = "{{ kumomta_hostname }}",
  }

{% if kumomta_dkim_enabled %}
  -- DKIM Configuration
  kumo.dkim_sign {
      domain = "{{ kumomta_hostname }}",
      selector = "{{ kumomta_dkim_selector }}",
      headers_to_sign = {
          "From",
          "To",
          "Subject",
          "Date",
          "Message-ID",
          "MIME-Version",
          "Content-Type",
          "Content-Transfer-Encoding",
      },
      key_file = "{{ kumomta_dkim_key }}",
  }
{% endif %}

  -- Admin listener for HTTP API
  kumo.start_http_listener {
      listen = "0.0.0.0:{{ kumomta_admin_port }}",
  }

{% if kumomta_monitoring_enabled %}
  -- Metrics listener
  kumo.start_metrics_listener {
      listen = "0.0.0.0:{{ kumomta_metrics_port }}",
  }
{% endif %}
end)

-- CRITICAL: Accept messages from SMTP
-- Return without error to allow default queueing behavior
kumo.on('smtp_server_message_received', function(msg)
    return true
end)

-- CRITICAL: Configure queue behavior
-- Without this handler, messages won't be delivered
kumo.on('get_queue_config', function(domain, tenant, campaign, routing_domain)
    return kumo.make_queue_config {
        -- Message aging and retry strategy
        max_age = '7 days',
        retry_interval = '5 minutes',
        max_retry_interval = '20 minutes',
        egress_pool = 'default',
    }
end)

-- CRITICAL: Configure message routing
-- Without this handler, messages won't know where to go
kumo.on('get_routes', function(domain)
    -- Check if domain is an IPv4 address literal
    -- If so, route directly to it by treating it as its own MX
    if domain:match("^%d+%.%d+%.%d+%.%d+$") then
        return kumo.make_routing_domain {
            name = domain,
            mx_list = { { name = domain, pref = 1 } }
        }
    end
    -- Otherwise use standard MX routing
    return kumo.make_routing_domain(domain)
end)

-- Define egress pool configuration
kumo.on('get_egress_pool_config', function(pool_name)
    return kumo.make_egress_pool_config {
        max_connections_per_domain = 20,
    }
end)

-- CRITICAL: Enable automatic delivery scheduling
-- Without this handler, queued messages will never be delivered
kumo.on('get_scheduled_event', function(meta)
    return kumo.make_scheduled_event(0)
end)


-- Load policy script if it exists
pcall(dofile, "{{ kumomta_config_dir }}/policy.lua")

-- Load queue script if it exists
pcall(dofile, "{{ kumomta_config_dir }}/queue.lua")

{% if kumomta_bounce_handling_enabled %}
-- Load bounce handling policy if it exists
pcall(dofile, "{{ kumomta_config_dir }}/bounce-policy.lua")
{% endif %}

-- Load email delivery configuration if it exists
pcall(dofile, "/etc/kumomta/email-delivery-queue.lua")
pcall(dofile, "/etc/kumomta/email-delivery-policy.lua")

-- Load email routing configuration if it exists
pcall(dofile, "/etc/kumomta/email-routing.lua")

