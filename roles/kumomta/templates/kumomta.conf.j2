-- KumoMTA Configuration
-- Unified configuration with all handlers for message delivery

local kumo = require 'kumo'

kumo.on('init', function()
  kumo.define_spool {
      name = "data",
      path = "{{ kumomta_queue_dir }}/data",
  }

  kumo.define_spool {
      name = "meta",
      path = "{{ kumomta_queue_dir }}/meta",
  }

  kumo.define_spool {
      name = "default",
      path = "{{ kumomta_queue_dir }}/default",
  }

  kumo.start_esmtp_listener {
      listen = "0.0.0.0:{{ kumomta_listen_port }}",
      hostname = "{{ kumomta_hostname }}",
      relay_hosts = {'0.0.0.0/0'},
  }

  kumo.start_esmtp_listener {
      listen = "0.0.0.0:{{ kumomta_submit_port }}",
      hostname = "{{ kumomta_hostname }}",
  }

  kumo.start_http_listener {
      listen = "0.0.0.0:{{ kumomta_admin_port }}",
  }
end)

-- Handle incoming SMTP messages
kumo.on('smtp_server_message_received', function(msg)
  return true
end)

-- Define listener domain acceptance
kumo.on('get_listener_domain', function(domain)
  return kumo.make_listener_domain {
    relay_to = true,
  }
end)

-- Allow relaying to external domains
kumo.on('should_relay_to', function(relayer, recipient_domain)
  return true
end)

-- Default routing - use MX lookup for recipient domain
kumo.on('get_routes', function(domain)
  return kumo.make_routing_domain(domain)
end)

-- Egress source configuration
kumo.on('get_egress_source', function(source_name)
  return kumo.make_egress_source {
    name = source_name,
    source_address = '{{ kumomta_source_address }}',
    ehlo_domain = '{{ kumomta_hostname }}',
  }
end)

-- Egress pool configuration for load balancing
kumo.on('get_egress_pool', function(pool_name)
  return kumo.make_egress_pool {
    name = pool_name,
    entries = {
      { name = 'default', weight = 100 },
    },
  }
end)

-- Egress path configuration (connection limits, timeouts)
kumo.on('get_egress_path_config', function(source_name, site_name)
  return kumo.make_egress_path_config {
    connection_limit = 20,
    max_message_rate = '100/s',
    connect_timeout = 30,
    idle_timeout = 60,
  }
end)

-- Queue configuration (retry logic, message age)
kumo.on('get_queue_config', function(domain, tenant, campaign, routing_domain)
  return kumo.make_queue_config {
    max_age = '7 days',
    retry_interval = '5 minutes',
    max_retry_interval = '20 minutes',
    egress_pool = 'default',
  }
end)

-- Scheduled event handler (called periodically)
kumo.on('get_scheduled_event', function(meta)
  return kumo.make_scheduled_event(0)
end)

-- Allow message sending
kumo.on('should_send_mail', function(msg)
  return true
end)
