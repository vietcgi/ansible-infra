-- KumoMTA Configuration - Complete handler setup
-- Loads external policy files for queueing and routing

local kumo = require 'kumo'

-- Load external policy modules that handle queueing and routing
pcall(dofile, '{{ kumomta_config_dir }}/email-delivery-queue.lua')
pcall(dofile, '{{ kumomta_config_dir }}/email-routing.lua')

kumo.on('init', function()
  kumo.define_spool {
      name = "data",
      path = "{{ kumomta_queue_dir }}/data",
  }

  kumo.define_spool {
      name = "meta",
      path = "{{ kumomta_queue_dir }}/meta",
  }

  kumo.define_spool {
      name = "default",
      path = "{{ kumomta_queue_dir }}/default",
  }

  kumo.start_esmtp_listener {
      listen = "0.0.0.0:{{ kumomta_listen_port }}",
      hostname = "{{ kumomta_hostname }}",
      relay_hosts = {'0.0.0.0/0'},
  }

  kumo.start_esmtp_listener {
      listen = "0.0.0.0:{{ kumomta_submit_port }}",
      hostname = "{{ kumomta_hostname }}",
  }

  kumo.start_http_listener {
      listen = "0.0.0.0:{{ kumomta_admin_port }}",
  }
end)

-- Handle incoming SMTP messages
kumo.on('smtp_server_message_received', function(msg)
  return true
end)

-- Define listener domain acceptance
kumo.on('get_listener_domain', function(domain)
  return kumo.make_listener_domain {
    relay_to = true,
  }
end)

-- Allow relaying to external domains
kumo.on('should_relay_to', function(relayer, recipient_domain)
  return true
end)

-- Egress source configuration
kumo.on('get_egress_source', function(source_name)
  return kumo.make_egress_source {
    name = source_name,
    source_address = '{{ kumomta_source_address }}',
    ehlo_domain = '{{ kumomta_hostname }}',
  }
end)

-- Always send mail - no message filtering
kumo.on('should_send_mail', function(msg)
  return true
end)

-- NOTE: The following handlers are provided by external modules and should NOT be defined here:
-- get_routes (from email-routing.lua)
-- get_queue_config (from email-delivery-queue.lua)
-- get_egress_pool (from email-delivery-queue.lua)
-- get_egress_path_config (from email-delivery-queue.lua)
-- get_scheduled_event (from email-delivery-queue.lua)
-- Defining them here would cause handler conflicts and prevent delivery!
