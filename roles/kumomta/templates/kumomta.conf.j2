-- KumoMTA Configuration - MINIMAL (modules handle all delivery logic)
-- Load external policy modules for all handler definitions

local kumo = require 'kumo'

-- Load all policy modules - they define handlers for delivery, routing, queuing
dofile('/etc/kumomta/email-delivery-queue.lua')
dofile('/etc/kumomta/email-routing.lua')
dofile('/etc/kumomta/email-delivery-policy.lua')

-- ONLY define init and required listeners
kumo.on('init', function()
  kumo.define_spool {
      name = "data",
      path = "{{ kumomta_queue_dir }}/data",
  }

  kumo.define_spool {
      name = "meta",
      path = "{{ kumomta_queue_dir }}/meta",
  }

  kumo.define_spool {
      name = "default",
      path = "{{ kumomta_queue_dir }}/default",
  }

  kumo.start_esmtp_listener {
      listen = "0.0.0.0:{{ kumomta_listen_port }}",
      hostname = "{{ kumomta_hostname }}",
      relay_hosts = {'0.0.0.0/0'},
  }

  kumo.start_esmtp_listener {
      listen = "0.0.0.0:{{ kumomta_submit_port }}",
      hostname = "{{ kumomta_hostname }}",
  }

  kumo.start_http_listener {
      listen = "0.0.0.0:{{ kumomta_admin_port }}",
  }
end)

-- Accept inbound messages (required)
kumo.on('smtp_server_message_received', function(msg)
  return true
end)
