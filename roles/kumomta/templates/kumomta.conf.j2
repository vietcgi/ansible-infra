-- KumoMTA Configuration
-- Handles inbound and outbound mail delivery

local kumo = require 'kumo'

-- Load main policy initialization (must be first to set up policy-extras system)
pcall(dofile, '/etc/kumomta/init.lua')

-- Load additional policy modules that handle queueing and DKIM signing
pcall(dofile, '/etc/kumomta/email-delivery-queue.lua')
pcall(dofile, '/etc/kumomta/email-routing.lua')
pcall(dofile, '/etc/kumomta/email-delivery-policy.lua')

-- Accept incoming SMTP messages (required for message delivery)
kumo.on('smtp_server_message_received', function(msg)
  -- Try to sign with DKIM if policy file didn't already handle it
  local ok, err = pcall(function()
    local signer = kumo.dkim.rsa_sha256_signer {
      domain = '{{ kumomta_hostname }}',
      selector = 'default',
      headers = {'From', 'To', 'Subject', 'Date'},
      key = '/etc/kumomta/dkim/default.key',
      over_sign = true,
    }
    msg:dkim_sign(signer)
  end)

  -- Log DKIM signing failures but don't reject the message
  if not ok then
    kumo.log('info', 'DKIM signing failed: ' .. tostring(err))
  end

  -- Message is automatically queued on successful return
  return true
end)

kumo.on('init', function()
  kumo.define_spool {
      name = "data",
      path = "{{ kumomta_queue_dir }}/data",
  }

  kumo.define_spool {
      name = "meta",
      path = "{{ kumomta_queue_dir }}/meta",
  }

  kumo.define_spool {
      name = "default",
      path = "{{ kumomta_queue_dir }}/default",
  }

  kumo.start_esmtp_listener {
      listen = "0.0.0.0:{{ kumomta_listen_port }}",
      hostname = "{{ kumomta_hostname }}",
      relay_hosts = {'0.0.0.0/0'},
  }

  kumo.start_esmtp_listener {
      listen = "0.0.0.0:{{ kumomta_submit_port }}",
      hostname = "{{ kumomta_hostname }}",
  }

  kumo.start_http_listener {
      listen = "0.0.0.0:{{ kumomta_admin_port }}",
  }
end)

-- Define which domains accept and queue inbound messages
kumo.on('get_listener_domain', function(domain)
  return kumo.make_listener_domain {
    relay_to = true,
  }
end)

kumo.on('get_routes', function(domain)
  return kumo.make_routing_domain(domain)
end)

kumo.on('get_egress_source', function(source_name)
  return kumo.make_egress_source {
    name = source_name,
    source_address = '{{ kumomta_source_address }}',
    ehlo_domain = '{{ kumomta_hostname }}',
  }
end)

-- NOTE: get_egress_pool is automatically provided by policy-extras.sources
-- Do not define it here to avoid handler conflicts with policy-extras

kumo.on('get_egress_path_config', function(source_name, site_name)
  return kumo.make_egress_path {
    connection_limit = 20,
    max_message_rate = '100/s',
  }
end)

kumo.on('get_queue_config', function(domain, tenant, campaign, routing_domain)
  return kumo.make_queue_config {
    max_age = '7 days',
    retry_interval = '5 minutes',
    max_retry_interval = '20 minutes',
    egress_pool = 'default',
  }
end)

kumo.on('get_scheduled_event', function(meta)
  return kumo.make_scheduled_event(0)
end)

kumo.on('should_send_mail', function(msg)
  return true
end)

kumo.on('send_mail_result', function(msg, result, err)
  return true
end)
