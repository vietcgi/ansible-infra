# KumoMTA Configuration File
# Generated by Ansible - Do not edit manually

[general]
hostname = "{{ kumomta_hostname }}"
data_dir = "{{ kumomta_queue_dir }}"
log_dir = "{{ kumomta_log_dir }}"
config_dir = "{{ kumomta_config_dir }}"

[listener.smtp]
listen_address = "0.0.0.0:{{ kumomta_listen_port }}"
concurrency = {{ kumomta_max_connections }}
max_message_size = {{ kumomta_max_message_size }}

[listener.submission]
listen_address = "0.0.0.0:{{ kumomta_submit_port }}"
require_auth = true
concurrency = {{ kumomta_submission_max_connections }}
max_message_size = {{ kumomta_max_message_size }}

{% if kumomta_tls_enabled %}
[listener.tls]
listen_address = "0.0.0.0:{{ kumomta_tls_port }}"
tls_cert_path = "{{ kumomta_tls_certificate }}"
tls_key_path = "{{ kumomta_tls_key }}"
concurrency = {{ kumomta_max_connections }}
max_message_size = {{ kumomta_max_message_size }}
{% endif %}

{% if kumomta_dkim_enabled %}
[dkim]
enabled = true
private_key = "{{ kumomta_dkim_key }}"
selector = "{{ kumomta_dkim_selector }}"
domain = "{{ kumomta_hostname }}"
{% endif %}

[admin]
listen_address = "0.0.0.0:{{ kumomta_admin_port }}"
enable_metrics = {{ kumomta_metrics_enabled | lower }}

[queue]
strategy = "{{ kumomta_queue_strategy }}"
max_size = {{ kumomta_max_queue_size }}
retry_interval = {{ kumomta_queue_retry_interval }}
max_attempts = {{ kumomta_queue_max_attempts }}
expiration_time = {{ kumomta_queue_expiration }}

[policy]
policy_script = "{{ kumomta_config_dir }}/policy.lua"

[logging]
config_file = "{{ kumomta_config_dir }}/logging.toml"

{% if kumomta_monitoring_enabled %}
[metrics]
listen_address = "0.0.0.0:{{ kumomta_metrics_port }}"
enabled = true
{% endif %}

{% if kumomta_clustering_enabled %}
[clustering]
enabled = true
node_id = "{{ inventory_hostname }}"
{% for peer in kumomta_cluster_peers %}
peer = "{{ peer }}"
{% endfor %}
{% endif %}

{% if kumomta_bounce_handling_enabled %}
[bounce]
enabled = true
handler_script = "{{ kumomta_config_dir }}/bounce-policy.lua"
{% endif %}

{% if kumomta_fbl_enabled %}
[fbl]
enabled = true
processor = "{{ kumomta_config_dir }}/fbl-processor.lua"
{% endif %}
