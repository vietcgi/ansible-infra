[Unit]
Description=KumoMTA Email Delivery Service
Documentation=https://github.com/kumocorp/kumomta
After=network.target

[Service]
Type=simple
User={{ kumomta_user }}
Group={{ kumomta_group }}
WorkingDirectory={{ kumomta_home }}

# Service startup - loads configured policy
# Binary has CAP_NET_BIND_SERVICE capability via setcap
ExecStart={{ kumomta_home }}/sbin/kumod --policy {{ kumomta_config_dir }}/policy.lua

# Process management
Restart=on-failure
RestartSec=10s

# Resource limits
LimitNOFILE=65536
LimitNPROC=32768

# Security and isolation
PrivateTmp=true
ReadWritePaths={{ kumomta_queue_dir }} {{ kumomta_log_dir }} {{ kumomta_config_dir }} {{ kumomta_backup_dir }} {{ kumomta_home }}/etc

# Process tracking
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kumomta

# Performance tuning
CPUQuota={{ kumomta_cpu_quota }}
MemoryLimit={{ kumomta_memory_limit }}

[Install]
WantedBy=multi-user.target
