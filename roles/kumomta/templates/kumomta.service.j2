[Unit]
Description=KumoMTA Email Delivery Service
Documentation=https://github.com/kumocorp/kumomta
After=network.target

[Service]
Type=simple
User={{ kumomta_user }}
Group={{ kumomta_group }}
WorkingDirectory={{ kumomta_home }}

# Service startup
ExecStart={{ kumomta_home }}/sbin/kumod --policy {{ kumomta_config_dir }}/policy.lua

# Process management
Restart=on-failure
RestartSec=10s

# Resource limits
LimitNOFILE=65536
LimitNPROC=32768

# Capabilities - allow binding to privileged ports (25, 587, 465)
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Security and isolation
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=false
ReadWritePaths={{ kumomta_queue_dir }} {{ kumomta_log_dir }} {{ kumomta_config_dir }} {{ kumomta_backup_dir }} {{ kumomta_home }}/etc

# Process tracking
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kumomta

# Performance tuning
CPUQuota={{ kumomta_cpu_quota }}
MemoryLimit={{ kumomta_memory_limit }}

[Install]
WantedBy=multi-user.target
