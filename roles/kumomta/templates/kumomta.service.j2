[Unit]
Description=KumoMTA Email Delivery Service
Documentation=https://github.com/kumocorp/kumomta
After=network.target

[Service]
Type=simple
User={{ kumomta_user }}
Group={{ kumomta_group }}
WorkingDirectory={{ kumomta_home }}

# Thread pool environment variables for better concurrency detection
# RAYON_NUM_THREADS: Explicitly set thread count for Rayon parallelism (KumoMTA uses this)
{% if kumomta_env_variables is defined %}
{% for env_key, env_val in kumomta_env_variables.items() %}
Environment="{{ env_key }}={{ env_val }}"
{% endfor %}
{% endif %}

# Service startup - loads configured policy
# Binary has CAP_NET_BIND_SERVICE capability via setcap
ExecStart={{ kumomta_home }}/sbin/kumod --policy /opt/kumomta/etc/policy/init.lua

# Process management
Restart=on-failure
RestartSec=10s

# Resource limits
LimitNOFILE=65536
LimitNPROC=32768

# Security and isolation
PrivateTmp=true
ReadWritePaths={{ kumomta_queue_dir }} {{ kumomta_log_dir }} {{ kumomta_config_dir }} {{ kumomta_backup_dir }} {{ kumomta_home }}/etc

# Process tracking
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kumomta

# Performance tuning - Memory limits
# MemoryLimit sets hard limit; KumoMTA's shrink_ready_queue activates near this limit
MemoryLimit={{ kumomta_memory_limit }}
# Account for CPU usage (helps with accurate reporting)
CPUAccounting=yes
# NOTE: Do NOT set CPUQuota here - it limits available_parallelism() detection
# CPUQuota=100% means 1 CPU, not all CPUs. We want KumoMTA to use all available cores.

[Install]
WantedBy=multi-user.target
