-- KumoMTA Cluster Metrics Aggregation
-- Generated by Ansible - Do not edit manually

local metrics = {
    collection_interval = {{ kumomta_metrics_interval }},
    retention_days = {{ kumomta_log_retention_days }},
}

function aggregate_peer_metrics(peer_metrics)
    local aggregated = {
        total_messages = 0,
        total_connections = 0,
        avg_latency = 0,
    }
    local count = 0
    for _, pm in ipairs(peer_metrics) do
        aggregated.total_messages = aggregated.total_messages + pm.messages_sent
        aggregated.total_connections = aggregated.total_connections + pm.connections
        aggregated.avg_latency = aggregated.avg_latency + pm.latency
        count = count + 1
    end
    if count > 0 then
        aggregated.avg_latency = aggregated.avg_latency / count
    end
    return aggregated
end

function export_cluster_metrics()
    return metrics
end

return {
    version = 1,
    aggregate = aggregate_peer_metrics,
    export = export_cluster_metrics,
}
