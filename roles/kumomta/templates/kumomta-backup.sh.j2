#!/bin/bash
# KumoMTA Backup Script
# Generated by Ansible - Do not edit manually

set -e
BACKUP_DIR="{{ kumomta_backup_dir }}"
QUEUE_DIR="{{ kumomta_queue_dir }}"
CONFIG_DIR="{{ kumomta_config_dir }}"

# Ensure backup directory exists
mkdir -p "$BACKUP_DIR"

# Backup queue and configuration
tar -czf "$BACKUP_DIR/backup-$(date +%Y%m%d-%H%M%S).tar.gz" \
  -C / \
  "${QUEUE_DIR#/}" \
  "${CONFIG_DIR#/}" 2>/dev/null || true

exit 0
