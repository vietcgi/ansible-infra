#!/bin/bash
# KumoMTA Backup Script
# Generated by Ansible - Do not edit manually

set -e

BACKUP_DIR="{{ kumomta_backup_dir }}"
QUEUE_DIR="{{ kumomta_queue_dir }}"
CONFIG_DIR="{{ kumomta_config_dir }}"
LOG_FILE="{{ kumomta_backup_log_file }}"
TIMESTAMP=$(date +%Y%m%d-%H%M%S)
BACKUP_FILE="$BACKUP_DIR/backup-$TIMESTAMP.tar.gz"
MAX_BACKUPS=30

log() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"
}

error() {
    log "ERROR: $*"
    exit 1
}

# Ensure backup directory exists
mkdir -p "$BACKUP_DIR" || error "Failed to create backup directory: $BACKUP_DIR"
mkdir -p "$(dirname "$LOG_FILE")" || error "Failed to create log directory"

log "Starting KumoMTA backup at $TIMESTAMP"

# Pre-backup validation
if [ ! -d "$QUEUE_DIR" ]; then
    error "Queue directory does not exist: $QUEUE_DIR"
fi

if [ ! -d "$CONFIG_DIR" ]; then
    error "Configuration directory does not exist: $CONFIG_DIR"
fi

# Check available disk space (need at least 1GB for backup)
available_space=$(df "$BACKUP_DIR" | awk 'NR==2 {print $4}')
if [ "$available_space" -lt 1048576 ]; then
    error "Insufficient disk space for backup (need 1GB, have $(( available_space / 1024 ))MB)"
fi

log "Disk space available: $(( available_space / 1024 ))MB"

# Backup queue and configuration
log "Creating backup archive..."
if tar -czf "$BACKUP_FILE" \
  -C / \
  "${QUEUE_DIR#/}" \
  "${CONFIG_DIR#/}" 2>/dev/null; then
    log "Backup archive created: $BACKUP_FILE"
else
    error "Failed to create backup archive"
fi

# Verify backup integrity
log "Verifying backup integrity..."
if ! tar -tzf "$BACKUP_FILE" >/dev/null 2>&1; then
    rm -f "$BACKUP_FILE"
    error "Backup verification failed - archive corrupted"
fi
log "Backup integrity verified"

# Check backup file size
backup_size=$(du -h "$BACKUP_FILE" | cut -f1)
log "Backup size: $backup_size"

# Cleanup old backups (keep last 30)
log "Cleaning up old backups (keeping last $MAX_BACKUPS)..."
backup_count=$(find "$BACKUP_DIR" -name "backup-*.tar.gz" -type f | wc -l)
if [ "$backup_count" -gt "$MAX_BACKUPS" ]; then
    remove_count=$(( backup_count - MAX_BACKUPS ))
    log "Removing $remove_count old backup(s)"
    find "$BACKUP_DIR" -name "backup-*.tar.gz" -type f | sort | head -n "$remove_count" | while read -r old_backup; do
        log "Removing old backup: $(basename "$old_backup")"
        rm -f "$old_backup"
    done
fi

log "Backup completed successfully"
log "Backup file: $BACKUP_FILE"

exit 0
