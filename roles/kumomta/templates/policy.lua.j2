-- KumoMTA Policy Script - DKIM Signing and Delivery Configuration
-- Complete email delivery pipeline with IPv4 connectivity
-- Generated by Ansible - supports dynamic domain configuration

local kumo = require "kumo"

-- Initialize kumomta with spool configuration
kumo.on("init", function()
  kumo.start_esmtp_listener { listen = "0.0.0.0:25", relay_hosts = {'0.0.0.0/0'} }
  kumo.start_http_listener { listen = "127.0.0.1:8000" }

  kumo.define_spool { name = "data", path = "/var/spool/kumomta/data" }
  kumo.define_spool { name = "meta", path = "/var/spool/kumomta/meta" }

  kumo.configure_local_logs {
    log_dir = "/var/log/kumomta",
    max_segment_duration = "10s",
  }
end)

kumo.on("smtp_server_message_received", function(msg)
  -- Sign with DKIM
  local signer = kumo.dkim.rsa_sha256_signer {
    domain = "{{ email_domain }}",
    selector = "{{ dkim_selector | default('default') }}",
    headers = {"From", "To", "Subject", "Date", "Message-ID"},
    key = "/opt/kumomta/etc/dkim/{{ email_domain }}.key",
    over_sign = true,
  }
  msg:dkim_sign(signer)

  -- CRITICAL: Assign message to queue for delivery
  local recipient = msg:recipient()
  msg:set_meta("queue", recipient and recipient.domain or "default")
end)

kumo.on("get_bounce_domain", function(domain, action, bounce_type)
  -- Ensure Return-Path uses the sending domain for proper SPF alignment
  return domain
end)

kumo.on("get_queue_config", function(domain, tenant, campaign, routing_domain)
  return kumo.make_queue_config {
    egress_pool = "default",
    max_age = "2 days",
    retry_interval = "20 minutes",
    max_retry_interval = "2 hours",
  }
end)

kumo.on("get_egress_pool", function(pool_name)
  return kumo.make_egress_pool {
    name = pool_name,
    entries = {
      { name = "default" },
    },
  }
end)

kumo.on("get_routing_domain", function(domain)
  return kumo.make_routing_domain(domain, {
    use_mx = true,
  })
end)

kumo.on("get_egress_source", function(source_name)
  return kumo.make_egress_source {
    name = source_name,
    source_address = "{{ kumomta_source_address | default('0.0.0.0') }}",
  }
end)

kumo.on("get_egress_path_config", function(domain, egress_source, site_name)
  local params = {
    enable_tls = "OpportunisticInsecure",
    connection_limit = 10,
    max_deliveries_per_connection = 100,
    max_message_rate = "100/s",
  }

  -- Conservative limits for Gmail
  if string.find(domain, "gmail%.com") or string.find(domain, "googlemail%.com") then
    params.connection_limit = 5
    params.max_message_rate = "20/s"
  end

  return kumo.make_egress_path(params)
end)

-- Configure domains that can relay through this server
kumo.on("get_listener_domain", function(listener_name, domain, conn_meta)
  return kumo.make_listener_domain {
    relay_to = true,
  }
end)

-- Ready to send message - allow delivery to proceed
kumo.on("ready_to_send_message", function(msg)
  return true
end)
