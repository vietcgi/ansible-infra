-- Generated by Ansible - Do not edit manually
-- This policy allows relay to external recipients

local kumo = require 'kumo'

kumo.on('smtp_server_message_received', function(msg)
  -- Allow all messages through
  kumo.continue()
end)

kumo.on('get_listener_domain', function(listener_name, domain_name)
  -- Allow relay for any domain
  local relay_domain = kumo.get_domain(domain_name)
  if relay_domain then
    kumo.continue()
  else
    -- Allow relay to any domain for outbound
    kumo.continue()
  end
end)
