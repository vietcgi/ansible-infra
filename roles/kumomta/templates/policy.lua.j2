-- KumoMTA Policy Script - DKIM Signing and Delivery Configuration
-- Complete email delivery pipeline with IPv4 connectivity
-- Generated by Ansible - supports dynamic domain configuration

local kumo = require "kumo"
local bounce = require "bounce_policy"
local fbl = require "fbl_processor"

-- Initialize kumomta with spool configuration
kumo.on("init", function()
  kumo.start_esmtp_listener { listen = "0.0.0.0:{{ kumomta_listen_port | default(25) }}", relay_hosts = {'127.0.0.1'} }
  kumo.start_esmtp_listener { listen = "0.0.0.0:{{ kumomta_submit_port | default(587) }}", relay_hosts = {'127.0.0.1'} }
  kumo.start_http_listener { listen = "127.0.0.1:8000" }
  kumo.start_http_listener { listen = "0.0.0.0:{{ kumomta_metrics_port | default(9184) }}" }

  kumo.define_spool { name = "data", path = "/var/spool/kumomta/data" }
  kumo.define_spool { name = "meta", path = "/var/spool/kumomta/meta" }

  kumo.configure_local_logs {
    log_dir = "/var/log/kumomta",
    max_segment_duration = "10s",
  }
end)

kumo.on("smtp_server_message_received", function(msg)
  -- Ensure Message-ID exists
  if not msg:get_first_named_header_value("Message-ID") then
    local id = kumo.uuid.new_v4()
    msg:append_header("Message-ID", string.format("<%s@%s>", id, "{{ email_domain }}"))
  end

  -- Ensure Date exists
  if not msg:get_first_named_header_value("Date") then
    msg:append_header("Date", os.date("%a, %d %b %Y %H:%M:%S %z"))
  end

  -- Add List-Unsubscribe header if missing (Best Practice)
  -- TEMPORARILY DISABLED: Outlook might be filtering this for new IPs
  --[[
  if not msg:get_first_named_header_value("List-Unsubscribe") then
    msg:append_header("List-Unsubscribe", "<mailto:unsubscribe@{{ email_domain }}>")
  end
  --]]

  -- Sign with DKIM immediately upon receipt
  local signer = kumo.dkim.rsa_sha256_signer {
    domain = "{{ email_domain }}",
    selector = "{{ dkim_selector | default('default') }}",
    headers = {"From", "To", "Subject", "Date", "Message-ID"},
    key = "/opt/kumomta/etc/dkim/{{ dkim_selector | default('default') }}.key",
  }
  msg:dkim_sign(signer)

  -- CRITICAL: Assign message to queue for delivery
  local recipient = msg:recipient()

  -- Check suppression list (Best Practice) - TEMPORARILY DISABLED FOR DEBUGGING
  --[[
  if recipient and bounce.should_suppress(tostring(recipient)) then
    kumo.reject(550, "5.7.1 Recipient suppressed due to previous bounce or complaint")
    return
  end
  --]]

  msg:set_meta("queue", recipient and recipient.domain or "default")
end)

-- Log successful deliveries
kumo.on("smtp_client_message_delivered", function(msg)
  local recipient_str = tostring(msg:recipient() or "unknown")
  kumo.log(kumo.LOG_INFO, string.format("✓ Delivery Success: to=%s", recipient_str))
end)

-- Log failed deliveries (Bounces)
kumo.on("smtp_client_message_failed", function(msg)
  local recipient_str = tostring(msg:recipient() or "unknown")
  kumo.log(kumo.LOG_ERROR, string.format("✗ Delivery Failed: to=%s", recipient_str))
end)

kumo.on("get_queue_config", function(domain, tenant, campaign, routing_domain)
  return kumo.make_queue_config {
    egress_pool = "default",
    max_age = "2 days",
    retry_interval = "20 minutes",
    max_retry_interval = "2 hours",
  }
end)

kumo.on("get_egress_pool", function(pool_name)
  return kumo.make_egress_pool {
    name = pool_name,
    entries = {
      { name = "default" },
    },
  }
end)

kumo.on("get_routing_domain", function(domain)
  return kumo.make_routing_domain(domain, {
    use_mx = true,
  })
end)

kumo.on("get_egress_source", function(source_name)
  return kumo.make_egress_source {
    name = source_name,
    source_address = "{{ kumomta_source_address | default('0.0.0.0') }}",
  }
end)

kumo.on("get_egress_path_config", function(domain, egress_source, site_name)
  local params = {
    enable_tls = "{{ kumomta_enable_tls | default('Opportunistic') }}",
    connection_limit = {{ kumomta_connection_limit | default(5) }},
    max_deliveries_per_connection = {{ kumomta_max_deliveries_per_connection | default(100) }},
    max_message_rate = "{{ kumomta_max_message_rate | default('20/s') }}",
  }

  return kumo.make_egress_path(params)
end)

-- Configure domains that can relay through this server
kumo.on("get_listener_domain", function(listener_name, domain, conn_meta)
  return kumo.make_listener_domain {
    relay_to = true,
  }
end)



