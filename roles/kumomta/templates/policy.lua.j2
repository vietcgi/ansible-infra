-- KumoMTA Policy Script - DKIM Signing Only
-- Handlers for message routing and queuing are in email-delivery-queue.lua
-- and email-routing.lua

local kumo = require "kumo"

kumo.on("smtp_server_message_received", function(msg)
  -- Sign with DKIM
  local signer = kumo.dkim.rsa_sha256_signer {
    domain = "{{ email_domain }}",
    selector = "{{ dkim_selector | default('default') }}",
    headers = {"From", "To", "Subject", "Date"},
    key = "/etc/kumomta/dkim/{{ dkim_selector | default('default') }}.key",
    over_sign = true,
  }
  msg:dkim_sign(signer)
end)
