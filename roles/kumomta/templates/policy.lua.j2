-- KumoMTA Policy Script
-- Generated by Ansible - Do not edit manually

-- Basic rate limiting per source IP
local rate_limits = {}

function handle_ehlo(context, name)
    local source = context.source
    local now = os.time()

    if not rate_limits[source] then
        rate_limits[source] = {count = 0, first_time = now}
    end

    local limit = rate_limits[source]
    if now - limit.first_time > {{ kumomta_rate_limit_window }} then
        limit.count = 0
        limit.first_time = now
    end

    limit.count = limit.count + 1

    if limit.count > {{ kumomta_rate_limit_count }} then
        kumo.reject(421, "Rate limit exceeded")
    end

    kumo.continue()
end

function handle_rcpt_to(context, recipient)
    -- Check recipient against suppression lists
    local suppressed_domains = {
        {% for domain in kumomta_suppressed_domains %}
        "{{ domain }}",
        {% endfor %}
    }

    for _, domain in ipairs(suppressed_domains) do
        if string.match(recipient, "@" .. domain .. "$") then
            kumo.reject(550, "Recipient domain is suppressed")
            return
        end
    end

    -- Check connection limits per domain
    local max_concurrent = {{ kumomta_max_concurrent_connections_per_domain }}
    if context.concurrent_count and context.concurrent_count > max_concurrent then
        kumo.reject(450, "Too many concurrent connections to this domain")
        return
    end

    kumo.continue()
end

function handle_message_accepted(context, msg)
    -- Log accepted message
    kumo.log(kumo.LOG_INFO, string.format(
        "Message accepted: from=%s to=%s size=%d",
        msg.from,
        msg.recipients[1],
        msg.size
    ))

    kumo.continue()
end

function handle_message_bounce(context, msg)
    -- Handle bounce messages
    kumo.log(kumo.LOG_WARN, string.format(
        "Message bounced: from=%s to=%s reason=%s",
        msg.from,
        msg.recipients[1],
        msg.bounce_reason or "unknown"
    ))

    kumo.continue()
end

-- Return policy status
return {
    version = 1,
    handlers = {
        ehlo = handle_ehlo,
        rcpt_to = handle_rcpt_to,
        message_accepted = handle_message_accepted,
        message_bounce = handle_message_bounce,
    }
}
