-- KumoMTA Cluster Configuration
-- Generated by Ansible - Do not edit manually

local cluster_config = {
    enabled = {{ kumomta_clustering_enabled | lower }},
    node_id = "{{ inventory_hostname }}",
    heartbeat_interval = {{ kumomta_cluster_heartbeat_interval }},
    heartbeat_timeout = {{ kumomta_cluster_heartbeat_timeout }},
}

function get_cluster_config()
    return cluster_config
end

function is_clustering_enabled()
    return cluster_config.enabled
end

function get_node_id()
    return cluster_config.node_id
end

return {
    version = 1,
    get_config = get_cluster_config,
    is_enabled = is_clustering_enabled,
    get_node_id = get_node_id,
}
