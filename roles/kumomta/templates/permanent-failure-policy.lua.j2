-- KumoMTA Permanent Failure (5xx) Policy
-- Generated by Ansible - Do not edit manually

function handle_permanent_failure(context, message, code, reason)
    -- Permanent failures (5xx) should not be retried
    kumo.log(kumo.LOG_ERROR, string.format(
        "Permanent failure (5xx): to=%s code=%s reason=%s",
        message.recipients[1],
        code,
        reason
    ))

    -- Add to suppression list if configured
    if {{ kumomta_bounce_handling_enabled | lower }} then
        add_to_suppression(message.recipients[1], "5xx_failure", 604800)  -- 7 days
    end

    return false  -- Do not retry
end

function add_to_suppression(recipient, reason, ttl)
    local file = io.open("{{ kumomta_suppression_list_path }}", "a")
    if file then
        file:write(string.format("%s|%s|%d|%d\n", recipient, reason, os.time(), ttl))
        file:close()
    end
end

return {
    version = 1,
    handle_permanent_failure = handle_permanent_failure,
}
