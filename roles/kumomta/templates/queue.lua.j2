-- KumoMTA Queue Configuration
-- Generated by Ansible - Do not edit manually

-- Queue management and retry policies
local queue_config = {
    -- Retry strategy for temporary failures
    retry_strategy = "{{ kumomta_queue_strategy }}",

    -- Initial retry interval (seconds)
    initial_retry = {{ kumomta_queue_retry_interval }},

    -- Maximum retry attempts
    max_attempts = {{ kumomta_queue_max_attempts }},

    -- Message expiration time (seconds)
    expiration = {{ kumomta_queue_expiration }},

    -- Worker thread count
    workers = {{ kumomta_worker_threads }},
}

function get_queue_config()
    return queue_config
end

function should_retry(attempt, bounce_code)
    -- Don't retry 5xx permanent failures
    if bounce_code and string.match(tostring(bounce_code), "^5") then
        return false
    end

    -- Retry 4xx temporary failures up to max_attempts
    if attempt < queue_config.max_attempts then
        return true
    end

    return false
end

function calculate_retry_delay(attempt)
    -- Exponential backoff with jitter
    local base_delay = queue_config.initial_retry
    local multiplier = math.min(2 ^ (attempt - 1), 1024)
    local delay = base_delay * multiplier

    -- Add random jitter (10% variation)
    local jitter = delay * (math.random() * 0.2 - 0.1)

    return math.floor(delay + jitter)
end

function on_queue_entry(context, domain)
    kumo.log(kumo.LOG_DEBUG, string.format(
        "Queue entry for domain: %s",
        domain
    ))
end

function on_queue_retry(context, domain, attempt)
    local delay = calculate_retry_delay(attempt)
    kumo.log(kumo.LOG_INFO, string.format(
        "Queued retry for %s, attempt %d, delay %d seconds",
        domain,
        attempt,
        delay
    ))
    return delay
end

function on_queue_expired(context, domain, reason)
    kumo.log(kumo.LOG_ERROR, string.format(
        "Queue entry expired for %s: %s",
        domain,
        reason or "unknown"
    ))
end

return {
    version = 1,
    get_config = get_queue_config,
    should_retry = should_retry,
    calculate_delay = calculate_retry_delay,
    on_entry = on_queue_entry,
    on_retry = on_queue_retry,
    on_expired = on_queue_expired,
}
