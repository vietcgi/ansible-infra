-- KumoMTA Queue Retention Configuration
-- Generated by Ansible - Do not edit manually

local retention = {
    max_age_hours = {{ kumomta_queue_retention_hours }},
    check_interval_minutes = 60,
}

function should_retain_message(message_age_hours)
    return message_age_hours < retention.max_age_hours
end

function cleanup_expired_messages()
    kumo.log(kumo.LOG_INFO, string.format(
        "Queue retention: removing messages older than %d hours",
        retention.max_age_hours
    ))
    return true
end

function get_retention_config()
    return retention
end

function get_max_age_hours()
    return retention.max_age_hours
end

function get_check_interval()
    return retention.check_interval_minutes
end

return {
    version = 1,
    should_retain = should_retain_message,
    cleanup = cleanup_expired_messages,
    get_config = get_retention_config,
    get_max_age = get_max_age_hours,
    get_interval = get_check_interval,
}
