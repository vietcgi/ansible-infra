-- KumoMTA Peer Discovery
-- Generated by Ansible - Do not edit manually

local peers = {}
{% for peer in kumomta_cluster_peers %}
table.insert(peers, "{{ peer }}")
{% endfor %}

function discover_peers()
    return peers
end

function add_peer(peer_addr)
    table.insert(peers, peer_addr)
    return true
end

function is_peer_known(peer_addr)
    for _, p in ipairs(peers) do
        if p == peer_addr then return true end
    end
    return false
end

return {
    version = 1,
    discover = discover_peers,
    add = add_peer,
    is_known = is_peer_known,
}
