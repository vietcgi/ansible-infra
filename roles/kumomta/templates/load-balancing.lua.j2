-- KumoMTA Load Balancing
-- Generated by Ansible - Do not edit manually

local balancer = {
    strategy = "round_robin",
    current_index = 0,
}

function get_next_peer(peer_count)
    balancer.current_index = (balancer.current_index % peer_count) + 1
    return balancer.current_index
end

function select_least_loaded(peer_loads)
    local min_load = math.huge
    local selected = 1
    for i, load in ipairs(peer_loads) do
        if load < min_load then
            min_load = load
            selected = i
        end
    end
    return selected
end

function calculate_weights(peer_metrics)
    local weights = {}
    local total = 0
    for _, metric in ipairs(peer_metrics) do
        total = total + metric.capacity
    end
    for i, metric in ipairs(peer_metrics) do
        weights[i] = metric.capacity / total
    end
    return weights
end

return {
    version = 1,
    next_peer = get_next_peer,
    least_loaded = select_least_loaded,
    calculate_weights = calculate_weights,
}
