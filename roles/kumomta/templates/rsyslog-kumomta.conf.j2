# KumoMTA syslog configuration
# Generated by Ansible - Do not edit manually

# Forward KumoMTA logs to separate file
:programname, isequal, "kumomta" {{ kumomta_log_dir }}/kumomta-syslog.log

# Also forward to remote syslog if configured
{% if kumomta_remote_syslog_enabled | bool %}
:programname, isequal, "kumomta" @@{{ kumomta_remote_syslog_host }}:{{ kumomta_remote_syslog_port }}
{% endif %}

# Stop processing after syslog redirect
& stop
