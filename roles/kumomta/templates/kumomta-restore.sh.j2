#!/bin/bash
# KumoMTA Restore Script
# Generated by Ansible - Do not edit manually

set -e

if [[ $# -ne 1 ]]; then
  echo "Usage: $(basename "$0") <backup_file>"
  echo "Example: $(basename "$0") /var/backups/kumomta/backup-20250101-000000.tar.gz"
  exit 1
fi

BACKUP_FILE="$1"

# Validate backup file exists and is readable
if [[ ! -f "$BACKUP_FILE" ]]; then
  echo "Error: Backup file not found: $BACKUP_FILE" >&2
  exit 1
fi

if [[ ! -r "$BACKUP_FILE" ]]; then
  echo "Error: Backup file not readable: $BACKUP_FILE" >&2
  exit 1
fi

# Validate tar integrity before extraction
echo "Validating backup integrity..."
if ! tar -tzf "$BACKUP_FILE" > /dev/null 2>&1; then
  echo "Error: Backup file is corrupted" >&2
  exit 1
fi

# Extract to root - tar will preserve paths
echo "Restoring from backup: $BACKUP_FILE"
tar -xzf "$BACKUP_FILE" -C /

echo "Restore complete. Please verify permissions and restart kumomta service."
exit 0
