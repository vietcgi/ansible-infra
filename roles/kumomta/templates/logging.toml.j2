# KumoMTA Logging Configuration
# Generated by Ansible - Do not edit manually

[general]
level = "{{ kumomta_log_level }}"
format = "{{ kumomta_log_format }}"
use_utc = true

[output.file]
enabled = true
path = "{{ kumomta_log_dir }}/kumomta.log"
rotation = "{{ kumomta_log_rotation_size }}"
retention = {{ kumomta_log_retention_days }}

[output.syslog]
enabled = {{ kumomta_syslog_enabled | lower }}
facility = "local6"
tag = "kumomta"

[filters]
# Silence noisy debug messages
ignore_patterns = [
    "connection_established",
    "heartbeat",
]

[metrics]
enabled = {{ kumomta_metrics_enabled | lower }}
interval = {{ kumomta_metrics_interval }}

[debug]
enabled = {{ kumomta_debug_logging | lower }}
verbose_mode = {{ kumomta_verbose_logging | lower }}

[audit]
enabled = true
log_path = "{{ kumomta_log_dir }}/audit.log"
