-- KumoMTA Transient Failure (4xx) Policy
-- Generated by Ansible - Do not edit manually

function handle_transient_failure(context, message, attempt, code, reason)
    kumo.log(kumo.LOG_WARN, string.format(
        "Transient failure (4xx): to=%s attempt=%d code=%s reason=%s",
        message.recipients[1],
        attempt,
        code,
        reason
    ))

    -- Calculate retry delay
    local max_attempts = {{ kumomta_queue_max_attempts }}
    if attempt < max_attempts then
        return true  -- Retry
    end

    kumo.log(kumo.LOG_ERROR, string.format(
        "Max retries exceeded: to=%s attempts=%d",
        message.recipients[1],
        attempt
    ))

    return false  -- Stop retrying
end

return {
    version = 1,
    handle_transient_failure = handle_transient_failure,
}
