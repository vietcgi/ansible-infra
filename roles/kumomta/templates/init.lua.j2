-- KumoMTA Initialization Script
-- Generated by Ansible - Do not edit manually
-- This is the main entry point for KumoMTA configuration

-- Register the configuration loading hook
function kumo.on_load_config()
    -- Setup logging
    kumo.log_hook(function(level, message)
        kumo.print(level .. ": " .. message)
    end)

    -- Define the default spool - REQUIRED for service to start
    kumo.define_spool {
        name = "default",
        path = "{{ kumomta_queue_dir }}/default",
    }

    -- Optional secondary spool for important messages
    kumo.define_spool {
        name = "important",
        path = "{{ kumomta_queue_dir }}/important",
    }

    -- Setup listeners for different protocols
    kumo.define_listener {
        listen = "0.0.0.0:{{ kumomta_listen_port }}",
        hostname_override = "{{ kumomta_hostname }}",
    }

    kumo.define_listener {
        listen = "0.0.0.0:{{ kumomta_submit_port }}",
        hostname_override = "{{ kumomta_hostname }}",
        require_authz = {{ 'true' if kumomta_require_auth else 'false' }},
    }

    {% if kumomta_tls_enabled %}
    kumo.define_listener {
        listen = "0.0.0.0:{{ kumomta_tls_port }}",
        hostname_override = "{{ kumomta_hostname }}",
        tls_certificate = "{{ kumomta_tls_certificate }}",
        tls_private_key = "{{ kumomta_tls_key }}",
    }
    {% endif %}

    -- Define domain configuration
    kumo.define_domain("{{ kumomta_hostname }}")

    {% if kumomta_dkim_enabled %}
    -- DKIM Configuration
    kumo.dkim_sign {
        domain = "{{ kumomta_hostname }}",
        selector = "{{ kumomta_dkim_selector }}",
        headers_to_sign = {
            "From",
            "To",
            "Subject",
            "Date",
            "Message-ID",
            "MIME-Version",
            "Content-Type",
            "Content-Transfer-Encoding",
        },
        key_file = "{{ kumomta_dkim_key }}",
    }
    {% endif %}

    -- Admin listener for metrics and admin API
    kumo.define_listener {
        listen = "0.0.0.0:{{ kumomta_admin_port }}",
        protocol = "http",
    }

    {% if kumomta_monitoring_enabled %}
    -- Metrics listener
    kumo.define_listener {
        listen = "0.0.0.0:{{ kumomta_metrics_port }}",
        protocol = "metrics",
    }
    {% endif %}

    -- Load policy script if it exists
    if kumo.file_exists("{{ kumomta_config_dir }}/policy.lua") then
        dofile("{{ kumomta_config_dir }}/policy.lua")
    end

    -- Load queue script if it exists
    if kumo.file_exists("{{ kumomta_config_dir }}/queue.lua") then
        dofile("{{ kumomta_config_dir }}/queue.lua")
    end

    {% if kumomta_bounce_handling_enabled %}
    -- Load bounce handling policy if it exists
    if kumo.file_exists("{{ kumomta_config_dir }}/bounce-policy.lua") then
        dofile("{{ kumomta_config_dir }}/bounce-policy.lua")
    end
    {% endif %}
end

-- Handle EHLO command
function kumo.handle_ehlo(context, name)
    kumo.continue()
end

-- Handle MAIL FROM command
function kumo.handle_mail_from(context, address)
    kumo.continue()
end

-- Handle RCPT TO command
function kumo.handle_rcpt_to(context, address)
    kumo.continue()
end

-- Handle message received
function kumo.handle_message_received(context)
    kumo.continue()
end
