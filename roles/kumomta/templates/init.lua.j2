-- KumoMTA Initialization Script
-- Generated by Ansible - Do not edit manually
-- This is the main entry point for KumoMTA configuration

local kumo = require 'kumo'

kumo.on('init', function()
  kumo.start_esmtp_listener {
    listen = '0.0.0.0:{{ kumomta_listen_port }}',
    relay_hosts = { '0.0.0.0/0' },  -- Allow relay to any destination
  }

  kumo.start_esmtp_listener {
    listen = '0.0.0.0:{{ kumomta_submit_port }}',
    relay_hosts = { '0.0.0.0/0' },  -- Allow relay to any destination
  }

  {% if kumomta_tls_enabled %}
  kumo.start_esmtps_listener {
    listen = '0.0.0.0:{{ kumomta_tls_port }}',
    tls_certificate = '{{ kumomta_tls_certificate }}',
    tls_private_key = '{{ kumomta_tls_key }}',
    relay_hosts = { '0.0.0.0/0' },  -- Allow relay to any destination
  }
  {% endif %}

  kumo.start_http_listener {
    listen = '127.0.0.1:{{ kumomta_admin_port }}',
  }

  kumo.define_spool {
    name = 'data',
    path = '{{ kumomta_queue_dir }}/data',
  }

  kumo.define_spool {
    name = 'meta',
    path = '{{ kumomta_queue_dir }}/meta',
  }

  kumo.configure_local_logs {
    log_dir = '{{ kumomta_log_dir }}',
    max_segment_duration = '10s',
  }
end)

-- Accept all SMTP messages
kumo.on('smtp_server_message_received', function(msg)
  -- Accept message by default (no rejection)
end)

-- Decide whether to enqueue messages
kumo.on('should_enqueue_message', function(msg)
  msg:set_drop_queue('default')
  return true
end)

-- Queue messages for delivery
kumo.on('queue_message_received', function(msg)
  msg:set_drop_queue('default')
  -- Message will be delivered with configured queue settings
end)

-- Define egress sources (sending IPs)
kumo.on('get_egress_source', function(source_name)
  return kumo.make_egress_source {
    name = source_name,
    ehlo_domain = '{{ kumomta_ehlo_domain | default("example.com") }}',
  }
end)

-- Define egress pools for routing
kumo.on('get_egress_pool', function(domain, tenant, campaign, owner)
  return kumo.make_egress_pool {
    name = 'default',
    entries = {
      { name = 'default-source' }
    }
  }
end)

-- Configure queue delivery settings with egress pool
kumo.on('get_queue_config', function(domain, tenant, campaign, owner)
  return kumo.make_queue_config({
    max_age = '5m',
    egress_pool = 'default'
  })
end)

-- Log bounce messages
kumo.on('bounce', function(msg)
  kumo.log(kumo.LOG_INFO, 'bounce: ' .. msg.bounce_reason)
end)
