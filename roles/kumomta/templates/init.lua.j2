-- KumoMTA Initialization Script (v2025.10.06)
-- Generated by Ansible - Do not edit manually
-- This is the main entry point for KumoMTA configuration

local kumo = require 'kumo'
local queue = require 'policy-extras.queue'
local sources = require 'policy-extras.sources'

-- Load queue and sources configuration from TOML
local queue_helper = queue:setup({'/opt/kumomta/etc/queue.toml'})
sources:setup({'/opt/kumomta/etc/sources.toml'})

-- Define message spools for queue storage
kumo.define_spool {
  name = 'data',
  path = '{{ kumomta_queue_dir }}/data',
}

kumo.define_spool {
  name = 'meta',
  path = '{{ kumomta_queue_dir }}/meta',
}

kumo.define_spool {
  name = 'default',
  path = '{{ kumomta_queue_dir }}/default',
}

-- NOTE: SMTP listeners are automatically set up by policy-extras.sources module
-- Do NOT use kumo.start_esmtp_listener() - that function does not exist in v2025.10.06
-- The sources:setup() call above handles listener configuration

-- CRITICAL: Accept and queue messages from SMTP
kumo.on('smtp_server_message_received', function(msg)
  queue_helper:apply(msg)
  -- Message is automatically accepted when handler completes successfully
end)

-- Define queue configuration (retry intervals, max age, egress pool assignment)
-- This is CRITICAL for message delivery - without this, messages won't be routed
kumo.on('get_queue_config', function(domain, tenant, campaign, routing_domain)
  return kumo.make_queue_config {
    -- Message aging and retry strategy
    max_age = '7 days',                         -- Maximum time to keep retrying
    retry_interval = '5 minutes',                -- Initial retry interval
    max_retry_interval = '20 minutes',           -- Maximum time between retries

    -- Route through the default egress pool (defined in sources.toml)
    egress_pool = 'default',
  }
end)

-- Enable automatic message delivery attempt scheduling
-- Without this, queued messages will never be delivered
kumo.on('get_scheduled_event', function(meta)
  -- Return immediately to attempt delivery
  return kumo.make_scheduled_event(0)
end)

-- NOTE: get_egress_source handler is automatically provided by policy-extras.sources
-- when sources:setup() is called. Do not define it here to avoid handler conflicts.

-- Define routing strategy - this tells KumoMTA which hosts can accept messages
kumo.on('get_routes', function(domain)
  -- Route all domains to their MX records (standard mail routing)
  return kumo.make_routing_domain(domain)
end)

-- NOTE: get_egress_pool handler is automatically provided by policy-extras.sources
-- when sources:setup() is called. Do not define it here to avoid handler conflicts.
