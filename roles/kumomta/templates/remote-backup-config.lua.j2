-- KumoMTA Remote Backup Configuration
-- Generated by Ansible - Do not edit manually

local remote_config = {
    enabled = {{ kumomta_remote_backup_enabled | lower }},
    host = "{{ kumomta_remote_backup_host }}",
    port = {{ kumomta_remote_backup_port }},
    protocol = "{{ kumomta_remote_backup_protocol }}",
    destination_path = "{{ kumomta_remote_backup_path }}",
    retention_days = {{ kumomta_log_retention_days }},
    compression_enabled = true,
    verification_enabled = true,
}

function send_to_remote(backup_file)
    if not remote_config.enabled then
        kumo.log(kumo.LOG_INFO, "Remote backup disabled")
        return false
    end
    kumo.log(kumo.LOG_INFO, string.format(
        "Sending backup %s to %s:%d via %s",
        backup_file,
        remote_config.host,
        remote_config.port,
        remote_config.protocol
    ))
    return true
end

function get_remote_config()
    return remote_config
end

function is_remote_backup_enabled()
    return remote_config.enabled and
           remote_config.host and
           #remote_config.host > 0
end

function get_remote_host()
    return remote_config.host
end

function get_remote_port()
    return remote_config.port
end

function get_remote_protocol()
    return remote_config.protocol
end

function get_destination_path()
    return remote_config.destination_path
end

return {
    version = 1,
    send = send_to_remote,
    get_config = get_remote_config,
    is_enabled = is_remote_backup_enabled,
    get_host = get_remote_host,
    get_port = get_remote_port,
    get_protocol = get_remote_protocol,
    get_path = get_destination_path,
}
