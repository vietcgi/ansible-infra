#!/bin/bash
# KumoMTA Bounce Handler Script
# Generated by Ansible - Do not edit manually

BOUNCE_DIR="{{ kumomta_bounce_dir }}"
SUPPRESSION_LIST="{{ kumomta_suppression_list_path }}"
LOG_FILE="{{ kumomta_log_dir }}/bounce-handler.log"

# Ensure directories exist
mkdir -p "$BOUNCE_DIR"

# Process bounce notifications
process_bounce() {
    local recipient="$1"
    local bounce_code="$2"
    local bounce_reason="$3"
    local timestamp=$(date +%s)

    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Bounce: $recipient (Code: $bounce_code, Reason: $bounce_reason)" >> "$LOG_FILE"

    # Add to suppression list if permanent failure
    if [[ "$bounce_code" =~ ^5 ]]; then
        echo "$recipient|permanent_failure|$timestamp|604800" >> "$SUPPRESSION_LIST"
    fi
}

# Parse input
if [[ $# -ge 2 ]]; then
    process_bounce "$@"
else
    echo "Usage: $(basename "$0") <recipient> <bounce_code> [bounce_reason]" >&2
    exit 1
fi
