-- KumoMTA FBL (Feedback Loop) Processor
-- Generated by Ansible - Do not edit manually

local fbl_database = "{{ kumomta_fbl_dir }}/fbl.db"
local suppression_list = "{{ kumomta_fbl_suppression_list }}"

function process_fbl_report(context, report)
    kumo.log(kumo.LOG_INFO, string.format(
        "Processing FBL report: recipient=%s complaint_type=%s",
        report.recipient,
        report.complaint_type
    ))

    -- Log FBL event
    log_fbl_event(report.recipient, report.complaint_type)

    -- Add to suppression list
    add_to_fbl_suppression(report.recipient, report.complaint_type)

    return true
end

function log_fbl_event(recipient, complaint_type)
    local file = io.open(fbl_database, "a")
    if file then
        file:write(string.format(
            "%d|%s|%s\n",
            os.time(),
            recipient,
            complaint_type
        ))
        file:close()
    end
end

function add_to_fbl_suppression(recipient, reason)
    local file = io.open(suppression_list, "a")
    if file then
        file:write(string.format(
            "%s|fbl_%s|%d\n",
            recipient,
            reason,
            os.time()
        ))
        file:close()
    end
end

return {
    version = 1,
    process_fbl = process_fbl_report,
}
