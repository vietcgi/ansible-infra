-- KumoMTA FBL Reporting
-- Generated by Ansible - Do not edit manually

local fbl_reports = {}

function send_fbl_report(complaint_data)
    kumo.log(kumo.LOG_INFO, string.format(
        "FBL Report: type=%s recipient=%s timestamp=%d",
        complaint_data.complaint_type,
        complaint_data.recipient,
        os.time()
    ))
    table.insert(fbl_reports, complaint_data)
    return true
end

function get_fbl_reports(limit)
    if limit and limit > 0 then
        local recent = {}
        for i = math.max(1, #fbl_reports - limit + 1), #fbl_reports do
            table.insert(recent, fbl_reports[i])
        end
        return recent
    end
    return fbl_reports
end

function clear_fbl_reports()
    fbl_reports = {}
    return true
end

return {
    version = 1,
    send = send_fbl_report,
    get_reports = get_fbl_reports,
    clear = clear_fbl_reports,
}
