-- KumoMTA Backup Retention Policy
-- Generated by Ansible - Do not edit manually

local retention = {
    max_age_days = {{ kumomta_log_retention_days }},
    max_backups = 30,
}

function should_retain_backup(backup_age_days)
    return backup_age_days < retention.max_age_days
end

function cleanup_old_backups(backups)
    local to_keep = {}
    local now = os.time()
    for _, backup in ipairs(backups) do
        local age_days = (now - backup.timestamp) / 86400
        if should_retain_backup(age_days) then
            table.insert(to_keep, backup)
        end
    end
    return to_keep
end

function get_retention_policy()
    return retention
end

return {
    version = 1,
    should_retain = should_retain_backup,
    cleanup = cleanup_old_backups,
    get_policy = get_retention_policy,
}
