-- KumoMTA Bounce Policy
-- Generated by Ansible - Do not edit manually

local bounce_handlers = {}

function handle_5xx_bounce(context, message, code, reason)
    -- Permanent failure - don't retry
    kumo.log(kumo.LOG_ERROR, string.format(
        "Permanent bounce 5xx: to=%s code=%s reason=%s",
        message.recipients[1],
        code,
        reason
    ))

    -- Check if sender should be notified
    if {{ kumomta_bounce_notify_sender | lower }} then
        -- Queue bounce notification
        kumo.queue_notification(message.from, "bounce", {
            recipient = message.recipients[1],
            code = code,
            reason = reason,
            timestamp = os.time(),
        })
    end

    return false  -- Don't retry
end

function handle_4xx_bounce(context, message, code, reason)
    -- Temporary failure - retry
    kumo.log(kumo.LOG_WARN, string.format(
        "Temporary bounce 4xx: to=%s code=%s reason=%s",
        message.recipients[1],
        code,
        reason
    ))

    return true  -- Retry
end

function should_suppress(recipient)
    -- Check suppression list
    local suppression_file = io.open("{{ kumomta_suppression_list_path }}", "r")
    if not suppression_file then
        return false
    end

    for line in suppression_file:lines() do
        if line == recipient then
            suppression_file:close()
            return true
        end
    end

    suppression_file:close()
    return false
end

function add_to_suppression_list(recipient, reason, ttl)
    -- Add recipient to suppression list
    local suppression_file = io.open("{{ kumomta_suppression_list_path }}", "a")
    if suppression_file then
        suppression_file:write(string.format(
            "%s|%s|%d|%d\n",
            recipient,
            reason,
            os.time(),
            ttl or 86400  -- Default 24 hours
        ))
        suppression_file:close()
    end

    kumo.log(kumo.LOG_INFO, string.format(
        "Added %s to suppression list: %s",
        recipient,
        reason
    ))
end

return {
    version = 1,
    handle_5xx = handle_5xx_bounce,
    handle_4xx = handle_4xx_bounce,
    should_suppress = should_suppress,
    add_to_suppression = add_to_suppression_list,
}
