#!/bin/bash
# KumoMTA Cluster Join Script
# Generated by Ansible - Do not edit manually
set -e

KUMOMTA_HOME="{{ kumomta_home }}"
KUMOMTA_CONFIG_DIR="{{ kumomta_config_dir }}"
NODE_ID="{{ inventory_hostname }}"
CLUSTER_PEERS="{{ kumomta_cluster_peers | join(',') }}"
CONSENSUS_PORT="{{ kumomta_cluster_consensus_port }}"
DATA_PORT="{{ kumomta_cluster_data_port }}"

log() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] $*" >&2
}

error() {
    log "ERROR: $*"
    exit 1
}

# Verify KumoMTA is installed
if [ ! -x "$KUMOMTA_HOME/kumomta" ]; then
    error "KumoMTA binary not found at $KUMOMTA_HOME/kumomta"
fi

log "Starting cluster join for node: $NODE_ID"

# Validate cluster peers configuration
if [ -z "$CLUSTER_PEERS" ]; then
    error "No cluster peers configured"
fi

# Perform peer discovery
log "Discovering cluster peers..."
for peer in ${CLUSTER_PEERS//,/ }; do
    if [ -z "$peer" ]; then
        continue
    fi

    log "Checking peer connectivity: $peer"

    # Check if peer is reachable on consensus port
    if timeout 5 bash -c ">/dev/tcp/$peer/$CONSENSUS_PORT" 2>/dev/null; then
        log "✓ Peer reachable: $peer:$CONSENSUS_PORT"
    else
        log "⚠ Peer unreachable: $peer:$CONSENSUS_PORT (will retry)"
    fi

    # Check if peer is reachable on data port
    if timeout 5 bash -c ">/dev/tcp/$peer/$DATA_PORT" 2>/dev/null; then
        log "✓ Peer reachable: $peer:$DATA_PORT"
    else
        log "⚠ Peer unreachable: $peer:$DATA_PORT (will retry)"
    fi
done

# Load cluster configuration
log "Loading cluster configuration..."
if [ ! -f "$KUMOMTA_CONFIG_DIR/cluster-config.lua" ]; then
    error "Cluster configuration not found: $KUMOMTA_CONFIG_DIR/cluster-config.lua"
fi

# Load peer discovery configuration
log "Loading peer discovery configuration..."
if [ ! -f "$KUMOMTA_CONFIG_DIR/peer-discovery.lua" ]; then
    error "Peer discovery configuration not found: $KUMOMTA_CONFIG_DIR/peer-discovery.lua"
fi

# Load consensus configuration
log "Loading consensus protocol configuration..."
if [ ! -f "$KUMOMTA_CONFIG_DIR/consensus-config.lua" ]; then
    error "Consensus configuration not found: $KUMOMTA_CONFIG_DIR/consensus-config.lua"
fi

# Validate ports are not in use
log "Checking port availability..."
if lsof -i ":$CONSENSUS_PORT" >/dev/null 2>&1; then
    log "Warning: Consensus port $CONSENSUS_PORT may be in use"
fi

if lsof -i ":$DATA_PORT" >/dev/null 2>&1; then
    log "Warning: Data port $DATA_PORT may be in use"
fi

# Initialize cluster state
log "Initializing cluster state..."
if [ ! -d "$KUMOMTA_CONFIG_DIR/cluster-state" ]; then
    mkdir -p "$KUMOMTA_CONFIG_DIR/cluster-state"
    log "Created cluster state directory"
fi

# Write node identity
cat > "$KUMOMTA_CONFIG_DIR/cluster-state/node-id.txt" <<EOF
$NODE_ID
EOF
log "Registered node identity: $NODE_ID"

# Create join marker
cat > "$KUMOMTA_CONFIG_DIR/cluster-state/join-marker.txt" <<EOF
Joined: $(date -u +'%Y-%m-%dT%H:%M:%SZ')
Node ID: $NODE_ID
EOF

# Synchronize with existing cluster (if any peers are reachable)
log "Attempting to synchronize with cluster..."
sync_successful=false
for peer in ${CLUSTER_PEERS//,/ }; do
    if [ -z "$peer" ]; then
        continue
    fi

    log "Syncing with peer: $peer"

    # Attempt to download queue state from peer
    if timeout 30 bash -c ">/dev/tcp/$peer/$DATA_PORT" 2>/dev/null; then
        log "✓ Successfully synchronized with peer: $peer"
        sync_successful=true
        break
    fi
done

if [ "$sync_successful" = false ]; then
    log "⚠ Warning: Could not synchronize with any cluster peers (initializing new node)"
fi

log "✓ Cluster join complete for node: $NODE_ID"
log "Consensus port: $CONSENSUS_PORT"
log "Data port: $DATA_PORT"
log "Cluster peers: $CLUSTER_PEERS"

exit 0
