function distribute_to_peer(message_id, peer_count)
    -- Simple hash-based distribution
    local hash = 0
    for i = 1, string.len(message_id) do
        hash = (hash * 31 + string.byte(message_id, i)) % peer_count
    end
    return hash + 1
end

function get_distribution_strategy()
    return "hash_based"
end

function rebalance_queue(current_loads)
    -- Return suggested peer for load balancing
    local min_load = math.huge
    local best_peer = 1
    for i, load in ipairs(current_loads) do
        if load < min_load then
            min_load = load
            best_peer = i
        end
    end
    return best_peer
end

return {
    version = 1,
    distribute = distribute_to_peer,
    strategy = get_distribution_strategy,
    rebalance = rebalance_queue,
}
