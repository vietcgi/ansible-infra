# Ansible-Lint Configuration
# Production-grade strict linting for ansible-lint 25.x

---
profile: production

# Exclude paths from linting
exclude_paths:
  - .git/
  - .gitignore
  - .molecule/
  - molecule/
  - .tox/
  - venv/
  - .venv/
  - __pycache__/
  - .pytest_cache/
  - .cache/
  - docs/

# Skip rules that are too disruptive for existing codebase
skip_list:
  - schema[meta]  # Meta schema validation can be overly strict
  - var-naming[no-role-prefix]  # Variable renaming is risky for existing codebase
  - yaml[line-length]  # Allow lines up to 160 chars (configured in .yamllint)
  - ignore-errors  # Existing code uses ignore_errors pattern
  - no-handler  # Tasks that could be handlers but work as-is
  - no-changed-when  # Shell tasks - add changed_when gradually
  - risky-shell-pipe  # Shell pipes - add pipefail gradually
  - risky-file-permissions  # File permissions - add mode gradually
  - command-instead-of-module  # Sometimes shell/command is intentional
  - meta-no-tags  # Meta files without galaxy_tags
  - package-latest  # state: latest is sometimes intentional
  - name[play]  # Unnamed plays

# Warn only for stylistic issues
warn_list:
  - name[casing]  # Play/task name casing
  - key-order[task]  # Task key ordering preference

# Offline mode (don't download schemas)
offline: false

# Mock modules with incomplete metadata (upstream bugs)
mock_modules:
  - amazon.aws.sts_caller_identity

# Enable opt-in security rules
enable_list:
  - no-log-password
  - no-same-owner
