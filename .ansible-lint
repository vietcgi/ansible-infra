# Ansible-Lint Configuration
# Production-grade strict linting for ansible-lint 25.x

---
profile: production

# Exclude paths from linting
exclude_paths:
  - .git/
  - .gitignore
  - .molecule/
  - molecule/
  - .tox/
  - venv/
  - .venv/
  - __pycache__/
  - .pytest_cache/
  - .cache/
  - docs/

# Minimal skip list - only skip rules that don't apply
skip_list:
  - schema[meta]  # Meta schema validation can be overly strict
  - var-naming[no-role-prefix]  # Variable renaming is risky for existing codebase

# Warn for issues that are important but shouldn't block CI
warn_list:
  - name[casing]  # Play/task name casing
  - name[play]  # Unnamed plays
  - key-order[task]  # Task key ordering preference
  - yaml[line-length]  # Long lines (max 120)
  - ignore-errors  # Should use failed_when, but existing code uses ignore_errors
  - no-handler  # Tasks that could be handlers
  - no-changed-when  # Shell/command tasks without changed_when
  - risky-shell-pipe  # Shell pipes without pipefail
  - risky-file-permissions  # File permissions not explicitly set
  - command-instead-of-module  # Using shell/command instead of modules
  - meta-no-tags  # Meta files without galaxy_tags
  - package-latest  # Using state: latest

# Offline mode (don't download schemas)
offline: false

# Enable opt-in security rules
enable_list:
  - no-log-password
  - no-same-owner
